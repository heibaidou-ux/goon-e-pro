# 高岸ERP 服务端配置示例
# 复制为 .env 并填写实际值

# 调试模式（生产必须设为 false）
DEBUG=false

# 数据库（SQLite开发/PG生产）
DATABASE_URL=sqlite+aiosqlite:///./gaoan_erp.db

# JWT密钥（生产环境必须更换为64位随机字符串）
# Linux: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# 上传目录
UPLOAD_DIR=./uploads

# CORS允许的域名（生产环境必须填写，多个用逗号分隔）
# 格式: ["https://你的域名.com"]
CORS_ORIGINS=[]

# ──── 微信支付 ────
# 微信支付商户号（小程序关联的商户号）
# 需在微信支付商户平台开通并绑定到当前appid
WECHAT_MCH_ID=
# 商户API密钥（微信支付商户平台 → API安全 → 设置密钥）
WECHAT_PAY_KEY=
# ERP公网地址（用于微信支付回调通知）
ERP_BASE_URL=https://erp.highbank.cn

# ──── Home Assistant IoT ────
# HA地址（M710Q固定IP）
HA_URL=http://192.168.2.65:8123
# HA长期访问令牌（HA界面 → 用户 → 安全 → 长期访问令牌）
HA_TOKEN=

# ──── 485直连网关 ────
# FRP映射的485网关地址（通常不需要改）
DIRECT_485_HOST=127.0.0.1
DIRECT_485_PORT=7003
