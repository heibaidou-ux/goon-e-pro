.page { padding: 0; min-height: 100vh; background: #f5f7fa; }

.summary-bar { background: linear-gradient(135deg, #5D8A6B, #7AAA8A); padding: 20px 0; }
.summary-label { font-size: 13px; color: rgba(255,255,255,.8); }
.summary-amount { font-size: 32px; font-weight: 800; color: #fff; margin-top: 4px; }

.filter-tabs { display: flex; background: #fff; padding: 0; border-bottom: 1px solid #f0f0f0; }
.filter-tab { padding: 12px 20px; font-size: 14px; color: #666; position: relative; }
.filter-tab.active { color: #5D8A6B; font-weight: 600; }
.filter-tab.active::after { content: ''; position: absolute; bottom: 0; left: 20px; right: 20px; height: 2px; background: #5D8A6B; border-radius: 1px; }

.card-list { padding: 12px 0; }
.card { background: #fff; border-radius: 16px; padding: 14px; margin-bottom: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.card-name { font-size: 15px; font-weight: 600; color: #333; }
.card-status { font-size: 11px; padding: 2px 8px; border-radius: 8px; font-weight: 500; }
.card-status.unpaid { background: #FFF3E0; color: #B8860B; }
.card-status.paid { background: #E8F5E9; color: #5D8A6B; }
.card-room { font-size: 12px; color: #999; display: block; margin-bottom: 6px; }
.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.card-amount { font-size: 18px; font-weight: 700; color: #333; }
.card-time { font-size: 11px; color: #bbb; }

.empty { text-align: center; padding: 40px 16px; color: #ccc; font-size: 13px; }
