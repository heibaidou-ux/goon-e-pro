.page { min-height:100vh; background:#f5f7fa; padding-bottom:20px; }
.clock-card { margin:16px 0; padding:32px 20px; background:#fff; border-radius:16px; text-align:center; }
.clock-date { font-size:14px; color:#999; display:block; }
.clock-time { font-size:36px; font-weight:700; color:#333; margin:8px 0; display:block; }
.clock-status { font-size:13px; color:#5D8A6B; display:block; margin-bottom:20px; }
.clock-btn { width:140px; padding:14px; border-radius:16px; font-size:16px; font-weight:600; margin:0 auto; }
.clock-btn.btn-in { background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; }
.clock-btn.btn-out { background:#fff; color:#e53935; border:1.5px solid #e53935; }
.section-title { display:block; font-size:15px; font-weight:600; padding:0; margin-bottom:10px; }
.record-list { padding:0; }
.record-item { display:flex; align-items:center; padding:14px; background:#fff; border-radius:16px; margin-bottom:8px; }
.record-date { font-size:14px; font-weight:500; width:80px; }
.record-time { flex:1; font-size:13px; color:#666; }
.record-status { font-size:12px; padding:2px 8px; border-radius:6px; background:#f0fdf4; color:#5D8A6B; }
.record-status.done { background:#f5f5f5; color:#999; }
.empty { text-align:center; color:#ccc; font-size:13px; padding:30px; }
