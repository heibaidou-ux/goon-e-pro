<view class="page">
  <view class="header">
    <text class="header-title">📊 工作台</text>
    <text class="header-store">{{storeName}}</text>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-num">{{stats.todayOrders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.roomCount.inUse}}</text>
      <text class="stat-label">使用中</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.roomCount.free}}</text>
      <text class="stat-label">空闲房间</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.pendingTasks}}</text>
      <text class="stat-label">待办任务</text>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-item" bindtap="goRoomStatus">🏠 房态</view>
    <view class="action-item" bindtap="goDeviceMonitor">📡 设备</view>
    <view class="action-item" bindtap="goCleaning">🧹 保洁</view>
    <view class="action-item" bindtap="goOrders">📋 订单</view>
    <view class="action-item" bindtap="goTodo">✅ 待办</view>
    <view class="action-item" bindtap="goProfile">👤 我的</view>
  </view>

  <text class="section-title">待办事项</text>
  <view class="todo-list">
    <view class="todo-item {{item.priority === 'high' ? 'high' : ''}}" wx:for="{{todos}}" wx:key="id" bindtap="goTodo">
      <text class="todo-title">{{item.title}}</text>
      <text class="todo-deadline">{{item.deadline}}</text>
    </view>
    <view class="empty" wx:if="{{todos.length === 0}}">暂无待办事项</view>
  </view>
</view>
