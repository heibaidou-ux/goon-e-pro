.header { padding:14px 0; background:#fff; border-bottom:1px solid #f0f0f0; }
.header-title { font-size:18px; font-weight:700; }

.picker-bar { padding:10px 0; background:#f9f9f9; font-size:14px; color:#333; }

.scene-section { padding:12px 0; }
.section-title { font-size:14px; font-weight:600; color:#666; display:block; margin-bottom:12px; }

.scene-grid { display:flex; flex-wrap:wrap; gap:12px; }

.scene-card { position:relative; width:calc(50% - 6px); background:#fff; border-radius:16px; padding:20px 12px; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; text-align:center; overflow:hidden; }
.scene-card:active { transform:scale(0.96); }

.scene-icon { width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; margin-bottom:10px; }
.scene-emoji { font-size:24px; }

.scene-name { font-size:15px; font-weight:600; color:#333; margin-bottom:4px; }
.scene-desc { font-size:11px; color:#999; line-height:1.4; }

.scene-overlay { position:absolute; inset:0; background:rgba(255,255,255,0.8); border-radius:16px; display:flex; align-items:center; justify-content:center; }
.scene-loading { width:24px; height:24px; border:3px solid #e0e0e0; border-top-color:#5D8A6B; border-radius:50%; animation:spin 0.8s linear infinite; }

@keyframes spin { to { transform:rotate(360deg); } }
