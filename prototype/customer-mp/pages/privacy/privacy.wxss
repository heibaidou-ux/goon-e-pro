.container {
  padding: 30rpx;
  background: #FAF8F5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.update-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.section {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.body-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  display: block;
  margin-bottom: 8rpx;
}

.footer {
  margin-top: 60rpx;
  padding-bottom: 60rpx;
}

.agree-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #8B6914;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  text-align: center;
}
