<view class="phone">
  <view class="page">
    <view class="header">
      <text class="header-title">📅 考勤</text>
    </view>
    <view class="content">
      <view class="checkin-card">
        <view class="checkin-top">
          <text class="checkin-status-icon">{{checkedIn ? (checkedOut ? '✅' : '🕒') : '⏰'}}</text>
          <view class="checkin-info">
            <text class="checkin-status-text">{{todayStatus}}</text>
            <text class="checkin-time">签到 {{checkInTime||'—'}}  · 签退 {{checkOutTime||'—'}}</text>
          </view>
        </view>
        <view class="checkin-btns">
          <button wx:if="{{!checkedIn && !checkedOut}}" bindtap="doCheckIn" class="ci-btn signin">🕐 签到</button>
          <button wx:if="{{checkedIn && !checkedOut}}" bindtap="doCheckOut" class="ci-btn signout">🏁 签退</button>
          <view wx:if="{{checkedIn && checkedOut}}" class="ci-signedout">
            <text class="ci-done">✅ 今日已签退</text>
            <button bindtap="doCheckIn" class="ci-btn signin ci-reentry">🕐 再次签到</button>
          </view>
        </view>
      </view>

      <view class="query-tabs">
        <text class="qtab {{queryType=='week'?'active':''}}" bindtap="switchQuery" data-type="week">📅 本周</text>
        <text class="qtab {{queryType=='month'?'active':''}}" bindtap="switchQuery" data-type="month">📆 本月</text>
        <text class="qtab {{queryType=='year'?'active':''}}" bindtap="switchQuery" data-type="year">📅 全年</text>
      </view>

      <view class="record-list">
        <view class="record-item" wx:for="{{displayRecords}}" wx:key="date">
          <view class="rec-left">
            <text class="rec-date">{{item.date}}</text>
            <text class="rec-status {{item.status=='正常'?'normal':(item.status=='在岗'?'active':'late')}}">{{item.status}}</text>
          </view>
          <view class="rec-events">
            <view wx:if="{{item.eventSummary}}" class="rec-events-chain">
              <text class="rec-ev" wx:for="{{item.events}}" wx:for-item="ev" wx:key="index">
                <text class="rec-ev-time">{{ev.time}}</text>
                <text class="rec-ev-icon {{ev.type}}">{{ev.type=='in'?'↑':'↓'}}</text>
              </text>
            </view>
            <view wx:else class="rec-simple">
              <text class="rec-in">{{item.checkIn||'—'}}</text>
              <text class="rec-sep">~</text>
              <text class="rec-out">{{item.checkOut||'—'}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{displayRecords.length==0}}"><text>暂无记录</text></view>
    </view>
  </view>
  <staff-bottom-nav active="dashboard"></staff-bottom-nav>
</view>