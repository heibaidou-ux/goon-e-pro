<view class="phone">
  <view class="page">
  <!-- 顶部 -->
  <view class="header">
    <view class="header-left">
      <text class="header-title">📊 工作台</text>
      <text class="header-store">{{storeName}}</text>
    </view>
    <view class="header-right">
      <text class="header-time">{{timeStr}}</text>
    </view>
  </view>

  <!-- 四宫格：今日营收/待办事项/订单状态/告警信息 -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-icon">💰</text>
      <text class="stat-num">¥{{stats.todayRevenue}}</text>
      <text class="stat-label">今日营收</text>
    </view>
    <view class="stat-card" bindtap="goTodo">
      <text class="stat-icon">📋</text>
      <text class="stat-num">{{stats.pendingTasks}}</text>
      <text class="stat-label">待办事项</text>
    </view>
    <view class="stat-card" bindtap="goOrders">
      <text class="stat-icon">📦</text>
      <text class="stat-num">{{stats.orderStatus || stats.todayOrders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-card {{stats.alerts > 0 ? 'alert' : ''}}" bindtap="goDeviceMonitor">
      <text class="stat-icon">{{stats.alerts > 0 ? '⚠️' : '✅'}}</text>
      <text class="stat-num">{{stats.alerts > 0 ? stats.alerts : 0}}</text>
      <text class="stat-label">告警信息</text>
    </view>
  </view>

  <!-- 房态总览卡片 -->
  <view class="room-overview-card" bindtap="goRoomStatus">
    <view class="rov-header">
      <text class="rov-title">🏠 实时房态</text>
      <text class="rov-link">查看详情 ›</text>
    </view>
    <view class="rov-grid">
      <view class="rov-item idle"><text class="rov-num">{{roomOverview.idle}}</text><text class="rov-label">空闲</text></view>
      <view class="rov-item inuse"><text class="rov-num">{{roomOverview.inUse}}</text><text class="rov-label">使用中</text></view>
      <view class="rov-item booked"><text class="rov-num">{{roomOverview.booked}}</text><text class="rov-label">已预订</text></view>
      <view class="rov-item cleaning"><text class="rov-num">{{roomOverview.cleaning}}</text><text class="rov-label">待打扫</text></view>
    </view>
  </view>

  <!-- 快捷按钮：验券、开门、监控、对账 2×2 -->
  <view class="section-title">快捷操作</view>
  <view class="quick-actions">
    <view class="action-item" bindtap="goRoomStatus">
      <text class="action-icon">🏠</text>
      <text class="action-label">房态</text>
    </view>
    <view class="action-item" bindtap="goOpenDoor">
      <text class="action-icon">🚪</text>
      <text class="action-label">开门</text>
    </view>
    <view class="action-item" bindtap="goCouponVerify">
      <text class="action-icon">🎫</text>
      <text class="action-label">验券</text>
    </view>
    <view class="action-item" bindtap="goReconciliation">
      <text class="action-icon">🧾</text>
      <text class="action-label">对账</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section-title">更多功能</view>
  <view class="feature-grid">
    <view class="feature-item" bindtap="goDeviceMonitor">
      <text class="feature-icon">📡</text>
      <text class="feature-label">监控</text>
    </view>
    <view class="feature-item" bindtap="goAttendance">
      <text class="feature-icon">📅</text>
      <text class="feature-label">考勤</text>
    </view>
    <view class="feature-item" bindtap="goProducts">
      <text class="feature-icon">📦</text>
      <text class="feature-label">商品</text>
    </view>
    <view class="feature-item" bindtap="goInspection">
      <text class="feature-icon">🔍</text>
      <text class="feature-label">巡检</text>
    </view>
    <view class="feature-item" bindtap="goScheduling">
      <text class="feature-icon">📋</text>
      <text class="feature-label">排班</text>
    </view>
    <view class="feature-item" bindtap="goProfile">
      <text class="feature-icon">👤</text>
      <text class="feature-label">个人</text>
    </view>
  </view>

</view>
  <!-- 开门菜单 -->
  <view class="modal-overlay modal-center" wx:if="{{showDoorMenu}}" bindtap="hideDoorMenu">
    <view class="door-menu" catchtap>
      <text class="door-menu-title">🚪 选择房间开门</text>
      <view class="door-menu-item {{idx==0?'first':''}}" wx:for="{{doorRooms}}" wx:for-index="idx" wx:key="*this" bindtap="selectDoorRoom" data-idx="{{idx}}">
        <text class="dmi-icon">🚪</text>
        <text class="dmi-name">{{item}}</text>
        <text class="dmi-arrow">›</text>
      </view>
      <view class="door-menu-item cancel" bindtap="hideDoorMenu">取消</view>
    </view>
  </view>  <staff-bottom-nav active="dashboard"></staff-bottom-nav>
</view>