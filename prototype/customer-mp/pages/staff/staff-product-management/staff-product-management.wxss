.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page {min-height:0; flex:1; overflow-y:auto; }.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0;display:flex;justify-content:space-between;align-items:center}.header-title{font-size:18px;font-weight:700}.header-stats{font-size:12px;color:#999}.stats-bar{display:flex;gap:8px;padding:12px 16px;background:#fff}.s-item{flex:1;text-align:center;background:#f9fafb;border-radius:12px;padding:12px 4px;position:relative}.s-item.warn{background:#fff3e0}.s-item.warn.active{background:#5D8A6B}.s-item.warn.active .s-n,.s-item.warn.active .s-l{color:#fff}.s-n{font-size:20px;font-weight:700;color:#333;display:block}.s-l{font-size:10px;color:#999;display:block;margin-top:2px}.s-unit{font-size:9px;color:#bbb;display:block;margin-top:1px}.cat-tabs{display:flex;gap:6px;padding:0 16px 12px;background:#fff}.cat-tab{flex:1;padding:8px;border-radius:10px;text-align:center;font-size:12px;font-weight:600;background:#f5f5f5;color:#666}.cat-tab.active{background:#5D8A6B;color:#fff}.product-list{padding:0 16px}.p-card{background:#fff;border-radius:14px;padding:14px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.04)}.pc-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}.pc-icon{font-size:24px;width:36px;text-align:center}.pc-name{font-size:14px;font-weight:600;display:block}.pc-desc{font-size:11px;color:#999;display:block;margin-top:1px}.pc-stock{font-size:11px;color:#5D8A6B;flex-shrink:0}.pc-stock.low{color:#e53935}.pc-actions{display:flex;gap:6px;padding-top:10px;border-top:1px solid #f0f0f0}.pa-btn{flex:1;padding:8px;border-radius:10px;font-size:12px;font-weight:600;text-align:center;background:#f5f5f5;color:#333}.pa-btn:active{opacity:.7}.pa-btn.primary{background:linear-gradient(135deg,#5D8A6B,#7BA88E);color:#fff}.transfer-section{padding:0 16px;margin-top:8px}.section-title{font-size:13px;font-weight:600;color:#333;display:block;margin-bottom:8px}.t-item{display:flex;justify-content:space-between;padding:10px;background:#fff;border-radius:10px;margin-bottom:6px;font-size:12px;flex-wrap:wrap;align-items:center}.ti-name{color:#333;font-weight:500}.ti-from{color:#5D8A6B;font-size:10px;width:100%;margin-top:1px}.ti-status{color:#B8860B}.ti-time{color:#999;width:100%;margin-top:2px}.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center}.modal{background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw;text-align:center}.modal-title{font-size:15px;font-weight:600;display:block;margin-bottom:12px}.modal-hint{font-size:12px;color:#999;display:block;margin-bottom:12px}.modal-note{font-size:11px;color:#e53935;display:block;margin-bottom:8px}.modal-desc{font-size:13px;color:#666;line-height:1.6;display:block;margin-bottom:12px}.modal-input{width:100%;height:42px;line-height:38px;padding:0 12px;border:1.5px solid #e5e5e5;border-radius:10px;font-size:14px;margin-bottom:10px;box-sizing:border-box;text-align:center}.modal-btns{display:flex;gap:10px;margin-top:12px}.m-btn{flex:1;padding:12px;border-radius:14px;font-size:14px;font-weight:600;text-align:center}.m-btn.cancel{background:#f5f5f5;color:#666}.m-btn.primary{background:#5D8A6B;color:#fff}
