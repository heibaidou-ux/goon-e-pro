.page {min-height:0; flex:1; overflow-y:auto; }.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0}.header-title{font-size:18px;font-weight:700}.content{padding:0 16px}.date-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;background:#fff}.date-label{font-size:13px;color:#666}.date-picker{font-size:13px;color:#5D8A6B;font-weight:600;background:#F2F6F0;padding:6px 12px;border-radius:8px}.revenue-card{background:linear-gradient(135deg,#5D8A6B,#7BA88E);border-radius:16px;padding:20px;margin:12px 0;color:#fff}.rev-label{font-size:12px;opacity:.8;display:block}.rev-amount{font-size:36px;font-weight:800;display:block;margin:4px 0 16px}.rev-detail{display:flex;gap:12px}.rev-item{flex:1;background:rgba(255,255,255,.15);border-radius:10px;padding:10px;text-align:center}.ri-label{font-size:10px;opacity:.8;display:block}.ri-value{font-size:15px;font-weight:700;display:block;margin-top:2px}.section-title{font-size:13px;font-weight:600;color:#333;margin:16px 0 8px;display:block}.section-badge{display:inline-block;background:#e53935;color:#fff;border-radius:10px;padding:1px 8px;font-size:10px;margin-left:4px}.pay-list{background:#fff;border-radius:12px;overflow:hidden}.pay-row{display:flex;justify-content:space-between;padding:14px;border-bottom:1px solid #f5f5f5;font-size:13px}.pay-row:last-child{border-bottom:none}.pay-name{color:#333}.pay-amount{font-weight:600}.extra-list{background:#fff;border-radius:12px;overflow:hidden}.extra-row{display:flex;justify-content:space-between;padding:14px;border-bottom:1px solid #f5f5f5;font-size:13px}.extra-row:last-child{border-bottom:none}.ex-label{color:#666}.ex-value{font-weight:600}.ex-value.warn{color:#e53935}.ex-arrow{color:#5D8A6B}.anomaly-card{background:#fff3e0;border-radius:12px;padding:14px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between}.ac-type{font-size:13px;font-weight:600;color:#B8860B;display:block}.ac-desc{font-size:12px;color:#666;display:block;margin-top:2px}.ac-time{font-size:10px;color:#999;display:block;margin-top:2px}.ac-btn{padding:8px 16px;background:#5D8A6B;color:#fff;border-radius:8px;font-size:12px;font-weight:600}.his-tag{font-size:10px;background:#f0faf2;color:#5D8A6B;padding:2px 8px;border-radius:6px}.task-list{background:#fff;border-radius:12px;overflow:hidden;margin-bottom:12px}.task-item{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid #f0f0f0}.task-item:last-child{border-bottom:none}.ti-left{flex:1}.ti-room{font-size:13px;font-weight:600;display:block;color:#333}.ti-customer{font-size:11px;color:#999;display:block;margin-top:2px}.ti-right{text-align:right}.ti-amount{font-size:14px;font-weight:700;color:#B8860B;display:block}.ti-status{font-size:10px;color:#999;display:block;margin-top:2px}
