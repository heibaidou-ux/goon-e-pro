.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page {min-height:0; flex:1; overflow-y:auto; }
.profile-header { padding:32px 16px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; text-align:center; }
.avatar { width:56px; height:56px; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; overflow:hidden; background:linear-gradient(135deg,#5D8A6B,#7BA88E); }
.avatar .avatar-img { width:100%; height:100%; }
.avatar .avatar-text { font-size:24px; font-weight:700; color:#fff; }
.name { font-size:20px; font-weight:700; display:block; }
.role { font-size:12px; opacity:.8; margin-top:4px; display:block; }
.menu-list { margin-top:12px; background:#fff; padding:0 16px; }
.menu-item { padding:16px 0; border-bottom:1px solid #f5f5f5; font-size:15px; }
.logout-btn { margin:24px 16px; padding:14px; border-radius:16px; background:#fff; color:#e53935; border:1px solid #e53935; font-size:15px; width:calc(100% - 32px); text-align:center; box-sizing:border-box; }