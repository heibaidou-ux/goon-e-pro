.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page {min-height:0; flex:1; overflow-y:auto; }
.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0ece6; display:flex; justify-content:space-between; align-items:center; }
.header-title { font-size:18px; font-weight:700; }
.header-stats { font-size:12px; color:#999; }

/* Legend */
.legend-bar { display:flex; align-items:center; gap:12px; padding:10px 16px; background:#fff; border-bottom:1px solid #f0ece6; font-size:11px; }
.legend-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.legend-dot.inuse { background:#00a870; }
.legend-dot.booked { background:#9c27b0; }
.legend-dot.free { background:#ddd; }
.legend-label { color:#999; margin-right:8px; }

/* Room cards */
.room-grid { padding:12px 16px; }
.room-card { background:#fff; border-radius:14px; padding:14px; margin-bottom:10px; box-shadow:0 2px 8px rgba(0,0,0,.04); border-left:4px solid #eee; }
.room-card.inuse { border-left-color:#00a870; }
.room-card.booked { border-left-color:#9c27b0; }
.room-card.free { border-left-color:#ddd; }
.rc-top { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
.rc-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.rc-dot.inuse { background:#00a870; }
.rc-dot.booked { background:#9c27b0; }
.rc-dot.free { background:#ddd; }
.rc-name { font-size:15px; font-weight:600; flex:1; color:#2C2C2C; }
.rc-type { font-size:11px; color:#999; }
.rc-status { font-size:12px; font-weight:600; display:block; margin-bottom:4px; }
.rc-status.inuse { color:#00a870; }
.rc-status.booked { color:#9c27b0; }
.rc-status.free { color:#999; }

/* Order info */
.rc-order { background:#f9fafb; border-radius:8px; padding:8px 10px; margin-top:6px; display:flex; justify-content:space-between; align-items:center; }
.rc-order.booked { background:#faf5ff; }
.rc-customer { font-size:12px; color:#333; font-weight:500; }
.rc-time { font-size:11px; color:#999; }

/* Action buttons */
.rc-actions { display:flex; gap:6px; margin-top:8px; }
.rca-btn { padding:6px 14px; border-radius:8px; font-size:12px; font-weight:600; }
.rca-btn.primary { background:#5D8A6B; color:#fff; }
.rca-btn.outline { background:#faf5ff; color:#9c27b0; border:1px solid #9c27b0; }
.rca-btn:active { opacity:.8; }

/* Room menu (centered modal) */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:99;display:flex;align-items:center;justify-content:center; }
.room-menu { background:#fff;border-radius:20px;padding:20px 0;width:280px;max-width:85vw;text-align:center; }
.rm-title { font-size:17px;font-weight:700;color:#333;display:block;margin-bottom:2px;padding:0 20px; }
.rm-status { font-size:12px;display:block;margin-bottom:12px;padding:0 20px; }
.rm-status.free { color:#00a870; }
.rm-status.inuse { color:#00a870; }
.rm-status.booked { color:#9c27b0; }
.rm-item { padding:12px 20px;font-size:14px;border-top:1px solid #f5f5f5; }
.rm-item:active { background:#f0faf2; }
.rm-item.primary { color:#5D8A6B;font-weight:600; }
.rm-item.danger { color:#D54941; }
.rm-item.cancel { color:#999;font-size:13px; }

/* Booking form modal */
.modal { background:#fff;border-radius:20px;padding:24px;width:340px;max-width:90vw;max-height:85vh;overflow-y:auto; }
.modal-title { font-size:16px;font-weight:600;display:block;margin-bottom:16px;text-align:center; }
.form-section { margin-bottom:12px; }
.form-label { font-size:12px;color:#666;display:block;margin-bottom:4px; }
.form-input { width:100%;height:42px;line-height:38px;padding:0 12px;border:1.5px solid #e5e5e5;border-radius:10px;font-size:14px;box-sizing:border-box; }
.form-picker { width:100%;height:42px;line-height:38px;padding:0 12px;border:1.5px solid #e5e5e5;border-radius:10px;font-size:13px;text-align:center;color:#333;box-sizing:border-box;background:#fff; }
.form-row { display:flex;gap:10px; }
.modal-btns { display:flex;gap:10px;margin-top:16px; }
.m-btn { flex:1;padding:12px;border-radius:14px;font-size:14px;font-weight:600;text-align:center; }
.m-btn.cancel { background:#f5f5f5;color:#666; }
.m-btn.primary { background:#5D8A6B;color:#fff; }
