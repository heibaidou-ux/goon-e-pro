.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page { flex:1; overflow-y:auto; }.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0}.header-title{font-size:18px;font-weight:700}.tsection{padding:12px 16px}.ts-title{font-size:14px;font-weight:600;color:#666;display:block;margin-bottom:10px}.task-card{background:#fff;border-radius:14px;padding:16px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.04)}.task-card.urgent{border-left:3px solid #e53935}.tc-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}.tc-room{font-size:15px;font-weight:600}.tc-priority{font-size:11px;color:#e53935}.tc-meta{font-size:12px;color:#999;display:block;margin-bottom:10px}.tc-btns{display:flex;gap:8px}.tc-btn{flex:1;padding:10px;border-radius:12px;border:none;font-size:13px;font-weight:600}.tc-btn.accept{background:#5D8A6B;color:#fff}.tc-btn.complete{background:#00a870;color:#fff}.empty{text-align:center;padding:20px;color:#999;font-size:13px}
