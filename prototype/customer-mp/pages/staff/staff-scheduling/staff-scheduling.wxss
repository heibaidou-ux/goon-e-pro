.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page { flex:1; overflow-y:auto; }.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0}.header-title{font-size:18px;font-weight:700}.content{padding:0 16px}.week-nav{display:flex;align-items:center;justify-content:space-between;padding:14px 0}.week-nav-btn{font-size:12px;color:#5D8A6B;font-weight:600;padding:6px 8px;border-radius:8px;background:#f0faf2;flex-shrink:0}.week-nav-title{font-size:12px;color:#666;font-weight:500;text-align:center}.schedule-scroll{overflow-x:auto}.schedule-table{min-width:500px;background:#fff;border-radius:12px;overflow:hidden}.st-header{display:flex;background:#F2F6F0;border-bottom:1px solid #e0d8d0}.st-row{display:flex;border-bottom:1px solid #f5f5f5}.st-row:last-child{border-bottom:none}.st-cell{padding:8px 4px;text-align:center;font-size:11px;flex-shrink:0}.st-name-h{width:60px;padding-left:10px;font-weight:600}.st-name{width:60px;padding-left:10px;text-align:left}.st-day{width:48px;cursor:pointer}.st-day:active{background:#f0faf2}.st-worker{font-size:12px;font-weight:500;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.st-role{font-size:9px;color:#999;display:block;margin-top:1px}.st-shift{display:inline-block;width:26px;height:26px;line-height:26px;border-radius:50%;background:#F2F6F0;font-size:11px;font-weight:600;color:#5D8A6B}.st-day.off .st-shift{background:#f0f0f0;color:#ccc}.legend{font-size:11px;color:#999;display:block;margin-top:12px;text-align:center}.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center}.modal{background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw;text-align:center}.modal-title{font-size:16px;font-weight:600;display:block;margin-bottom:8px}.modal-desc{font-size:13px;color:#666;display:block;margin-bottom:16px}.shift-options{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}.shift-opt{padding:14px;border-radius:12px;border:1.5px solid #e5e5e5;background:#fff;font-size:13px;font-weight:600;text-align:center}.shift-opt.selected{border-color:#5D8A6B;background:#f0faf2;color:#5D8A6B}.shift-opt:active{border-color:#5D8A6B}.modal-buttons{display:flex;gap:10px;margin-top:16px}.modal-btn{flex:1;padding:12px;border-radius:14px;font-size:14px;font-weight:600;text-align:center}.modal-btn.cancel{background:#f5f5f5;color:#666}.modal-btn.primary{background:#5D8A6B;color:#fff}
