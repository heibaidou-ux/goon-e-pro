page { background:#5D8A6B; margin:0; padding:0; }
.login-fullscreen { position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center; }
.login-bg { width:100%;height:100%;background:linear-gradient(135deg,#5D8A6B,#7BA88E);display:flex;align-items:center;justify-content:center; }
.login-card { background:#fff;border-radius:16px;padding:32px 24px;width:320px;text-align:center; }
.login-card-title { font-size:22px;font-weight:700;color:#1a1a1a;display:block;margin-bottom:4px; }
.login-card-sub { font-size:12px;color:#999;display:block;margin-bottom:16px; }

/* 角色切换Tab */
.role-tabs { display:flex;margin-bottom:16px;border-radius:16px;overflow:hidden;border:1px solid #e5e5e5; }
.role-tab { flex:1;padding:10px;font-size:13px;background:#f5f5f5;color:#999;text-align:center; }
.role-tab.active { background:#5D8A6B;color:#fff; }

.form-item { margin-bottom:12px;text-align:left; }
.form-label { font-size:12px;color:#999;margin-bottom:4px;display:block; }
.form-input { width:100%;height:48px;line-height:44px;padding:0 14px;border:1px solid #e5e5e5;border-radius:16px;font-size:14px;box-sizing:border-box; }
.form-btn { width:100%;padding:12px;border-radius:16px;background:#5D8A6B;color:#fff;font-size:15px;font-weight:600;margin-top:8px;text-align:center; }
.error-text { color:#d54941;font-size:13px;display:block;margin-top:8px;text-align:center; }
.login-hint { font-size:11px;color:#bbb;margin-top:12px;display:block;text-align:center; }
.back-link { font-size:12px;color:#5D8A6B;margin-top:16px;display:block;text-align:center; }

.pwd-row { display:flex; align-items:center; gap:6px; }
.pwd-input { flex:1; }
.pwd-toggle { font-size:20px; padding:8px; }
.form-options { display:flex; align-items:center; margin:8px 0; text-align:left; }
.remember-row { display:flex; align-items:center; gap:6px; }
.check-box { width:18px; height:18px; border:1.5px solid #ddd; border-radius:4px; display:flex; align-items:center; justify-content:center; font-size:12px; color:#5D8A6B; font-weight:700; }
.check-box.checked { border-color:#5D8A6B; background:#f0fdf4; }
.remember-label { font-size:12px; color:#999; }
