.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page {min-height:0; flex:1; overflow-y:auto; }
.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center; }
.header-title { font-size:18px; font-weight:700; }
.header-stats { font-size:12px; color:#666; }

/* Picker bar - clickable */
.picker-bar { padding:12px 16px; background:#fff; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; gap:4px; }
.picker-bar:active { background:#f5f5f5; }
.pb-label { font-size:13px; color:#999; }
.pb-value { font-size:14px; font-weight:600; color:#5D8A6B; }
.pb-arrow { font-size:12px; color:#ccc; margin-left:auto; }

.device-list { padding:12px 16px; }
.device-item { display:flex; align-items:center; padding:12px; background:#fff; border-radius:16px; margin-bottom:6px; box-shadow:0 2px 8px rgba(0,0,0,0.04); }
.device-item:active { opacity:.8; }
.device-icon { font-size:20px; width:32px; }
.device-info { flex:1; }
.device-name { font-size:14px; font-weight:500; display:block; color:#2C2C2C; }
.device-id { font-size:11px; color:#999; display:block; }
.device-status { font-size:12px; padding:2px 8px; border-radius:6px; }
.device-status.online { background:#f0fdf4; color:#00A870; }
.device-status.offline { background:#fce4e4; color:#e53935; }

/* Centered room picker modal */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:99;display:flex;align-items:center;justify-content:center; }
.room-picker-modal { background:#fff;border-radius:20px;width:280px;max-width:85vw;overflow:hidden; }
.rpm-title { font-size:16px;font-weight:700;padding:16px 20px 12px;text-align:center;color:#333;border-bottom:1px solid #f0ece6; }
.rpm-item { display:flex;align-items:center;justify-content:space-between;padding:14px 20px;font-size:14px;border-bottom:1px solid #f5f5f5; }
.rpm-item:active { background:#f0faf2; }
.rpm-item.active { color:#5D8A6B;font-weight:600; }
.rpm-check { color:#5D8A6B;font-weight:700; }
.rpm-item.cancel { justify-content:center;color:#999;border-bottom:none; }
