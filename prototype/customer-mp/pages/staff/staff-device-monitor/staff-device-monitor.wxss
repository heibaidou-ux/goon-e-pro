.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page {min-height:0; flex:1; overflow-y:auto; }
.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center; }
.header-title { font-size:18px; font-weight:700; }
.header-stats { font-size:12px; color:#666; }

/* 5个房间按钮 */
.room-bar { display:flex; background:#fff; border-bottom:1px solid #f0f0f0; padding:8px 12px; gap:6px; }
.rbar-item { flex:1; text-align:center; padding:8px 2px; border-radius:10px; font-size:12px; font-weight:500; background:#f5f5f5; color:#666; }
.rbar-item:active { opacity:.7; }
.rbar-item.active { background:#5D8A6B; color:#fff; font-weight:600; }

.device-list { padding:12px 16px; }
.device-item { display:flex; align-items:center; padding:12px; background:#fff; border-radius:16px; margin-bottom:6px; box-shadow:0 2px 8px rgba(0,0,0,0.04); }
.device-item:active { opacity:.8; }
.device-icon { font-size:20px; width:32px; }
.device-info { flex:1; }
.device-name { font-size:14px; font-weight:500; display:block; color:#2C2C2C; }
.device-id { font-size:11px; color:#999; display:block; }
.device-status { font-size:12px; padding:2px 8px; border-radius:6px; }
.device-status.online { background:#f0fdf4; color:#00A870; }
.device-status.offline { background:#fce4e4; color:#e53935; }
