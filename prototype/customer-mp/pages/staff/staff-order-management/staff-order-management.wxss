.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page {min-height:0; flex:1; overflow-y:auto; }
.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; }
.header-title { font-size:18px; font-weight:700; }
.order-tabs { display:flex; background:#fff; border-bottom:1px solid #f0f0f0; padding:0 16px; }
.order-tab { flex:1; text-align:center; padding:14px 0; font-size:13px; color:#999; }
.order-tab.active { color:#5D8A6B; font-weight:600; border-bottom:2px solid #5D8A6B; }

/* 一级分类 */
.type-tabs { display:flex; background:#fff; border-bottom:1px solid #f0f0f0; }
.type-tab { flex:1; text-align:center; padding:12px 0; font-size:14px; font-weight:600; color:#999; position:relative; }
.type-tab.active { color:#5D8A6B; background:#f0faf2; }

/* Tab角标 */
.tab-badge { display:inline-block; background:#00a870; color:#fff; font-size:10px; min-width:16px; height:16px; line-height:16px; border-radius:8px; text-align:center; margin-left:4px; padding:0 4px; vertical-align:top; }
.tab-badge.purple { background:#9c27b0; }
.type-tab.active::after { content:''; position:absolute; bottom:0; left:50%; transform:translateX(-50%); width:40px; height:3px; background:#5D8A6B; border-radius:2px; }

/* 订单类型标签 */
.oc-room-tag { font-size:10px; font-weight:600; padding:2px 8px; border-radius:6px; margin-right:6px; flex-shrink:0; }
.oc-room-tag.room { background:#e8f5e9; color:#00a870; }
.oc-room-tag.tea { background:#fff3e0; color:#B8860B; }
.oc-items { font-size:12px; color:#999; display:block; margin:4px 0; }
.oc-tracking { font-size:11px; color:#5D8A6B; display:block; margin-top:2px; }
.order-list { padding:12px 16px; }
.order-card { background:#fff; border-radius:14px; padding:16px; margin-bottom:10px; box-shadow:0 2px 8px rgba(0,0,0,.04); }
.oc-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }
.oc-room { font-size:15px; font-weight:600; }
.oc-status { font-size:11px; padding:3px 10px; border-radius:10px; }
.oc-status.status-inuse { background:#e8f5e9; color:#00a870; }
.oc-status.status-booked { background:#f3e5f5; color:#9c27b0; }
.oc-status.status-completed { background:#f5f5f5; color:#999; }
.oc-status.status-expired { background:#f5f5f5; color:#bbb; }
.order-card.expired { opacity:.65; }
.expired-notice { font-size:11px; color:#999; margin-top:6px; display:block; padding:6px 10px; background:#f9f9f9; border-radius:6px; }
.oc-time { font-size:12px; color:#999; display:block; }
.oc-amount { font-size:16px; font-weight:700; color:#B8860B; display:block; margin:4px 0; }
.oc-customer { font-size:12px; color:#666; display:block; }
.oc-source { font-size:11px; color:#5D8A6B; display:block; margin-top:2px; }
.oc-phone { font-size:12px; color:#5D8A6B; display:block; margin-top:2px; }.oc-booked { font-size:10px; color:#999; display:block; margin-top:1px; }
.header-search-btn { font-size:18px; position:absolute; right:16px; top:14px; padding:4px 8px; }
.header { position:relative; }
.search-bar { display:flex; gap:8px; padding:10px 16px; background:#fff; border-bottom:1px solid #f0f0f0; }
.search-input { flex:1; height:36px; line-height:34px; padding:0 12px; border:1.5px solid #e0d8d0; border-radius:10px; font-size:13px; box-sizing:border-box; }
.search-btn { padding:8px 16px; border-radius:10px; background:#5D8A6B; color:#fff; font-size:13px; font-weight:600; }
.search-btn:active { opacity:.8; }
.oc-actions { display:flex; gap:8px; margin-top:12px; padding-top:12px; border-top:1px solid #f0f0f0; }
.oc-btn { flex:1; padding:10px; border-radius:12px; font-size:13px; font-weight:600; text-align:center; }
.oc-btn.primary { background:#5D8A6B; color:#fff; border:none; }
.oc-btn.outline { background:#fff; color:#5D8A6B; border:1.5px solid #5D8A6B; }
.oc-btn.danger { background:#fff; color:#D54941; border:1.5px solid #D54941; }
.empty { text-align:center; padding:60px 20px; color:#ccc; }
.empty-icon { font-size:48px; display:block; margin-bottom:12px; }

/* 详情弹窗 */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw; }
.modal-title { font-size:16px;font-weight:600;display:block;margin-bottom:12px;text-align:center; }
.detail-content { margin-bottom:8px; }
.detail-row { display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f5f5f5;font-size:13px; }
.dl { color:#999; }
.dv { color:#333;font-weight:500; }
.source-section { margin-top:12px; padding:12px; background:#f9fafb; border-radius:10px; }
.source-title { font-size:13px;font-weight:600;color:#333;display:block;margin-bottom:8px; }
.source-picker { padding:10px 12px; border:1.5px solid #e0d8d0; border-radius:10px; font-size:13px; color:#333; background:#fff; text-align:center; }
.modal-buttons { display:flex;gap:10px;margin-top:16px; }
.modal-btn { flex:1;padding:12px;border-radius:16px;font-size:14px;font-weight:600;text-align:center; }
.modal-btn.cancel { background:#f5f5f5;color:#666; }
.modal-btn.primary { background:#5D8A6B;color:#fff; }
.oc-delivery { font-size:11px; color:#B8860B; display:block; margin-top:2px; }

/* 发货表单 */
.ship-form { margin:8px 0; }
.ship-row { display:flex; justify-content:space-between; padding:8px 0; font-size:13px; border-bottom:1px solid #f5f5f5; }
.ship-label { color:#999; }
.ship-value { color:#333; font-weight:500; text-align:right; max-width:65%; }
.form-input { width:100%; height:42px; line-height:38px; padding:0 12px; border:1.5px solid #e5e5e5; border-radius:10px; font-size:14px; margin-top:8px; box-sizing:border-box; }
