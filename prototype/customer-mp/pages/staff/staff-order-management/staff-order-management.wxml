<view class="phone">
  <view class="page">
    <view class="header">
      <text class="header-title">📋 订单管理</text>
      <text class="header-search-btn" bindtap="toggleSearch">🔍</text>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar" wx:if="{{showSearch}}">
      <input class="search-input" placeholder="搜索：姓名 / 手机号 / 日期" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch" />
      <text class="search-btn" bindtap="doSearch">搜索</text>
    </view>

    <view class="order-tabs">
      <view class="order-tab {{tabIndex==0?'active':''}}" bindtap="switchTab" data-tab="0">进行中</view>
      <view class="order-tab {{tabIndex==1?'active':''}}" bindtap="switchTab" data-tab="1">已预订</view>
      <view class="order-tab {{tabIndex==2?'active':''}}" bindtap="switchTab" data-tab="2">已完成</view>
      <view class="order-tab {{tabIndex==3?'active':''}}" bindtap="switchTab" data-tab="3">已失效</view>
    </view>

    <view class="order-list">

      <!-- 进行中 -->
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{tabIndex==0}}">
        <view class="oc-header">
          <text class="oc-room">{{item.roomName}}</text>
          <text class="oc-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
        <text class="oc-time">{{item.date}} {{item.time}}</text>
        <text class="oc-amount">¥{{item.amount}}</text>
        <text class="oc-customer" wx:if="{{item.customerName}}">👤 {{item.customerName}}</text>
        <text class="oc-source" wx:if="{{item.customerSource}}">📌 来源：{{item.customerSource}}</text>
        <view class="oc-actions" wx:if="{{item.isRoomOrder}}">
          <view class="oc-btn primary" bindtap="completeOrder" data-id="{{item.orderId}}">完成订单</view>
          <view class="oc-btn outline" bindtap="showOrderDetail" data-id="{{item.orderId}}">详情</view>
        </view>
        <view class="oc-actions" wx:if="{{item.isTeaOrder && item.deliveryMethod=='express'}}">
          <view class="oc-btn primary" bindtap="shipOrder" data-id="{{item.orderId}}">📬 发货</view>
          <view class="oc-btn outline" bindtap="showOrderDetail" data-id="{{item.orderId}}">详情</view>
        </view>
        <view class="oc-actions" wx:if="{{item.isTeaOrder && item.deliveryMethod!='express'}}">
          <view class="oc-btn primary" bindtap="completeDelivery" data-id="{{item.orderId}}">{{item.deliveryMethod=='inroom'?'🏠 已送达':'📦 发货'}}</view>
          <view class="oc-btn outline" bindtap="showOrderDetail" data-id="{{item.orderId}}">详情</view>
        </view>
      </view>

      <!-- 已预订 -->
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{tabIndex==1}}">
        <view class="oc-header">
          <text class="oc-room">{{item.roomName}}</text>
          <text class="oc-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
        <text class="oc-time">{{item.date}} {{item.time}}</text>
        <text class="oc-amount">¥{{item.amount}}</text>
        <text class="oc-customer" wx:if="{{item.customerName}}">👤 {{item.customerName}}</text>
        <text class="oc-phone" wx:if="{{item.phone}}">📞 {{item.phone}}</text>
        <text class="oc-source" wx:if="{{item.customerSource}}">📌 来源：{{item.customerSource}}</text>
        <view class="oc-actions">
          <view class="oc-btn primary" bindtap="checkIn" data-id="{{item.orderId}}">办理入住</view>
          <view class="oc-btn outline" bindtap="showOrderDetail" data-id="{{item.orderId}}">详情</view>
        </view>
      </view>

      <!-- 已完成 -->
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{tabIndex==2}}">
        <view class="oc-header">
          <text class="oc-room">{{item.roomName}}</text>
          <text class="oc-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
        <text class="oc-time">{{item.date}} {{item.time}}</text>
        <text class="oc-amount">¥{{item.amount}}</text>
        <text class="oc-customer" wx:if="{{item.customerName}}">👤 {{item.customerName}}</text>
        <view class="oc-actions">
          <view class="oc-btn outline" bindtap="showOrderDetail" data-id="{{item.orderId}}">详情</view>
        </view>
      </view>

      <!-- 已失效 -->
      <view class="order-card expired" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{tabIndex==3}}">
        <view class="oc-header">
          <text class="oc-room">{{item.roomName}}</text>
          <text class="oc-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
        <text class="oc-time">{{item.date}} {{item.time}}</text>
        <text class="oc-amount">¥{{item.amount}}</text>
        <text class="oc-customer" wx:if="{{item.customerName}}">👤 {{item.customerName}}</text>
        <text class="oc-phone" wx:if="{{item.phone}}">📞 {{item.phone}}</text>
        <view class="expired-notice">⏰ 已超过使用时间，自动失效</view>
        <view class="oc-actions">
          <view class="oc-btn outline" bindtap="showOrderDetail" data-id="{{item.orderId}}">详情</view>
        </view>
      </view>

      <view class="empty" wx:if="{{filteredOrders.length==0}}">
        <text>📋 暂无订单</text>
      </view>
    </view>

    <!-- 详情弹窗 -->
    <view class="modal-overlay" wx:if="{{showDetail}}" bindtap="hideDetail">
      <view class="modal" catchtap>
        <text class="modal-title">📋 订单详情</text>
        <view wx:if="{{detailOrder}}">
          <view class="detail-row"><text class="dl">订单</text><text class="dv">{{detailOrder.orderId}}</text></view>
          <view class="detail-row" wx:if="{{detailOrder.isTeaOrder}}"><text class="dl">类型</text><text class="dv">茶品订单</text></view>
          <view class="detail-row" wx:if="{{!detailOrder.isTeaOrder}}"><text class="dl">房间</text><text class="dv">{{detailOrder.roomName}}</text></view>
          <view class="detail-row"><text class="dl">时段</text><text class="dv">{{detailOrder.time}}</text></view>
          <view class="detail-row"><text class="dl">金额</text><text class="dv">¥{{detailOrder.amount}}</text></view>
          <view class="detail-row"><text class="dl">姓名</text><text class="dv">{{detailOrder.customerName || '—'}}</text></view>
          <view class="detail-row"><text class="dl">电话</text><text class="dv">{{detailOrder.phone || '—'}}</text></view>
          <view wx:if="{{detailOrder.deliveryMethod}}"><text class="dl">配送</text><text class="dv">{{detailOrder.deliveryLabel}}</text></view>

          <view class="source-section">
            <text class="source-title">👤 客户来源</text>
            <picker mode="selector" range="{{sourceOptions}}" bindchange="onSourceChange">
              <view class="source-picker">{{editSource || '请选择'}} ▾</view>
            </picker>
          </view>
        </view>
        <view class="modal-buttons">
          <view class="modal-btn cancel" bindtap="hideDetail">关闭</view>
          <view class="modal-btn primary" bindtap="saveSource">保存来源</view>
        </view>
      </view>
    </view>

    <!-- 发货弹窗 -->
    <view class="modal-overlay" wx:if="{{showShipModal}}" bindtap="hideShipModal">
      <view class="modal" catchtap>
        <text class="modal-title">📬 发货</text>
        <input class="form-input" placeholder="快递公司（如顺丰速运）" value="{{shipCarrier}}" bindinput="onShipCarrier" />
        <input class="form-input" placeholder="运单号" value="{{shipTrackingNum}}" bindinput="onShipTrackingNum" />
        <view class="modal-buttons">
          <view class="modal-btn cancel" bindtap="hideShipModal">取消</view>
          <view class="modal-btn primary" bindtap="confirmShip">确认发货</view>
        </view>
      </view>
    </view>
  </view>
  <staff-bottom-nav active="orders"></staff-bottom-nav>
</view>
