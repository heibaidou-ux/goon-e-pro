page { background:#f5f7fa; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; background:#f5f7fa; display:flex; flex-direction:column; }
.page { flex:1; overflow-y:auto; padding-bottom:60px; }
.tab-bar { display:flex; background:#fff; border-bottom:1px solid #eee; position:sticky; top:0; z-index:10; }
.tab { flex:1; text-align:center; padding:14px 0; font-size:14px; color:#999; position:relative; }
.tab.active { color:#0052D9; font-weight:600; }
.tab.active::after { content:''; position:absolute; bottom:0; left:50%; transform:translateX(-50%); width:24px; height:3px; background:#0052D9; border-radius:2px; }
.order-card { background:#fff; padding:16px; margin:0 0 10px; }
.order-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
.order-room { font-size:16px; font-weight:600; }
.order-status { font-size:12px; font-weight:600; padding:4px 10px; border-radius:16px; display:inline-block; }
.status-inuse { background:#e8f5e9; color:#00a870; }
.status-booked { background:#f3e5f5; color:#9c27b0; }
.status-completed { background:#f5f5f5; color:#999; }
.order-time { font-size:13px; color:#666; margin-bottom:4px; display:block; }
.order-price { font-size:14px; font-weight:600; color:#B8860B; margin-bottom:8px; display:block; }
.door-section { background:#fffbf0; padding:12px; display:flex; align-items:center; justify-content:space-between; margin:10px 0; border-radius:8px; }
.door-label { font-size:12px; color:#999; display:block; }
.door-code { font-size:20px; font-weight:800; color:#333; letter-spacing:6px; display:block; }
.door-hint { font-size:12px; color:#B8860B; }
.big-actions { display:flex; gap:10px; margin-top:10px; }
.big-action-btn { flex:1; padding:14px; border-radius:16px; font-size:15px; font-weight:600; text-align:center; }
.big-action-btn.primary { background:#0052D9; color:#fff; border:none; }
.big-action-btn.outline { background:#fff; color:#0052D9; border:1.5px solid #0052D9; }
.big-action-btn.ghost { background:#f5f5f5; color:#666; border:none; }
.logistics-card { background:#f8f9fa; border-radius:16px; padding:12px; margin:10px 0; }
.logistics-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }
.logistics-carrier { font-size:13px; font-weight:600; color:#333; }
.carrier-icon { font-size:16px; margin-right:4px; }
.logistics-tracking { font-size:12px; color:#666; display:block; }
.tracking-num { color:#0052D9; }
.logistics-status-row { display:flex; align-items:center; gap:6px; margin-top:6px; padding-top:6px; border-top:1px solid #eee; }
.ls-badge { font-size:11px; padding:2px 8px; border-radius:6px; font-weight:600; display:inline-block; }
.ls-badge.pending { background:#fff3e0; color:#B8860B; }
.ls-badge.transit { background:#e3f2fd; color:#0052D9; }
.ls-badge.delivered { background:#e8f5e9; color:#00a870; }
.ls-progress { flex:1; display:flex; align-items:center; gap:2px; }
.ls-step { flex:1; text-align:center; position:relative; }
.ls-step-dot { width:8px; height:8px; border-radius:50%; display:inline-block; background:#ddd; }
.ls-step-dot.active { background:#0052D9; }
.ls-step-dot.current { background:#0052D9; box-shadow:0 0 0 3px rgba(0,82,217,.2); }
.ls-step-label { font-size:9px; color:#bbb; margin-top:2px; display:block; }
.ls-step-label.active { color:#0052D9; font-weight:600; }
.ls-line { position:absolute; top:4px; right:-50%; width:100%; height:2px; background:#ddd; }
.ls-line.active { background:#0052D9; }
.ls-estimated { font-size:11px; color:#999; margin-top:4px; display:block; }
.logistics-btn { font-size:12px; color:#0052D9; background:none; border:none; font-weight:500; padding:2px 6px; }
.empty { text-align:center; padding:60px 20px; color:#999; }
.empty-icon { font-size:48px; display:block; margin-bottom:12px; }
.bottom-nav { display:flex; border-top:1px solid #eee; background:#fff; flex-shrink:0; }
.nav-item { flex:1; text-align:center; padding:10px 0 6px; color:#999; }
.nav-item .nav-icon { font-size:20px; display:block; }
.nav-item .nav-label { font-size:10px; margin-top:2px; display:block; }
.nav-item.active { color:#0052D9; }
.lg-modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.lg-modal { background:#fff;border-radius:16px;width:340px;max-height:85vh;overflow-y:auto; }
.lg-modal-header { display:flex;justify-content:space-between;align-items:center;padding:16px 16px 0; }
.lg-title { font-size:16px;font-weight:600; }
.lg-modal-close { font-size:20px;color:#999;padding:0 4px; }
.lg-track-info { padding:12px 16px;background:#f8f9fa;margin:8px 16px;border-radius:8px; }
.lg-track-info text { display:block;font-size:12px;color:#666;margin-bottom:2px; }
.lg-carrier { font-size:14px;font-weight:600;color:#333;display:block; }
.lg-timeline { padding:16px; }
.lg-tl-item { display:flex;gap:12px;position:relative;padding-bottom:20px; }
.lg-tl-item:last-child { padding-bottom:0; }
.lg-tl-dot { width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:2px;position:relative;z-index:1; }
.lg-tl-dot.done { background:#0052D9; }
.lg-tl-dot.current { background:#0052D9;box-shadow:0 0 0 4px rgba(0,82,217,.2); }
.lg-tl-dot.pending { background:#ddd; }
.lg-tl-line { position:absolute;left:5px;top:16px;width:2px;height:calc(100% - 4px);background:#eee; }
.lg-tl-line.done { background:#0052D9; }
.lg-tl-content { flex:1; }
.lg-tl-title { font-size:14px;color:#333;display:block; }
.lg-tl-time { font-size:11px;color:#999;margin-top:2px;display:block; }

