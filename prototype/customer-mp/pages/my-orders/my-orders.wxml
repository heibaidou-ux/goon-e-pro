<view class="page"><view class="filter-bar"><view class="filter-tab {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部</view><view class="filter-tab {{filter === 'InUse' ? 'active' : ''}}" bindtap="setFilter" data-filter="InUse">进行中</view><view class="filter-tab {{filter === 'Booked' ? 'active' : ''}}" bindtap="setFilter" data-filter="Booked">已预订</view><view class="filter-tab {{filter === 'Completed' ? 'active' : ''}}" bindtap="setFilter" data-filter="Completed">已完成</view></view><view class="order-list"><view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId"><view class="order-card-header"><text>{{item.roomName || '房间'}}</text><text class="order-status {{item.status.toLowerCase()}}">{{item.statusLabel || item.status}}</text></view><text class="order-time">{{item.start}} - {{item.end}}</text><view class="order-card-footer"><text class="order-amount">¥{{item.amount || 0}}</text><text class="order-paid">{{item.paymentMethod}}</text></view></view></view><view class="empty" wx:if="{{filteredOrders.length === 0}}">暂无订单</view></view>