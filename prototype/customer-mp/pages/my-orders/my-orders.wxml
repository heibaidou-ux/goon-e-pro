<view class="phone">
  <view class="tab-bar">
    <view class="tab {{tabIndex==0?'active':''}}" bindtap="switchTab" data-tab="0">进行中</view>
    <view class="tab {{tabIndex==1?'active':''}}" bindtap="switchTab" data-tab="1">待使用</view>
    <view class="tab {{tabIndex==2?'active':''}}" bindtap="switchTab" data-tab="2">已完成</view>
    <view class="tab {{tabIndex==3?'active':''}}" bindtap="switchTab" data-tab="3">已失效</view>
  </view>
  <view class="page">
    <!-- 进行中 -->
    <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{item.status=='InUse' || item.status=='in_use' || item.status=='PendingDelivery' || item.status=='Shipped'}}">
      <view class="order-header">
        <text class="order-room">{{item.roomName}}</text>
        <view class="order-header-right">
          <text class="order-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
      </view>
      <text class="order-time">{{item.timeStr}}</text>
      <text class="order-price">¥{{item.amount}}</text>
      <text class="order-remaining" wx:if="{{item.remaining!=null}}">剩余 {{item.remaining}} 分钟</text>
      <!-- 茶品订单：显示商品明细+配送信息 -->
      <view wx:if="{{item.isTeaOrder}}" class="tea-order-items">
        <view wx:for="{{item.items}}" wx:key="name" class="tea-order-item">
          <text class="toi-name">{{item.name}} x{{item.qty ? item.qty : 1}}</text>
          <text class="toi-price">¥{{item.price ? item.price : 0}}</text>
        </view>
        <view class="delivery-status" wx:if="{{item.deliveryMethod}}">
          <text class="ds-icon">{{item.deliveryMethod=='inroom'?'🏠':(item.deliveryMethod=='express'?'📬':'🚶')}}</text>
          <text class="ds-text">{{item.deliveryLabel}}</text>
        </view>
        <!-- 物流追踪 -->
        <view class="logistics-card mini" wx:if="{{item.logistics}}" bindtap="showLogistics" data-id="{{item.orderId}}">
          <view class="logistics-header">
            <text class="logistics-carrier">{{item.logistics.icon}} {{item.logistics.carrier}}</text>
            <view class="logistics-btn">查看物流 ›</view>
          </view>
          <text class="logistics-tracking">运单号：{{item.logistics.trackingNum}}</text>
          <view class="ls-badge {{item.logistics.statusBadge}}">{{item.logistics.statusLabel}}</view>
        </view>
      </view>
      <!-- 房间订单：门禁+设备 -->
      <view wx:else>
        <view class="door-section">
          <view>
            <text class="door-label">门禁密码</text>
            <text class="door-code">{{item.doorCode ? item.doorCode : '0000'}}</text>
            <text class="door-status {{item.doorCanOpen ? 'ok' : 'no'}}">{{item.doorCanOpen ? '✅ 密码可用' : '❌ ' + (item.doorHint || '密码暂不可用')}}</text>
          </view>
        </view>
        <view class="device-grid">
          <view class="device-item" bindtap="goRoomControl" data-room-id="{{item.roomId}}" data-room-name="{{item.roomName}}">
            <text class="device-icon">💡</text>
            <text class="device-label">灯光</text>
          </view>
          <view class="device-item" bindtap="goRoomControl" data-room-id="{{item.roomId}}" data-room-name="{{item.roomName}}">
            <text class="device-icon">🪟</text>
            <text class="device-label">窗帘</text>
          </view>
          <view class="device-item" bindtap="goRoomControl" data-room-id="{{item.roomId}}" data-room-name="{{item.roomName}}">
            <text class="device-icon">❄️</text>
            <text class="device-label">空调</text>
          </view>
          <view class="device-item" bindtap="goRoomControl" data-room-id="{{item.roomId}}" data-room-name="{{item.roomName}}">
            <text class="device-icon">🎵</text>
            <text class="device-label">音乐</text>
          </view>
        </view>
      </view>
      <view class="big-actions">
        <view wx:if="{{!item.isTeaOrder}}" class="big-action-btn primary" bindtap="openDoor" data-id="{{item.orderId}}">🚪 开门</view>
        <view wx:if="{{!item.isTeaOrder}}" class="big-action-btn outline" bindtap="showExtend" data-id="{{item.orderId}}">⏱ 续订</view>
        <view class="big-action-btn ghost" bindtap="callService" data-id="{{item.orderId}}">📞 客服</view>
      </view>
    </view>

    <!-- 待使用 -->
    <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{item.status=='Booked'}}">
      <view class="order-header">
        <text class="order-room">{{item.roomName}}</text>
        <view class="order-header-right">
          <text class="order-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
      </view>
      <text class="order-time">{{item.timeStr}}</text>
      <text class="order-price">¥{{item.amount}}</text>
      <!-- 茶品订单：显示商品明细 -->
      <view wx:if="{{item.isTeaOrder}}" class="tea-order-items">
        <view wx:for="{{item.items}}" wx:key="name" class="tea-order-item">
          <text class="toi-name">{{item.name}} x{{item.qty ? item.qty : 1}}</text>
          <text class="toi-price">¥{{item.price ? item.price : 0}}</text>
        </view>
      </view>
      <view wx:else class="door-section">
        <view>
          <text class="door-label">门禁密码</text>
          <text class="door-code">{{item.doorCode ? item.doorCode : '0000'}}</text>
        </view>
        <text wx:if="{{!item.doorCanOpen}}" class="door-hint">{{item.doorHint}}</text>
      </view>
      <view class="big-actions">
        <view wx:if="{{item.doorCanOpen}}" class="big-action-btn primary" bindtap="openDoor" data-id="{{item.orderId}}">🚪 开门</view>
        <view class="big-action-btn danger" bindtap="showCancel" data-id="{{item.orderId}}">取消预约</view>
      </view>
      <text class="cancel-note" wx:if="{{item.cancelMsg}}">{{item.cancelMsg}}</text>
    </view>

    <!-- 已完成 -->
    <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{item.status=='Completed'}}">
      <view class="order-header">
        <text class="order-room">{{item.roomName}}</text>
        <view class="order-header-right">
          <text class="order-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
      </view>
      <text class="order-time">{{item.timeStr}}</text>
      <text class="order-price">¥{{item.amount}}</text>
      <!-- 茶品订单：显示商品明细 -->
      <view wx:if="{{item.isTeaOrder}}" class="tea-order-items">
        <view wx:for="{{item.items}}" wx:key="name" class="tea-order-item">
          <text class="toi-name">{{item.name}} x{{item.qty ? item.qty : 1}}</text>
          <text class="toi-price">¥{{item.price ? item.price : 0}}</text>
        </view>
      </view>
      <!-- 物流 -->
      <view class="logistics-card" wx:if="{{item.logistics}}">
        <view class="logistics-header">
          <text class="logistics-carrier">{{item.logistics.icon}} {{item.logistics.carrier}}</text>
          <view class="logistics-btn" bindtap="showLogistics" data-id="{{item.orderId}}">详情</view>
        </view>
        <text class="logistics-tracking">运单号：<text class="tracking-num" bindtap="copyTracking" data-code="{{item.logistics.trackingNum}}">{{item.logistics.trackingNum}}</text></text>
        <view class="logistics-status-row">
          <text class="ls-badge {{item.logistics.statusBadge}}">{{item.logistics.statusLabel}}</text>
          <view class="ls-progress">
            <view class="ls-step" wx:for="{{item.logistics.steps}}" wx:key="index">
              <view class="ls-line {{item.active?'active':''}}"></view>
              <view class="ls-step-dot {{item.active?'active':''}} {{item.current?'current':''}}"></view>
              <text class="ls-step-label {{item.active?'active':''}} {{item.current?'current':''}}">{{item.label}}</text>
            </view>
          </view>
          <text class="ls-estimated">{{item.logistics.estimated}}</text>
        </view>
      </view>
      <view class="big-actions">
        <view class="big-action-btn outline" bindtap="reBook" data-id="{{item.orderId}}">{{item.isTeaOrder ? '再次购买' : '再次预约'}}</view>
        <view class="big-action-btn ghost" bindtap="goRoomDetail" data-id="{{item.orderId}}">查看详情</view>
      </view>
    </view>

    <!-- 已失效 -->
    <view class="order-card expired" wx:for="{{filteredOrders}}" wx:key="orderId" wx:if="{{item.status=='Expired'}}">
      <view class="order-header">
        <text class="order-room">{{item.roomName}}</text>
        <view class="order-header-right">
          <text class="order-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
      </view>
      <text class="order-time">{{item.timeStr}}</text>
      <text class="order-price">¥{{item.amount}}</text>
      <view class="expired-notice">⏰ 已超过使用时间，预约自动失效</view>
      <view class="big-actions">
        <view class="big-action-btn outline" bindtap="reBook" data-id="{{item.orderId}}">再次预约</view>
        <view class="big-action-btn ghost" bindtap="goRoomDetail" data-id="{{item.orderId}}">查看详情</view>
      </view>
    </view>

    <view class="empty" wx:if="{{filteredOrders.length==0}}">
      <text class="empty-icon">📋</text>
      <text>暂无订单</text>
    </view>
  </view>

  <!-- 物流详情弹窗 -->
  <view class="lg-modal-overlay" wx:if="{{showLogisticsModal}}" bindtap="hideLogistics">
    <view class="lg-modal" catchtap>
      <view class="lg-modal-header">
        <text class="lg-title">物流详情</text>
        <text class="lg-modal-close" bindtap="hideLogistics">✕</text>
      </view>
      <view class="lg-track-info">
        <text class="lg-carrier">{{logisticsData.carrier}}</text>
        <text>运单号：{{logisticsData.trackingNum}}</text>
      </view>
      <view class="lg-timeline">
        <view class="lg-tl-item" wx:for="{{logisticsData.timeline}}" wx:key="index">
          <view class="lg-tl-line {{item.status=='done'||item.status=='current'?'done':''}}"></view>
          <view class="lg-tl-dot {{item.status}}"></view>
          <view class="lg-tl-content">
            <text class="lg-tl-title">{{item.title}}</text>
            <text class="lg-tl-time">{{item.time}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 取消确认弹窗 -->
  <view class="modal-overlay" wx:if="{{showCancelModal}}" bindtap="hideCancelModal">
    <view class="modal" catchtap>
      <text class="modal-title">取消预约</text>
      <text class="modal-desc">{{cancelMsg}}</text>
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideCancelModal">再想想</view>
        <view class="modal-btn danger" bindtap="confirmCancel">确认取消</view>
      </view>
    </view>
  </view>

  <!-- 续订弹窗 -->
  <view class="modal-overlay" wx:if="{{showExtendModal}}" bindtap="hideExtendModal">
    <view class="modal modal-extend" catchtap>
      <text class="modal-title">续订包间</text>
      <text class="modal-desc">{{extendInfo}}</text>
      <view class="extend-grid">
        <view class="extend-option {{selectedExtendIdx==index?'selected':''}}" wx:for="{{extendOptions}}" wx:key="idx" bindtap="selectExtend" data-idx="{{item.idx}}">
          <text class="ext-time">{{item.label}}</text>
          <text class="ext-price">+{{item.minutes}}分 ¥{{item.price}}</text>
        </view>
      </view>
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideExtendModal">取消</view>
        <view class="modal-btn confirm {{selectedExtendIdx<0?'disabled':''}}" bindtap="confirmExtend">确认续订</view>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  <!-- 订单详情弹窗 -->
  <view class="modal-overlay" wx:if="{{showDetailModal}}" bindtap="hideDetailModal">
    <view class="modal detail-modal" catchtap>
      <text class="modal-title">📋 订单详情</text>
      <view class="detail-info" wx:if="{{detailOrder}}">
        <view class="detail-row"><text class="dl">订单编号</text><text class="dv">{{detailOrder.orderId}}</text></view>
        <view class="detail-row"><text class="dl">状态</text><text class="dv">{{detailOrder.statusLabel}}</text></view>
        <view class="detail-row"><text class="dl">时间</text><text class="dv">{{detailOrder.timeStr}}</text></view>
        <view class="detail-row"><text class="dl">金额</text><text class="dv">¥{{detailOrder.amount}}</text></view>
        <view class="detail-row" wx:if="{{detailOrder.payment}}"><text class="dl">支付方式</text><text class="dv">{{detailOrder.payLabel}}</text></view>
        <view class="detail-row" wx:if="{{detailOrder.deliveryMethod}}"><text class="dl">配送方式</text><text class="dv">{{detailOrder.deliveryLabel}}</text></view>
        <view wx:if="{{detailOrder.isTeaOrder && detailOrder.items.length>0}}" class="detail-items">
          <text class="detail-items-title">商品明细</text>
          <view class="detail-item" wx:for="{{detailOrder.items}}" wx:key="name">
            <text class="di-name">{{item.name}}</text>
            <text class="di-qty">×{{item.qty || 1}}</text>
            <text class="di-price">¥{{item.price || 0}}</text>
          </view>
        </view>
      </view>
      <view class="modal-buttons">
        <view class="modal-btn cancel detail-close" bindtap="hideDetailModal">关闭</view>
      </view>
    </view>
  </view>

  <bottom-nav active="orders" />
</view>
