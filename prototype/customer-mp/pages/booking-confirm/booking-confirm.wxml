<view class="page"><view class="confirm-card"><text class="confirm-title">确认预约信息</text><view class="confirm-row"><text class="label">房间</text><text>{{roomName || '大茶室C'}}</text></view><view class="confirm-row"><text class="label">日期</text><text>{{dateStr}}</text></view><view class="confirm-row"><text class="label">时段</text><text>{{startTime}}-{{endTime}}</text></view><view class="confirm-row"><text class="label">时长</text><text>{{duration}}小时</text></view><view class="confirm-row total"><text class="label">费用</text><text class="price">¥{{totalAmount}}</text></view></view><view class="payment-card"><text class="payment-title">支付方式</text><view class="payment-option {{paymentMethod === 'WeChat' ? 'active' : ''}}" bindtap="setPayment" data-method="WeChat">💳 微信支付</view><view class="payment-option {{paymentMethod === 'Balance' ? 'active' : ''}}" bindtap="setPayment" data-method="Balance">💰 余额支付 (¥{{balance}})</view><view class="payment-option {{paymentMethod === 'AliPay' ? 'active' : ''}}" bindtap="setPayment" data-method="AliPay">📱 支付宝</view></view><view class="bottom-bar"><button class="submit-btn" bindtap="submitBooking">确认预约 · ¥{{totalAmount}}</button></view></view>