page { background:#f5f5f5; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; box-sizing:border-box; transform:translateZ(0); display:flex; flex-direction:column; }
.page { flex:1; overflow-y:auto; }
.cart-view { flex:1; overflow-y:auto; display:flex; flex-direction:column; background:linear-gradient(180deg,#fff8f0 0%,#fff 40%); }

/* ── Header ── */
.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; justify-content:center; position:sticky; top:0; z-index:10; }
.header-title { font-size:18px; font-weight:700; color:#1a1a1a; }
.cart-badge { position:absolute; right:16px; display:flex; align-items:center; gap:4px; font-size:20px; }
.badge { background:#B8860B; color:#fff; border-radius:16px; padding:1px 6px; font-size:10px; min-width:16px; text-align:center; }

/* ── Room banner ── */
.room-banner { display:flex; align-items:center; gap:6px; padding:10px 16px; background:#fdf6ec; border-bottom:1px solid #f0e8d8; font-size:13px; }
.room-banner-icon { flex-shrink:0; }
.room-banner-text { flex:1; color:#B8860B; font-weight:500; }
.room-banner-close { color:#ccc; padding:2px 6px; font-size:12px; }

/* ── Category tabs ── */
.cat-tabs { display:flex; padding:12px 16px; gap:8px; background:#fff; border-bottom:1px solid #f5f5f5; white-space:nowrap; }
.cat-tab { padding:7px 18px; border-radius:16px; font-size:13px; background:#f5f5f5; color:#666; border:none; }
.cat-tab.active { background:#B8860B; color:#fff; }

/* ── Product list ── */
.product-list { padding:10px 16px; }
.product-card { display:flex; padding:14px; border-radius:16px; background:#fff; margin-bottom:10px; box-shadow:0 2px 12px rgba(180,120,50,0.06); border:1px solid #f5ede4; }
.product-img-placeholder { width:72px; height:72px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:32px; flex-shrink:0; }
.product-body { flex:1; margin-left:12px; display:flex; flex-direction:column; justify-content:center; }
.product-name { font-size:15px; font-weight:600; color:#4a3a2a; display:block; }
.product-spec { font-size:11px; color:#ccc; margin-top:2px; display:block; }
.product-desc { font-size:12px; color:#c0a890; margin-top:2px; display:block; }
.product-footer { display:flex; justify-content:space-between; align-items:center; margin-top:8px; }
.product-price { font-size:17px; font-weight:700; color:#B8860B; }
.product-price .unit { font-size:11px; font-weight:400; color:#ccc; }

/* ── Quantity control ── */
.qty-ctrl { display:flex; align-items:center; gap:8px; }
.qty-btn { width:26px; height:26px; border-radius:50%; border:1px solid #ddd; background:#fff; font-size:16px; display:flex; align-items:center; justify-content:center; color:#333; font-weight:600; line-height:1; padding:0; }
.qty-btn:active { background:#f5f5f5; }
.qty-num { font-size:14px; font-weight:600; min-width:20px; text-align:center; color:#333; }

/* ── Add button ── */
.add-btn { padding:5px 14px; background:#5D8A6B; color:#fff; border-radius:16px; font-size:12px; border:none; line-height:1.6; }
.add-btn:active { opacity:.85; }

/* ── Cart view — 明亮活力氛围 ── */
.cart-header { display:flex; align-items:center; padding:14px 16px; background:#fff; border-bottom:1px solid #f0e8e0; }
.cart-title { flex:1; font-size:17px; font-weight:700; color:#B8860B; }
.clear-btn { background:none; border:none; font-size:12px; color:#ccc; padding:4px 8px; border-radius:8px; border:1px solid #eee; }
.clear-btn:active { background:#f5f5f5; }
.cart-items { flex:1; padding:12px 16px; }
.cart-item { display:flex; align-items:center; padding:14px 16px; background:#fff; margin-bottom:10px; border-radius:16px; box-shadow:0 2px 12px rgba(180,120,50,0.08); border:1px solid #f5ede4; }
.cart-item-icon { font-size:22px; margin-right:12px; }
.cart-item-name { flex:1; font-size:14px; color:#4a3a2a; font-weight:500; }
.cart-item .qty-ctrl { gap:6px; margin:0 12px; }
.cart-item .qty-btn { width:24px; height:24px; border-radius:50%; border:1px solid #e0d0c0; background:#fff; font-size:14px; color:#B8860B; display:flex; align-items:center; justify-content:center; line-height:1; }
.cart-item .qty-btn:active { background:#fdf6ec; }
.cart-item .qty-num { font-size:14px; font-weight:700; color:#B8860B; min-width:18px; text-align:center; }
.cart-item-price { color:#B8860B; font-weight:700; font-size:15px; min-width:60px; text-align:right; }
.cart-empty { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:60px 20px; gap:8px; }
.empty-emoji { font-size:56px; display:block; }
.empty-title { font-size:16px; color:#c0a080; font-weight:600; display:block; margin-top:4px; }
.empty-hint { font-size:13px; color:#d0c0b0; display:block; }
.empty-browse-btn { margin-top:16px; padding:10px 28px; border-radius:20px; background:linear-gradient(135deg,#B8860B,#d4a84b); color:#fff; font-size:14px; font-weight:600; }
.empty-browse-btn:active { opacity:.85; }
.cart-total { display:flex; align-items:center; gap:8px; padding:14px 16px; background:#fff; border-top:1px solid #f0e8e0; }
.total-label { font-size:13px; color:#999; flex-shrink:0; }
.total-price { font-size:22px; font-weight:700; color:#B8860B; flex:1; }
.checkout-btn { padding:12px 24px; background:linear-gradient(135deg,#B8860B,#d4a84b); color:#fff; border:none; border-radius:14px; font-size:15px; font-weight:700; flex-shrink:0; letter-spacing:1px; }
.checkout-btn:active { opacity:.85; }

/* ── Modal overlay ── */
.pay-modal-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); z-index:99; display:flex; align-items:center; justify-content:center; }
.pay-modal { background:#fff; border-radius:16px; padding:24px; width:84%; max-height:80vh; overflow-y:auto; }

/* ── Detail modal ── */
.detail-img-area { width:100%; height:160px; border-radius:16px; display:flex; align-items:center; justify-content:center; margin-bottom:16px; }
.detail-name { font-size:18px; font-weight:700; color:#1a1a1a; display:block; }
.detail-spec { font-size:12px; color:#bbb; margin-top:4px; display:block; }
.detail-desc { font-size:13px; color:#666; margin-top:8px; display:block; }
.story-section { background:#f9fafb; border-radius:12px; padding:14px; margin-top:12px; }
.story-title { font-size:13px; font-weight:600; color:#333; display:block; margin-bottom:6px; }
.story-text { font-size:12px; color:#666; line-height:1.6; display:block; }
.story-origin { font-size:12px; color:#999; margin-top:6px; display:block; }
.tips-row { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
.tip-tag { font-size:11px; padding:3px 10px; background:#e8f5e9; color:#5D8A6B; border-radius:10px; }
.detail-price-row { display:flex; justify-content:space-between; align-items:center; padding:12px 0 8px; border-bottom:1px solid #f0f0f0; }
.detail-price-label { font-size:14px; color:#666; }
.detail-price { font-size:20px; font-weight:700; color:#5D8A6B; }
.detail-qty-row { display:flex; justify-content:space-between; align-items:center; padding:12px 0; }
.detail-qty-label { font-size:14px; color:#666; }

/* ── Modal buttons ── */
.pay-modal-btns { display:flex; gap:12px; margin-top:16px; }
.pay-btn-cancel { flex:1; padding:12px; background:#f5f5f5; color:#666; border:none; border-radius:16px; font-size:14px; font-weight:500; text-align:center; }
.pay-btn-cancel:active { background:#eee; }
.pay-btn-confirm { flex:1; padding:12px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border:none; border-radius:16px; font-size:14px; font-weight:600; text-align:center; }
.pay-btn-confirm:active { opacity:.85; }

/* ── Insufficient balance ── */
.modal-h3 { font-size:17px; font-weight:700; text-align:center; display:block; margin-bottom:12px; }
.insufficient-msg { font-size:13px; color:#666; line-height:1.6; display:block; padding:8px 0; }

/* ── Payment modal ── */
.pay-items { margin:12px 0; }
.pay-item-row { display:flex; justify-content:space-between; padding:6px 0; font-size:13px; color:#666; }
.pay-total { display:block; text-align:right; font-size:24px; font-weight:700; color:#5D8A6B; padding:8px 0 16px; border-bottom:1px solid #f0f0f0; }
.pay-methods { display:flex; flex-direction:column; gap:8px; padding:12px 0; }
.pay-method { display:flex; align-items:center; gap:8px; padding:12px; border:1.5px solid #eee; border-radius:16px; }
.pay-method.selected { border-color:#5D8A6B; background:#f0fdf4; }
.pay-method-icon { font-size:20px; }
.pay-method-name { flex:1; font-size:14px; color:#333; font-weight:500; }
.pay-method-check { color:#5D8A6B; font-size:16px; font-weight:700; }
