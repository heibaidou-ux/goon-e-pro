.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; position:sticky; top:0; z-index:10; display:flex; align-items:center; justify-content:center; }.header-title { font-size:18px; font-weight:700; color:#1a1a1a; }.cart-badge { position:absolute; right:16px; top:14px; font-size:20px; }.badge { position:absolute; top:-6px; right:-6px; background:#B8860B; color:#fff; border-radius:10px; padding:1px 6px; font-size:10px; min-width:18px; text-align:center; }.cat-tabs { display:flex; padding:12px 16px; gap:8px; background:#fff; border-bottom:1px solid #f5f5f5; white-space:nowrap; }.cat-tab { display:inline-block; padding:7px 18px; border-radius:18px; font-size:13px; background:#f5f5f5; color:#666; margin-right:8px; }.cat-tab.active { background:#5D8A6B; color:#fff; }.product-list { padding:10px 16px; }.product-card { display:flex; padding:12px; border-radius:12px; background:#fafafa; margin-bottom:10px; }.product-img { width:52px; height:52px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:28px; flex-shrink:0; background:#f0f0f0; }.product-body { flex:1; margin-left:12px; }.product-name { font-size:14px; font-weight:600; color:#333; display:block; }.product-desc { font-size:11px; color:#999; margin-top:2px; display:block; }.product-footer { display:flex; justify-content:space-between; align-items:center; margin-top:6px; }.product-price { font-size:16px; font-weight:700; color:#B8860B; }.product-price .unit { font-size:11px; font-weight:400; color:#999; }.qty-ctrl { display:flex; align-items:center; gap:8px; }.qty-btn { width:26px; height:26px; border-radius:50%; border:1px solid #ddd; background:#fff; font-size:16px; display:flex; align-items:center; justify-content:center; color:#333; font-weight:600; }.qty-btn.disabled { opacity:.3; }.qty-num { font-size:14px; font-weight:600; min-width:20px; text-align:center; color:#333; }.bottom-bar { position:fixed; bottom:0; left:0; right:0; background:#fff; border-top:1px solid #f0f0f0; padding:10px 16px; display:flex; align-items:center; gap:12px; z-index:20; }.bottom-info { flex:1; }.bottom-count { font-size:12px; color:#999; display:block; }.bottom-total { font-size:18px; font-weight:700; color:#B8860B; }.bottom-btn { padding:12px 24px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border-radius:10px; font-size:15px; font-weight:600; text-align:center; }