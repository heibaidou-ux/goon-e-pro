page { background:#f5f5f5; margin:0; padding:0; }
.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; justify-content:center; position:sticky; top:0; z-index:10; }
.header-title { font-size:18px; font-weight:700; color:#1a1a1a; }
.header-cart { position:absolute; right:16px; font-size:13px; color:#0052D9; display:flex; align-items:center; gap:4px; }
.cart-badge { background:#B8860B; color:#fff; border-radius:16px; padding:1px 6px; font-size:10px; min-width:16px; text-align:center; }
.cat-tabs { display:flex; padding:12px 16px; gap:8px; background:#fff; border-bottom:1px solid #f5f5f5; white-space:nowrap; }
.cat-tab { padding:7px 18px; border-radius:18px; font-size:13px; background:#f5f5f5; color:#666; margin-right:8px; }
.cat-tab.active { background:#0052D9; color:#fff; }
.product-list { padding:10px 16px; }
.product-card { display:flex; padding:12px; border-radius:16px; background:#fafafa; margin-bottom:10px; }
.product-img { width:52px; height:52px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:28px; flex-shrink:0; background:#f0f0f0; }
.product-body { flex:1; margin-left:12px; }
.product-name { font-size:14px; font-weight:600; color:#333; display:block; }
.product-desc { font-size:11px; color:#999; margin-top:2px; display:block; }
.product-footer { display:flex; justify-content:space-between; align-items:center; margin-top:6px; }
.product-price { font-size:16px; font-weight:700; color:#B8860B; }
.product-price .unit { font-size:11px; font-weight:400; color:#999; }
.qty-ctrl { display:flex; align-items:center; gap:8px; }
.qty-btn { width:26px; height:26px; border-radius:50%; border:1px solid #ddd; background:#fff; font-size:16px; display:flex; align-items:center; justify-content:center; color:#333; font-weight:600; }
.qty-btn.disabled { opacity:.3; }
.qty-num { font-size:14px; font-weight:600; min-width:20px; text-align:center; color:#333; }

/* Cart popup */
.cart-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); z-index:99; }
.cart-sheet { position:fixed; bottom:0; left:0; right:0; background:#fff; border-radius:16px 16px 0 0; max-height:60vh; padding:16px 0; z-index:100; }
.cart-header-text { font-size:16px; font-weight:600; padding:0 16px 12px; border-bottom:1px solid #f0f0f0; display:block; }
.cart-item { display:flex; align-items:center; padding:12px 16px; border-bottom:1px solid #f5f5f5; }
.cart-item-name { flex:1; font-size:14px; }
.cart-item-qty { color:#999; margin-right:12px; font-size:13px; }
.cart-item-price { color:#B8860B; font-weight:600; font-size:13px; }
.cart-empty { text-align:center; padding:40px; color:#ccc; font-size:14px; }
.cart-total { padding:12px 16px; text-align:right; font-size:18px; font-weight:700; border-top:1px solid #f0f0f0; }
.cart-total .total-label { font-size:13px; color:#999; }
.cart-total .total-price { color:#B8860B; }
.cart-checkout { margin:0 16px 16px; padding:14px; background:linear-gradient(135deg,#0052D9,#1a73e8); color:#fff; border:none; border-radius:16px; font-size:16px; font-weight:600; text-align:center; }

/* Bottom bar */
.bottom-bar { position:fixed; bottom:0; left:0; right:0; background:#fff; border-top:1px solid #f0f0f0; padding:10px 16px; display:flex; align-items:center; gap:12px; z-index:20; }
.bar-info { flex:1; }
.bar-count { font-size:12px; color:#999; display:block; }
.bar-total { font-size:18px; font-weight:700; color:#B8860B; }
.bar-btn { padding:12px 24px; background:linear-gradient(135deg,#0052D9,#1a73e8); color:#fff; border:none; border-radius:16px; font-size:15px; font-weight:600; text-align:center; }


