<view class="page"><view class="header"><view class="header-title">🌿 茶品雅集</view><view class="cart-badge" bindtap="goCart">🛒<view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view></view></view><scroll-view class="cat-tabs" scroll-x enhanced show-scrollbar="{{false}}"><view class="cat-tab {{currentCat == '' ? 'active' : ''}}" bindtap="switchCat" data-cat="">全部</view><view class="cat-tab {{currentCat == 'Tea' ? 'active' : ''}}" bindtap="switchCat" data-cat="Tea">🍵 茶叶</view><view class="cat-tab {{currentCat == 'Snack' ? 'active' : ''}}" bindtap="switchCat" data-cat="Snack">🍪 茶点</view><view class="cat-tab {{currentCat == 'Ware' ? 'active' : ''}}" bindtap="switchCat" data-cat="Ware">🏺 茶具</view></scroll-view><view class="product-list"><view class="product-card" wx:for="{{filteredProducts}}" wx:key="productId"><view class="product-img">{{item.image || '📦'}}</view><view class="product-body"><text class="product-name">{{item.name}}</text><text class="product-desc">{{item.desc}}</text><view class="product-footer"><text class="product-price">¥{{item.price}} <text class="unit">/份</text></text><view class="qty-ctrl"><view class="qty-btn {{item._qty > 0 ? '' : 'disabled'}}" bindtap="decQty" data-id="{{item.productId}}">−</view><text class="qty-num">{{item._qty || 0}}</text><view class="qty-btn" bindtap="incQty" data-id="{{item.productId}}">+</view></view></view></view></view></view><view class="bottom-bar" wx:if="{{cartCount > 0}}"><view class="bottom-info"><text class="bottom-count">已选 {{cartCount}} 件</text><text class="bottom-total">¥{{cartTotal}}</text></view><view class="bottom-btn" bindtap="checkout">去结算</view></view></view>