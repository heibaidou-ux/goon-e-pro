.page{padding:40px 24px;text-align:center}.loading-spinner{width:40px;height:40px;border:3px solid #e8e8e8;border-top-color:#5D8A6B;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 16px}@keyframes spin{to{transform:rotate(360deg)}}.icon{font-size:48px;margin-bottom:16px}.name{font-size:22px;font-weight:700;display:block;margin-bottom:24px}.btns{display:flex;flex-direction:column;gap:12px}button{width:100%;padding:14px;background:#5D8A6B;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600}button.outline{background:#fff;color:#5D8A6B;border:1.5px solid #5D8A6B}.error .icon{color:#e53935}.error text{display:block;margin-bottom:16px;color:#666}