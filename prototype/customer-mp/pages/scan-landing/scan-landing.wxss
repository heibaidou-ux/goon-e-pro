.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#FAF8F5; }
.page { flex:1; overflow-y:auto; display:flex; flex-direction:column; align-items:center; padding:40px 20px; }

/* Loading */
.loading-state { text-align:center; }
.loading-spinner { width:40px; height:40px; border:3px solid #e8e8e8; border-top-color:#5D8A6B; border-radius:50%; animation:spin .8s linear infinite; margin:0 auto 16px; }
@keyframes spin { to { transform:rotate(360deg); } }

/* Success */
.success-state { width:100%; max-width:360px; text-align:center; }
.verify-icon { width:72px; height:72px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:36px; box-shadow:0 4px 16px rgba(93,138,107,.3); }
.room-name-text { font-size:24px; font-weight:700; color:#1a1a1a; margin-bottom:24px; display:block; }

.bill-preview { background:#f9fafb; border-radius:16px; padding:16px; margin-bottom:24px; text-align:left; }
.bill-title { font-size:12px; color:#999; margin-bottom:8px; display:block; }
.bill-row { display:flex; justify-content:space-between; padding:6px 0; font-size:14px; color:#333; }
.bill-row .label { color:#666; }
.bill-row .value { color:#B8860B; }

.action-btns { width:100%; display:flex; flex-direction:column; gap:12px; margin-top:8px; }
.btn-primary { width:100%; padding:16px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border:none; border-radius:16px; font-size:16px; font-weight:600; text-align:center; }
.btn-primary:active { opacity:.85; }
.btn-outline { width:100%; padding:14px; background:#fff; color:#5D8A6B; border:1.5px solid #5D8A6B; border-radius:16px; font-size:14px; font-weight:500; text-align:center; }
.btn-outline:active { background:#f0fdf4; }
.btn-link { background:none; border:none; color:#999; font-size:13px; padding:8px; }
.btn-link:active { color:#666; }

/* Error */
.error-state { width:100%; max-width:360px; text-align:center; }
.error-icon { width:72px; height:72px; background:#fce4e4; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:36px; color:#e53935; }
.error-title { font-size:18px; font-weight:600; color:#333; margin-bottom:8px; display:block; }
.error-msg { font-size:14px; color:#999; margin-bottom:24px; line-height:1.6; display:block; }
