<view class="phone">
  <view class="page">
    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>验证中...</text>
    </view>
    <view class="success-state" wx:elif="{{verified}}">
      <view class="verify-icon">✅</view>
      <text class="room-name-text">🏠 {{roomName}}</text>
      <view class="bill-preview" wx:if="{{billSummary.roomCharge > 0 || billSummary.scanTotal > 0}}">
        <text class="bill-title">📋 当前账单</text>
        <view class="bill-row"><text class="label">房费</text><text class="value">¥{{billSummary.roomCharge}}</text></view>
        <view class="bill-row"><text class="label">加购挂账</text><text class="value">¥{{billSummary.scanTotal}}</text></view>
      </view>
      <view class="action-btns">
        <button class="btn-primary" bindtap="goOrder">🛒 点单加购</button>
        <button class="btn-outline" bindtap="goBill">📋 查看房间账单</button>
        <button class="btn-link" bindtap="callStaff">📞 联系店员</button>
      </view>
    </view>
    <view class="error-state" wx:else>
      <view class="error-icon">⚠️</view>
      <text class="error-title">{{errorTitle}}</text>
      <text class="error-msg">{{errorMsg}}</text>
      <button class="btn-outline" bindtap="callStaff">📞 联系店员</button>
    </view>
  </view>
</view>
