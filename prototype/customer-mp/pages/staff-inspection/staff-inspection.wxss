.page{background:#f5f7fa;min-height:100vh;padding-bottom:60px}.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0;display:flex;justify-content:space-between;align-items:center}.header-title{font-size:18px;font-weight:700}.header-tabs{display:flex;gap:4px;background:#f5f5f5;border-radius:8px;padding:2px}.htab{padding:6px 14px;border-radius:6px;font-size:12px;color:#666}.htab.active{background:#fff;color:#5D8A6B;font-weight:600}.content{padding:0 16px}.section-title{font-size:13px;font-weight:600;color:#333;margin:12px 0 8px;display:block}.room-tabs{display:flex;gap:8px;flex-wrap:wrap}.room-tab{flex:1;min-width:80px;padding:14px 8px;border-radius:12px;text-align:center;border:1.5px solid #e5e5e5;background:#fff}.room-tab:active{border-color:#5D8A6B}.rt-name{font-size:13px;font-weight:600;display:block}.rt-status{font-size:10px;color:#999;display:block;margin-top:2px}.inspect-list{background:#fff;border-radius:12px;overflow:hidden}.inspect-item{display:flex;justify-content:space-between;padding:14px 16px;border-bottom:1px solid #f5f5f5;font-size:14px;font-weight:500}.inspect-item:last-child{border-bottom:none}.inspect-item:active{background:#f9fafb}.inspect-item.fail{color:#d54941}.ii-result{font-size:12px}.inspect-actions{display:flex;gap:8px;margin-top:16px}.ia-btn{flex:1;padding:12px;border-radius:12px;font-size:13px;font-weight:600;text-align:center}.ia-btn.primary{background:#5D8A6B;color:#fff;border:none}.ia-btn.outline{background:#fff;color:#666;border:1.5px solid #ddd}.report-card{background:#fff;border-radius:14px;padding:14px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.04)}.rc-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.rc-room{font-size:14px;font-weight:600}.rc-status{font-size:10px;padding:2px 8px;border-radius:6px}.rc-status.pending{background:#fff3e0;color:#B8860B}.rc-status.done{background:#e8f5e9;color:#00a870}.rc-time{font-size:11px;color:#999;display:block}.rc-inspector{font-size:11px;color:#666;display:block;margin-top:2px}.rc-items{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px}.ri-tag{font-size:10px;padding:2px 8px;border-radius:4px}.ri-tag.ok{background:#e8f5e9;color:#00a870}.ri-tag.no{background:#fce4e4;color:#e53935}.rc-btn{display:inline-block;padding:6px 16px;border-radius:8px;background:#5D8A6B;color:#fff;font-size:12px;font-weight:600;margin-top:8px}.empty{text-align:center;padding:40px 0;color:#999;font-size:13px}
