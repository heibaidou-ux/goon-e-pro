.page { min-height:100vh; background:#f5f5f5; }
.header { display:flex; align-items:center; padding:14px 0; background:#fff; border-bottom:1px solid #f0f0f0; }
.back-btn { font-size:20px; padding:4px 0 4px 4px; margin-right:8px; }
.header-title { font-size:18px; font-weight:700; }
.content { padding:0 0 60px; }
.section-title { font-size:13px; font-weight:600; color:#333; margin:16px 0 8px; display:block; }
.room-tabs { display:flex; gap:6px; overflow-x:auto; padding:0 0 8px; }
.room-tab { flex-shrink:0; padding:10px 16px; border-radius:12px; background:#fff; border:1.5px solid #e0d8d0; text-align:center; min-width:80px; }
.room-tab.active { border-color:#5D8A6B; background:#F2F6F0; }
.rt-name { font-size:13px; font-weight:600; display:block; }
.rt-status { font-size:10px; color:#999; display:block; margin-top:2px; }
.rt-status.ok { color:#5D8A6B; }
.inspect-list { background:#fff; border-radius:12px; overflow:hidden; }
.inspect-item { display:flex; align-items:center; justify-content:space-between; padding:14px; border-bottom:1px solid #f5f5f5; }
.inspect-item:last-child { border-bottom:none; }
.ii-name { font-size:14px; font-weight:500; display:block; }
.ii-desc { font-size:11px; color:#999; margin-top:2px; display:block; }
.ii-desc.warn { color:#e53935; }
.ii-status { padding:6px 12px; border-radius:8px; }
.ii-status.ok { background:#F2F6F0; }
.ii-status.fail { background:#FDF6EC; }
.inspect-actions { margin-top:16px; }
.inspect-submit-btn { width:100%; padding:14px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:15px; font-weight:600; text-align:center; }