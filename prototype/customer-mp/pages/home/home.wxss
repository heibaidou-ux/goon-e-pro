page { background:#f5f5f5; margin:0; padding:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.phone { width:100%; min-height:100vh; background:#fff; display:flex; flex-direction:column; }
.header { padding:10px 0; text-align:center; background:#fff; }
.header-logo { font-size:22px; font-weight:700; color:#5D8A6B; letter-spacing:1px; }
.store-info-bar { padding:0; background:#fff; }
.info-row { display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:12px; color:#666; border-bottom:1px solid #f0f0f0; padding:8px 0; }
.info-link { color:#5D8A6B; font-weight:600; }
.active-order-banner { display:none; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; }
.active-order-banner.show { display:block; }
.active-order-info { display:flex; justify-content:space-between; align-items:center; padding:12px 0; flex-wrap:wrap; gap:6px; }
.active-order-room { font-size:15px; font-weight:600; }
.active-order-time { font-size:11px; opacity:.85; }
.active-order-btns { display:flex; gap:8px; margin-top:4px; }
.active-order-btn { flex:1; display:flex; align-items:center; justify-content:center; gap:4px; padding:8px; border-radius:16px; font-size:13px; font-weight:600; cursor:pointer; }
.active-order-btn.outline { background:rgba(255,255,255,.2); color:#fff; border:1px solid rgba(255,255,255,.3); }
.active-order-btn .btn-icon { font-size:16px; }
.active-order-btn .btn-label { font-size:13px; }

/* 快捷入口 — 四宫格 */
.quick-grid { display:grid; grid-template-columns:repeat(4,1fr); padding:20px 0; background:#fff; margin-bottom:12px; }
.quick-item { display:flex; flex-direction:column; align-items:center; gap:6px; padding:8px 2px; }
.quick-item:active { opacity:.7; }
.quick-icon { width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:28px; color:#fff; position:relative; box-shadow:0 2px 8px rgba(0,0,0,.1); }
.quick-icon.brand { background:linear-gradient(135deg,#1f5c2e,#5D8A6B); }
.quick-icon.balance { background:linear-gradient(135deg,#4d6666,#7b9a9a); }
.quick-icon.coupon { background:linear-gradient(135deg,#8a6500,#c4941c); }
.quick-icon.profile { background:linear-gradient(135deg,#655a4a,#9b8b7b); }
.quick-label { font-size:13px; color:#333; font-weight:500; }

.section { padding:0 0 12px; margin-bottom:12px; background:#fff; }
.section-title { font-size:15px; font-weight:600; margin-bottom:12px; color:#1a1a1a; padding:16px 16px 0; display:flex; justify-content:space-between; }
.section-more { font-size:12px; color:#5D8A6B; }
.room-scroll { display:flex; padding-left:0; white-space:nowrap; overflow-x:auto; }
.room-card { display:inline-flex; flex-direction:column; width:180px; margin-right:12px; border-radius:16px; background:#fafafa; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,.06); }
.room-card-img { height:100px; display:flex; align-items:center; justify-content:center; font-size:40px; }
.room-card-body { padding:10px 12px; }
.room-card-name { font-size:14px; font-weight:600; color:#333; }
.room-card-tags { margin-top:4px; }
.room-tag { font-size:10px; color:#999; background:#f0f0f0; padding:2px 6px; border-radius:4px; margin-right:4px; }
.room-card-price { font-size:16px; font-weight:700; color:#B8860B; margin-top:6px; }
.room-card-price .unit { font-size:11px; font-weight:400; color:#999; }
.tea-title { padding:16px 16px 0; }
.tea-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:0; }
.tea-card { background:#fff; border:1px solid #f0f0f0; border-radius:12px; overflow:hidden; }
.tea-card:active { background:#fafafa; }
.tea-card-img { height:100px; display:flex; align-items:center; justify-content:center; font-size:40px; }
.tea-card-body { padding:10px; }
.tea-card-name { font-size:13px; font-weight:600; }
.tea-card-meta { font-size:11px; color:#999; margin-top:2px; }
.tea-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:6px; }
.tea-card-price { font-size:15px; font-weight:700; color:#B8860B; }
.tea-card-add { width:26px; height:26px; border-radius:50%; border:none; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; font-size:16px; display:flex; align-items:center; justify-content:center; }
.qty-ctrl { display:flex; align-items:center; gap:4px; }
.qty-btn { width:24px; height:24px; border-radius:50%; border:1.5px solid #5D8A6B; background:#fff; color:#5D8A6B; font-size:16px; display:flex; align-items:center; justify-content:center; padding:0; }
.qty-num { min-width:20px; text-align:center; font-size:14px; font-weight:600; }

/* Login modal */
.login-fullscreen { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.login-bg { background:linear-gradient(135deg,#1a3a1a,#2d5a2d);color:#fff;padding:32px 24px;border-radius:24px;width:340px; }
.login-card { background:#fff;color:#333;border-radius:16px;padding:24px; }
.login-card-title { font-size:20px;font-weight:700;text-align:center;display:block; }
.login-card-sub { font-size:12px;color:#999;text-align:center;margin-top:4px;display:block; }
.login-tabs { display:flex;margin:16px 0;border-bottom:1px solid #f0f0f0; }
.login-tab { flex:1;text-align:center;padding:10px;font-size:14px;color:#999; }
.login-tab.active { color:#5D8A6B;font-weight:600;border-bottom:2px solid #5D8A6B; }
.login-field { padding:12px;border:1.5px solid #e0d8d0;border-radius:12px;font-size:14px;margin-bottom:10px;width:100%;box-sizing:border-box; }
.login-code-row { display:flex;gap:8px; }
.login-code-field { flex:1;padding:12px;border:1.5px solid #e0d8d0;border-radius:12px;font-size:14px; }
.get-code-btn { padding:12px 16px;border-radius:12px;border:none;background:#5D8A6B;color:#fff;font-size:13px;white-space:nowrap; }
.login-submit { width:100%;padding:14px;border-radius:16px;border:none;background:linear-gradient(135deg,#5D8A6B,#7BA88E);color:#fff;font-size:16px;font-weight:600;margin-top:4px; }

/* Modal overlay */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:16px;padding:20px;width:300px;max-width:90vw;box-shadow:0 4px 20px rgba(0,0,0,.15); }
.store-content { display:grid;grid-template-columns:1fr 1fr;gap:8px; }
.store-option { display:flex;align-items:center;justify-content:space-between;padding:14px;border-radius:12px;background:#f9f9f9;font-size:14px;font-weight:500; }
.store-option.coming { opacity:.6; }
.store-coming-tag { font-size:10px;color:#999;background:#f0f0f0;border-radius:4px;padding:2px 6px; }
