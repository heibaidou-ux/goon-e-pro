/* 高岸茶室 · 首页 — 温润茶绿质感 */
page { background:#FAF8F5; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif; }
.phone { display:flex; flex-direction:column; height:100vh; overflow:hidden; }
.page {min-height:0; flex:1; overflow-x:hidden; }

/* ── 门店头部 ── */
.store-header { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; background:#fff; border-bottom:1px solid #f0ece6; }
.store-name { font-size:22px; font-weight:700; color:#5D8A6B; letter-spacing:1px; }
.store-select { font-size:12px; color:#666; padding:6px 12px; border-radius:20px; background:#f5f5f5; font-weight:500; }

/* ── 轮播 ── */
.carousel-wrap { width:100%; height:200px; overflow:hidden; position:relative; }
.carousel-swiper { width:100%; height:200px; }
.carousel-slide { width:100%; height:200px; position:relative; }
.carousel-img { width:100%; height:200px; display:block; }
.slide-text { position:absolute; bottom:0; left:0; right:0; padding:40px 16px 16px; background:linear-gradient(transparent,rgba(0,0,0,.55)); }
.slide-title { font-size:18px; font-weight:700; color:#fff; display:block; letter-spacing:0.5px; }
.slide-desc { font-size:12px; color:rgba(255,255,255,.85); margin-top:2px; display:block; }
.carousel-dots { position:absolute; bottom:8px; right:12px; display:flex; gap:4px; z-index:2; }
.carousel-dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,.4); transition:all .3s; }
.carousel-dot.active { width:20px; border-radius:3px; background:#fff; }

/* ── 门店信息栏 ── */
.store-info-bar { padding:0 16px; background:#fff; border-bottom:1px solid #f0ece6; }
.info-row { display:flex; align-items:center; font-size:12px; color:#666; padding:8px 0; }
.info-row:first-child { border-bottom:1px solid #f0ece6; }
.info-addr { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px; color:#888; }
.info-link { color:#5D8A6B; font-weight:600; flex-shrink:0; }
.info-cell { flex:1; }
.info-phone { font-weight:500; }
.info-center { text-align:center; }
.info-right { text-align:right; color:#999; }

/* ── 当前消费横幅 ── */
.active-order-banner { display:none; padding:0 16px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border-radius:0; }
.active-order-banner.show { display:block; }
.active-order-header { display:flex; justify-content:space-between; align-items:center; padding:14px 0 4px; }
.active-order-title { font-size:12px; opacity:.85; }
.active-order-room-row { display:flex; align-items:center; gap:4px; }
.active-order-room { font-size:17px; font-weight:700; }
.active-order-arrow { font-size:18px; opacity:.7; }
.active-order-time { font-size:11px; opacity:.75; display:block; }
.active-order-btns { display:flex; gap:8px; padding:10px 0 14px; }
.active-order-btn { flex:1; display:flex; align-items:center; justify-content:center; gap:4px; padding:10px; border-radius:14px; font-size:13px; font-weight:600; transition:all .15s; }
.active-order-btn.outline { background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.25); }
.active-order-btn:active { background:rgba(255,255,255,.3); }

/* ── 快捷入口 四宫格 ── */
.quick-grid { display:grid; grid-template-columns:repeat(4,1fr); padding:20px 16px; background:#fff; margin-bottom:8px; }
.quick-item { display:flex; flex-direction:column; align-items:center; gap:8px; padding:4px 2px; transition:all .15s; }
.quick-item:active { transform:scale(.92); }
.quick-icon { width:52px; height:52px; border-radius:18px; display:flex; align-items:center; justify-content:center; font-size:32px; color:#fff; box-shadow:0 4px 12px rgba(0,0,0,.1); transition:all .2s; }
.quick-icon.brand { background:linear-gradient(135deg,#1f5c2e,#5D8A6B); }
.quick-icon.balance { background:linear-gradient(135deg,#4d6666,#7b9a9a); flex-direction:column; font-size:12px; gap:0; }
.balance-icon { font-size:18px; display:block; }
.balance-amt { font-size:10px; font-weight:600; display:block; }
.quick-icon.coupon { background:linear-gradient(135deg,#8a6500,#c4941c); }
.quick-icon.profile { background:linear-gradient(135deg,#655a4a,#9b8b7b); }
.quick-label { font-size:13px; color:#333; font-weight:500; }

/* ── 精选包间 ── */
.section { padding:0 0 8px; margin-bottom:8px; background:#fff; }
.section-title { font-size:16px; font-weight:600; color:#1a1a1a; padding:16px 16px 12px; display:flex; justify-content:space-between; align-items:center; }
.section-more { font-size:12px; color:#5D8A6B; font-weight:500; }
.room-scroll { white-space:nowrap; overflow-x:auto; padding:0 16px 4px; -webkit-overflow-scrolling:touch; }
.room-scroll::-webkit-scrollbar { display:none; }
.room-card { display:inline-block; width:170px; margin-right:10px; border-radius:16px; background:#fff; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,.06); transition:all .2s; }
.room-card:active { transform:scale(.96); }
.room-card-img { height:100px; display:flex; align-items:center; justify-content:center; font-size:40px; }
.room-card-body { padding:10px 12px 12px; }
.room-card-name { font-size:14px; font-weight:600; color:#333; }
.room-card-tags { margin-top:4px; }
.room-tag { font-size:10px; color:#888; background:#f5f5f5; padding:2px 8px; border-radius:4px; margin-right:4px; }
.room-card-price { font-size:16px; font-weight:700; color:#B8860B; margin-top:6px; display:flex; align-items:baseline; gap:2px; }
.room-card-price .unit { font-size:11px; font-weight:400; color:#999; }

/* ── 精选茶品 ── */
.tea-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:0 16px 16px; }
.tea-card { background:#fff; border:1px solid #f0ece6; border-radius:14px; overflow:hidden; transition:all .15s; }
.tea-card:active { transform:scale(.97); border-color:#5D8A6B; }
.tea-card-img { height:100px; display:flex; align-items:center; justify-content:center; font-size:40px; }
.tea-card-body { padding:10px 12px; display:flex; flex-direction:column; flex:1; }
.tea-card-name { font-size:13px; font-weight:600; }
.tea-card-desc { font-size:11px; color:#999; margin-top:2px; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.tea-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:8px; }
.tea-card-price { font-size:15px; font-weight:700; color:#B8860B; }
.qty-ctrl { display:flex; align-items:center; gap:4px; }
.qty-btn-sm { width:24px; height:24px; border-radius:50%; border:1.5px solid #5D8A6B; background:#fff; color:#5D8A6B; font-size:16px; display:flex; align-items:center; justify-content:center; }
.qty-num-sm { min-width:20px; text-align:center; font-size:14px; font-weight:600; color:#333; }
.tea-card-btn { width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; font-size:9px; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(93,138,107,.3); padding:0; font-weight:400; }
.tea-card-btn:active { transform:scale(.9); }
.cart-link { font-size:12px; color:#5D8A6B; display:flex; align-items:center; gap:4px; }
.cart-badge { display:inline-block; background:#D54941; color:#fff; border-radius:10px; padding:1px 6px; font-size:10px; min-width:16px; text-align:center; }

/* ── 详情弹窗 ── */
.pay-modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s; }
.pay-modal { background:#fff;border-radius:20px;padding:24px;width:300px;max-width:85vw;text-align:center;animation:scaleIn .25s; }
@keyframes scaleIn { from{opacity:0;transform:scale(.9)} to{opacity:1;transform:scale(1)} }
.detail-img-area { width:100%;height:160px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:56px;margin-bottom:12px; }
.detail-name { font-size:18px;font-weight:700;display:block;text-align:center; }
.detail-desc { font-size:13px;color:#666;margin-top:4px;display:block;text-align:center; }
.detail-price-row { display:flex;justify-content:space-between;padding:12px 0;border-top:1px solid #f0ece6;margin-top:12px; }
.detail-price-label { font-size:14px;color:#666; }
.detail-price { font-size:22px;font-weight:700;color:#B8860B; }
.pay-modal-btns { display:flex;gap:10px;margin-top:16px; }
.pay-btn-cancel { flex:1;padding:12px;border-radius:12px;border:1.5px solid #e0d8d0;background:#fff;font-size:14px;font-weight:600;color:#666; }
.pay-btn-confirm { flex:1;padding:12px;border-radius:12px;border:none;background:linear-gradient(135deg,#5D8A6B,#7BA88E);color:#fff;font-size:14px;font-weight:600;box-shadow:0 4px 12px rgba(93,138,107,.3); }

/* ── 登录弹窗 ── */
.login-fullscreen { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s; }
.login-bg { background:linear-gradient(135deg,#1a3a1a,#2d5a2d);color:#fff;padding:32px 24px;border-radius:24px;width:340px;box-shadow:0 16px 48px rgba(0,0,0,.3); }
.login-card { background:#fff;color:#333;border-radius:16px;padding:24px;animation:scaleIn .25s; }
.login-card-title { font-size:20px;font-weight:700;text-align:center;display:block; }
.login-card-sub { font-size:12px;color:#999;text-align:center;margin-top:4px;display:block; }
.login-tabs { display:flex;margin:16px 0;border-bottom:1px solid #f0ece6; }
.login-tab { flex:1;text-align:center;padding:12px;font-size:14px;color:#999;transition:all .2s; }
.login-tab.active { color:#5D8A6B;font-weight:600;border-bottom:2px solid #5D8A6B; }
.login-type-tabs { display:flex;margin:0 0 16px;background:#f5f5f5;border-radius:10px;overflow:hidden; }
.login-type-tab { flex:1;text-align:center;padding:10px;font-size:13px;color:#999;transition:all .15s; }
.login-type-tab.active { background:#5D8A6B;color:#fff;font-weight:600; }
.form-item { margin-bottom:12px; }
.form-label { font-size:12px;color:#666;margin-bottom:6px;display:block;font-weight:500; }
.form-input { width:100%;height:48px;line-height:44px;padding:0 16px;border:1.5px solid #e0d8d0;border-radius:12px;font-size:14px;box-sizing:border-box;transition:border-color .2s; }
.form-input:focus { border-color:#5D8A6B; }
.code-row { display:flex;gap:8px; }
.code-btn { padding:12px 16px;border-radius:12px;border:none;background:#5D8A6B;color:#fff;font-size:13px;font-weight:600;white-space:nowrap; }
.code-btn:active { opacity:.8; }
.form-btn { width:100%;padding:14px;border-radius:14px;border:none;background:linear-gradient(135deg,#5D8A6B,#7BA88E);color:#fff;font-size:16px;font-weight:600;text-align:center;transition:all .15s;box-shadow:0 4px 12px rgba(93,138,107,.3); }
.form-btn:active { transform:scale(.97); }
.form-switch { font-size:12px;color:#5D8A6B;text-align:center;display:block;margin-top:12px; }
.login-hint { font-size:11px;color:#ccc;text-align:center;margin-top:12px;display:block; }
.form-hint { font-size:11px;color:#999;text-align:center;display:block;margin-top:8px; }
.staff-login-link { margin-top:8px !important; font-size:12px !important; }

/* ── 手机号登录次级入口 ── */
.phone-login-trigger { text-align:center; margin-top:14px; padding:8px 0; font-size:13px; color:#999; }
.phone-login-trigger:active { color:#5D8A6B; }
.back-to-wechat { font-size:12px; color:#999; margin-top:16px !important; }
.back-to-wechat:active { color:#5D8A6B; }

/* ── 微信一键登录按钮 ── */
.wechat-login-btn { display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:14px;border-radius:14px;border:1.5px solid #07C160;background:#fff;color:#333;font-size:15px;font-weight:600;margin:16px 0 0;text-align:center;transition:all .15s; }
.wechat-login-btn::after { border:none; }
.wechat-login-btn:active { transform:scale(.97);background:#f0fdf4; }
.wechat-btn-icon { width:22px;height:22px;flex-shrink:0; }
.divider-text { display:flex;align-items:center;margin:16px 0 4px;color:#ccc;font-size:12px;gap:12px; }
.divider-text::before,
.divider-text::after { content:'';flex:1;height:1px;background:#f0ece6; }

/* ── 弹窗(门店选择) ── */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s; }
.modal { background:#fff;border-radius:20px;padding:24px;width:300px;max-width:90vw;animation:scaleIn .25s; }
.modal-title { font-size:16px;font-weight:600;display:block;margin-bottom:12px;text-align:center; }
.modal-close { margin-top:12px;padding:12px;border-radius:12px;border:none;background:#5D8A6B;color:#fff;font-size:14px;font-weight:600;width:100%;text-align:center; }
.store-option { display:flex;align-items:center;justify-content:space-between;padding:14px 12px;border-radius:12px;background:#f9f9f9;font-size:14px;font-weight:500;margin-bottom:6px;transition:all .15s; }
.store-option:active { background:#f0f0f0; }
.store-option.active { border:1.5px solid #5D8A6B;background:#f0faf2; }

/* ── 加载/错误 ── */
.loading-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(255,255,255,.85);z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;animation:fadeIn .15s; }
.loading-spinner { width:32px;height:32px;border:3px solid #E8F5E9;border-top-color:#5D8A6B;border-radius:50%;animation:spin .8s linear infinite; }
@keyframes spin { to{transform:rotate(360deg)} }
.loading-text { font-size:13px;color:#999;margin-top:12px; }
.error-toast { position:fixed;bottom:80px;left:16px;right:16px;background:#D54941;color:#fff;padding:14px;border-radius:12px;text-align:center;font-size:13px;z-index:100;box-shadow:0 4px 16px rgba(213,73,65,.3); }
