page { background:#f5f5f5; margin:0; padding:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.page { flex:1; overflow-x:hidden; padding-bottom:60px; }

/* 门店头部 */
.store-header { display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:#fff; }
.store-name { font-size:20px; font-weight:700; color:#5D8A6B; }
.store-select { font-size:12px; color:#666; padding:4px 8px; border-radius:8px; background:#f5f5f5; }

/* 轮播图 */
.carousel-wrap { width:100%; height:200px; overflow:hidden; position:relative; background:#f0f0f0; }
.carousel-swiper { width:100%; height:200px; }
.carousel-slide { width:100%; height:200px; position:relative; }
.carousel-img { width:100%; height:200px; display:block; }
.slide-text { position:absolute; bottom:0; left:0; right:0; padding:40px 16px 16px; background:linear-gradient(transparent,rgba(0,0,0,.5)); }
.slide-title { font-size:18px; font-weight:700; color:#fff; display:block; }
.slide-desc { font-size:12px; color:rgba(255,255,255,.85); margin-top:2px; display:block; }
.carousel-dots { position:absolute; bottom:8px; right:12px; display:flex; gap:4px; z-index:2; }
.carousel-dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,.4); }
.carousel-dot.active { width:16px; border-radius:4px; background:#fff; }

/* 门店信息栏 */
.store-info-bar { padding:0 16px; background:#fff; }
.info-row { display:flex; align-items:center; font-size:12px; color:#666; border-bottom:1px solid #f0f0f0; padding:8px 0; }
.info-row.info-row-split { justify-content:space-between; }
.info-addr { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.info-link { color:#5D8A6B; font-weight:600; flex-shrink:0; padding-right:4px; }
.info-cell { flex:1; }
.info-left { text-align:left; }
.info-phone { cursor:pointer; }
.info-center { text-align:center; }
.info-right { text-align:right; padding-right:4px; }

/* 当前消费 */
.active-order-banner { display:none; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; }
.active-order-banner.show { display:block; }
.active-order-header { display:flex; justify-content:space-between; align-items:center; padding:12px 0 4px; }
.active-order-title { font-size:12px; opacity:.85; }
.active-order-room-row { display:flex; align-items:center; gap:4px; }
.active-order-room { font-size:16px; font-weight:700; }
.active-order-arrow { font-size:18px; opacity:.7; }
.active-order-time { font-size:11px; opacity:.75; }
.active-order-btns { display:flex; gap:8px; padding:8px 0; }
.active-order-btn { flex:1; display:flex; align-items:center; justify-content:center; gap:4px; padding:8px; border-radius:16px; font-size:13px; font-weight:600; }
.active-order-btn.outline { background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.3); }

/* 快捷入口 — 四宫格 */
.quick-grid { display:grid; grid-template-columns:repeat(4,1fr); padding:20px 16px; background:#fff; margin-bottom:12px; }
.quick-item { display:flex; flex-direction:column; align-items:center; gap:6px; padding:8px 2px; }
.quick-item:active { opacity:.7; }
.quick-icon { width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:34px; color:#fff; box-shadow:0 2px 8px rgba(0,0,0,.1); }
.quick-icon.brand { background:linear-gradient(135deg,#1f5c2e,#5D8A6B); }
.quick-icon.balance { background:linear-gradient(135deg,#4d6666,#7b9a9a); flex-direction:column; font-size:14px; gap:0; }
.balance-icon { font-size:20px; display:block; line-height:1; }
.balance-amt { font-size:12px; font-weight:600; display:block; line-height:1; }
.quick-icon.coupon { background:linear-gradient(135deg,#8a6500,#c4941c); }
.quick-icon.profile { background:linear-gradient(135deg,#655a4a,#9b8b7b); }
.quick-label { font-size:13px; color:#333; font-weight:500; }

/* 可预约包间横向滚动 */
.section { padding:0 0 12px; margin-bottom:12px; background:#fff; }
.section-title { font-size:15px; font-weight:600; margin-bottom:12px; color:#1a1a1a; padding:16px 16px 0; display:flex; justify-content:space-between; }
.section-more { font-size:12px; color:#5D8A6B; }
.room-scroll { white-space:nowrap; overflow-x:auto; padding:0 16px; }
.room-scroll::-webkit-scrollbar { display:none; }
.room-card { display:inline-block; width:180px; margin-right:12px; border-radius:16px; background:#fafafa; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,.06); }
.room-card-img { height:100px; display:flex; align-items:center; justify-content:center; font-size:40px; }
.room-card-body { padding:10px 12px; }
.room-card-name { font-size:14px; font-weight:600; color:#333; }
.room-card-tags { margin-top:4px; }
.room-tag { font-size:10px; color:#999; background:#f0f0f0; padding:2px 6px; border-radius:4px; margin-right:4px; }
.room-card-price { font-size:16px; font-weight:700; color:#B8860B; margin-top:6px; }
.room-card-price .unit { font-size:11px; font-weight:400; color:#999; }

/* 精选茶品 */
.tea-title { padding:16px 16px 0; }
.tea-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:0; }
.tea-card { background:#fff; border:1px solid #f0f0f0; border-radius:12px; overflow:hidden; display:flex; flex-direction:column; }
.tea-card:active { background:#fafafa; }
.tea-card-img { height:100px; display:flex; align-items:center; justify-content:center; font-size:40px; }
.tea-card-body { padding:10px; display:flex; flex-direction:column; flex:1; }
.tea-card-name { font-size:13px; font-weight:600; }
.tea-card-desc { font-size:11px; color:#999; margin-top:2px; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.tea-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:6px; }
.tea-card-price { font-size:15px; font-weight:700; color:#B8860B; }
.tea-card-add { width:26px; height:26px; border-radius:50%; border:none; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; font-size:16px; display:flex; align-items:center; justify-content:center; }
.qty-ctrl { display:flex; align-items:center; gap:4px; }
.qty-btn { width:24px; height:24px; border-radius:50%; border:1.5px solid #5D8A6B; background:#fff; color:#5D8A6B; font-size:16px; display:flex; align-items:center; justify-content:center; padding:0; }
.qty-num { min-width:20px; text-align:center; font-size:14px; font-weight:600; }

/* 底部导航由组件提供 */
.cart-link { font-size:12px; color:#5D8A6B; }
.cart-badge { display:inline-block; background:#e53935; color:#fff; border-radius:10px; padding:1px 6px; font-size:10px; margin-left:2px; vertical-align:top; }

/* 详情弹窗 */
.pay-modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.pay-modal { background:#fff;border-radius:16px;padding:20px;width:300px;max-width:85vw;text-align:center; }
.detail-img-area { width:100%;height:160px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:56px;margin-bottom:12px; }
.detail-name { font-size:18px;font-weight:700;display:block;text-align:center; }
.detail-desc { font-size:13px;color:#666;margin-top:4px;display:block;text-align:center; }
.detail-price-row { display:flex;justify-content:space-between;padding:10px 0;border-top:1px solid #f0f0f0;margin-top:12px; }
.detail-price-label { font-size:14px;color:#666; }
.detail-price { font-size:20px;font-weight:700;color:#B8860B; }
.pay-modal-btns { display:flex;gap:8px;margin-top:16px; }
.pay-btn-cancel { flex:1;padding:12px;border-radius:12px;border:1.5px solid #e0d8d0;background:#fff;font-size:14px;font-weight:600;color:#666; }
.pay-btn-confirm { flex:1;padding:12px;border-radius:12px;border:none;background:#5D8A6B;color:#fff;font-size:14px;font-weight:600; }

/* 弹窗 */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:16px;padding:20px;width:300px;max-width:90vw; }
.modal-title { font-size:16px;font-weight:600;display:block;margin-bottom:12px; }
.modal-close { margin-top:12px;padding:10px;border-radius:8px;border:none;background:#5D8A6B;color:#fff;font-size:14px;width:100%;text-align:center; }
.store-option { display:flex;align-items:center;justify-content:space-between;padding:14px;border-radius:12px;background:#f9f9f9;font-size:14px;font-weight:500;margin-bottom:6px; }
.store-option.coming { opacity:.6; }
.store-coming-tag { font-size:10px;color:#999;background:#f0f0f0;border-radius:4px;padding:2px 6px; }

/* 登录弹窗 */
.login-fullscreen { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.login-bg { background:linear-gradient(135deg,#1a3a1a,#2d5a2d);color:#fff;padding:32px 24px;border-radius:24px;width:340px; }
.login-card { background:#fff;color:#333;border-radius:16px;padding:24px; }
.login-card-title { font-size:20px;font-weight:700;text-align:center;display:block; }
.login-card-sub { font-size:12px;color:#999;text-align:center;margin-top:4px;display:block; }
.login-tabs { display:flex;margin:16px 0;border-bottom:1px solid #f0f0f0; }
.login-tab { flex:1;text-align:center;padding:10px;font-size:14px;color:#999; }
.login-tab.active { color:#5D8A6B;font-weight:600;border-bottom:2px solid #5D8A6B; }
.form-item { margin-bottom:10px; }
.form-label { font-size:12px;color:#666;margin-bottom:4px;display:block; }
.form-input { width:100%;padding:12px;border:1.5px solid #e0d8d0;border-radius:12px;font-size:14px;box-sizing:border-box; }
.code-row { display:flex;gap:8px; }
.code-btn { padding:12px 16px;border-radius:12px;border:none;background:#5D8A6B;color:#fff;font-size:13px;white-space:nowrap; }
.form-btn { width:100%;padding:14px;border-radius:16px;border:none;background:linear-gradient(135deg,#5D8A6B,#7BA88E);color:#fff;font-size:16px;font-weight:600;text-align:center;margin-top:4px; }
.form-switch { font-size:12px;color:#5D8A6B;text-align:center;display:block;margin-top:12px; }
.login-hint { font-size:11px;color:#ccc;text-align:center;margin-top:12px;display:block; }
.staff-login-link { margin-top:8px !important; font-size:12px !important; }

/* 加载/错误 */
.loading-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(255,255,255,.8);z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center; }
.loading-spinner { width:32px;height:32px;border:3px solid #e0e0e0;border-top-color:#5D8A6B;border-radius:50%;animation:spin .8s linear infinite; }
@keyframes spin { to{transform:rotate(360deg)} }
.loading-text { font-size:13px;color:#999;margin-top:8px; }
.error-toast { position:fixed;bottom:80px;left:16px;right:16px;background:#d54941;color:#fff;padding:12px;border-radius:8px;text-align:center;font-size:13px;z-index:100; }
