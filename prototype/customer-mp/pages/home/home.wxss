/** 首页样式 */
page { background: #f5f5f5; }
.page { padding-bottom: 20px; }

/* 顶部 */
.nav-top { position: sticky; top: 0; z-index: 100; }
.store-header { padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1px solid #f0f0f0; }
.store-name { font-size: 18px; font-weight: 700; color: #1a1a1a; }
.store-select { font-size: 13px; color: #5D8A6B; display: flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 6px; background: #f0f5ff; }

/* 进行中订单 */
.active-order-banner { display: none; margin: 0; padding: 14px 16px; background: linear-gradient(135deg,#5D8A6B,#00a854); color: #fff; }
.active-order-banner.show { display: block; }
.active-order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.active-order-title { font-size: 13px; font-weight: 600; opacity: .9; }
.active-order-room { font-size: 16px; font-weight: 700; }
.active-order-time { font-size: 12px; opacity: .8; margin-top: 2px; }
.active-order-btns { display: flex; gap: 10px; margin-top: 10px; }
.active-order-btn { flex: 1; padding: 12px; border-radius: 10px; border: none; font-size: 14px; font-weight: 600; text-align: center; }
.active-order-btn.primary { background: #fff; color: #5D8A6B; }
.active-order-btn.outline { background: rgba(255,255,255,.2); color: #fff; border: 1.5px solid rgba(255,255,255,.4); }

/* 轮播 */
.carousel-wrap { margin: 0; }
.carousel-swiper { height: 200px; }
.carousel-slide { width: 100%; height: 200px; display: flex; flex-direction: column; justify-content: flex-end; padding: 16px 20px; color: #fff; }
.slide-title { font-size: 20px; font-weight: 700; text-shadow: 0 1px 4px rgba(0,0,0,.5); }
.slide-desc { font-size: 13px; margin-top: 4px; text-shadow: 0 1px 4px rgba(0,0,0,.5); }

/* 快捷入口 */
.quick-grid { display: grid; grid-template-columns: repeat(4,1fr); padding: 16px 0; background: #fff; margin-bottom: 12px; }
.quick-item { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px 4px; position: relative; }
.quick-item:active { opacity: .7; }
.quick-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fff; }
.quick-icon.brand { background: linear-gradient(135deg,#5D8A6B,#7BA88E); }
.quick-icon.balance { background: linear-gradient(135deg,#7A8B8B,#A3B5B5); }
.quick-icon.coupon { background: linear-gradient(135deg,#B8860B,#D4A84B); }
.quick-icon.profile { background: linear-gradient(135deg,#8B7D6B,#B5A896); }
.quick-label { font-size: 11px; color: #333; font-weight: 500; }
.balance-on-icon { position: absolute; bottom: 2px; right: 2px; font-size: 9px; font-weight: 700; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.5); }

/* 推荐房间 */
.section { margin-bottom: 16px; background: #fff; padding: 16px 0; }
.section-title { font-size: 15px; font-weight: 600; color: #1a1a1a; padding: 0 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }
.section-more { font-size: 12px; color: #999; }
.room-scroll { display: flex; padding-left: 16px; white-space: nowrap; }
.room-card { display: inline-flex; flex-direction: column; width: 180px; margin-right: 12px; border-radius: 12px; background: #fafafa; overflow: hidden; }
.room-card:active { opacity: .8; }
.room-card-img { height: 100px; display: flex; align-items: center; justify-content: center; font-size: 40px; background: #f0f0f0; }
.room-card-body { padding: 10px 12px; }
.room-card-name { font-size: 14px; font-weight: 600; color: #333; }
.room-card-tags { margin-top: 4px; }
.room-tag { font-size: 10px; color: #999; background: #f0f0f0; padding: 2px 6px; border-radius: 4px; margin-right: 4px; }
.room-card-price { font-size: 16px; font-weight: 700; color: #B8860B; margin-top: 6px; }
.room-card-price .unit { font-size: 11px; font-weight: 400; color: #999; }
