page { background:#f5f5f5; margin:0; padding:0; width:100%; overflow-x:hidden; max-width:100vw; }
button { padding:0; margin:0; background:none; border:none; line-height:1; }
button::after { border:none; }
.page { overflow-y:auto; overflow-x:hidden; padding-bottom:60px; width:100%; max-width:100vw; }

/* ── Store Header ── */
.store-header { padding:12px 16px; display:flex; align-items:center; justify-content:space-between; background:#fff; border-bottom:1px solid #f0f0f0; }
.store-name { font-size:18px; font-weight:700; color:#1a1a1a; }
.store-select { font-size:13px; color:#5D8A6B; display:flex; align-items:center; gap:4px; padding:4px 8px; border-radius:6px; background:#f0f5ff; }

/* ── QR Context Card ── */
.qr-context-card { margin:12px 16px; background:#f0fdf4; padding:14px; border:1.5px solid #dcedc8; border-radius:12px; }
.qr-context-row { display:flex; align-items:center; gap:10px; }
.qr-context-icon { font-size:24px; }
.qr-context-info { flex:1; }
.qr-context-title { font-size:14px; font-weight:600; color:#333; }
.qr-context-desc { font-size:12px; color:#666; margin-top:2px; }
.qr-context-btn { padding:8px 16px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:12px; font-weight:600; text-align:center; white-space:nowrap; flex-shrink:0; }
.qr-context-btn:active { opacity:.8; }
.qr-context-actions { display:flex; gap:10px; margin-top:10px; padding-top:10px; border-top:1px solid #dcedc8; }
.qr-context-action { flex:1; padding:6px; border-radius:8px; background:#fff; border:1px solid #dcedc8; font-size:12px; color:#666; text-align:center; }
.qr-context-action.qr-close { flex:0 0 auto; padding:6px 8px; color:#999; }

/* ── Carousel ── */
.carousel-wrap { position:relative; overflow:hidden; }
.carousel-swiper { height:200px; }
.carousel-slide { width:100%; height:200px; display:flex; flex-direction:column; justify-content:flex-end; padding:16px 20px; color:#fff; background-size:cover; background-position:center; }
.slide-title { font-size:20px; font-weight:700; text-shadow:0 1px 4px rgba(0,0,0,.5); }
.slide-desc { font-size:13px; margin-top:4px; text-shadow:0 1px 4px rgba(0,0,0,.5); }
.carousel-dots { position:absolute; bottom:8px; right:16px; display:flex; gap:6px; z-index:2; }
.carousel-dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,.4); transition:all .2s; }
.carousel-dot.active { background:#fff; width:18px; border-radius:10px; }

/* ── Store Info Bar ── */
.store-info-bar { padding:8px 0; font-size:12px; color:#558b2f; line-height:1.8; background:#f0fdf4; width:100%; }
.info-row { padding:0 16px; display:flex; align-items:center; flex-wrap:wrap; }
.info-link { color:#2e7d32; font-weight:600; }

/* ── Active Order Banner ── */
.active-order-banner { display:none; margin:0; padding:14px 16px; background:linear-gradient(135deg,#5D8A6B,#00a854); color:#fff; }
.active-order-banner.show { display:block; }
.active-order-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.active-order-title { font-size:13px; font-weight:600; opacity:.9; }
.active-order-room-row { display:flex; align-items:center; gap:4px; }
.active-order-room { font-size:16px; font-weight:700; }
.active-order-arrow { font-size:16px; opacity:.6; }
.active-order-time { font-size:12px; opacity:.8; margin-top:2px; display:block; }
.active-order-btns { display:flex; gap:10px; margin-top:10px; }
.active-order-btn { flex:1; padding:12px; border-radius:10px; font-size:14px; font-weight:600; text-align:center; }
.active-order-btn.primary { background:#fff; color:#5D8A6B; }
.active-order-btn.outline { background:rgba(255,255,255,.2); color:#fff; border:1.5px solid rgba(255,255,255,.4); }

/* ── Quick Grid ── */
.quick-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:0; padding:16px 0; background:#fff; margin-bottom:12px; }
.quick-item { display:flex; flex-direction:column; align-items:center; gap:6px; padding:10px 4px; }
.quick-item:active { opacity:.7; }
.quick-icon { width:52px; height:52px; border-radius:14px; display:flex; align-items:center; justify-content:center; font-size:22px; color:#fff; position:relative; }
.quick-icon.brand { background:linear-gradient(135deg,#5D8A6B,#7BA88E); }
.quick-icon.balance { background:linear-gradient(135deg,#7A8B8B,#A3B5B5); }
.quick-icon.coupon { background:linear-gradient(135deg,#B8860B,#D4A84B); }
.quick-icon.profile { background:linear-gradient(135deg,#8B7D6B,#B5A896); }
.balance-on-icon { position:absolute; bottom:2px; right:2px; font-size:9px; font-weight:700; color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.5); line-height:1; }
.quick-label { font-size:11px; color:#333; font-weight:500; }

/* ── Section ── */
.section { padding:0 0 12px; margin-bottom:12px; background:#fff; }
.section-title { font-size:15px; font-weight:600; margin-bottom:12px; color:#1a1a1a; padding:16px 16px 0; display:flex; justify-content:space-between; align-items:center; }
.section-more { font-size:12px; font-weight:400; color:#5D8A6B; display:flex; align-items:center; gap:4px; }

/* ── Room List ── */
.room-list { padding:0; }
.room-card { display:flex; padding:14px 16px; background:#f9fafb; margin-bottom:1px; border-bottom:1px solid #f0f0f0; }
.room-card:active { background:#f0f0f0; }
.room-card-img { width:80px; height:80px; border-radius:6px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:28px; overflow:hidden; }
.room-card-body { margin-left:12px; flex:1; display:flex; flex-direction:column; justify-content:space-between; }
.room-card-name { font-size:15px; font-weight:600; color:#333; }
.room-card-meta { font-size:12px; color:#999; margin-top:2px; }
.room-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:4px; }
.room-card-price { font-size:16px; font-weight:700; color:#B8860B; }
.room-card-price .unit { font-size:11px; font-weight:400; color:#999; }
.room-card-book-btn { padding:6px 14px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:12px; font-weight:600; text-align:center; }
.room-card-book-btn:active { opacity:.8; }

/* ── Tea Grid ── */
.tea-title { padding:16px 10px 0 10px; }
.tea-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; padding:0 10px; }
.tea-card { background:#fff; border:1px solid #f0f0f0; border-radius:12px; overflow:hidden; }
.tea-card-img { height:100px; display:flex; align-items:center; justify-content:center; font-size:40px; }
.tea-card-body { padding:10px; }
.tea-card-name { font-size:13px; font-weight:600; }
.tea-card-desc { font-size:11px; color:#999; margin-top:2px; }
.tea-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:6px; }
.tea-card-price { font-size:15px; font-weight:700; color:#B8860B; }
.qty-ctrl { display:flex; align-items:center; gap:4px; }
.qty-btn-sm { width:20px; height:20px; border-radius:50%; border:1px solid #ddd; display:flex; align-items:center; justify-content:center; font-size:14px; color:#333; }
.qty-num-sm { font-size:12px; font-weight:600; min-width:14px; text-align:center; }
.tea-card-btn { padding:4px 10px; border-radius:16px; background:#5D8A6B; color:#fff; font-size:11px; }
.cart-link { font-size:12px; font-weight:400; color:#5D8A6B; display:flex; align-items:center; gap:4px; }
.cart-badge { background:#B8860B; color:#fff; border-radius:10px; padding:1px 7px; font-size:10px; }

/* ── Staff Entrance ── */
.staff-entrance { text-align:center; padding:16px 0 80px; }
.staff-entrance text { font-size:11px; color:#ccc; }

/* ── Bottom Nav ── */
.bottom-nav { display:flex; border-top:1px solid #eee; background:#fff; position:fixed; bottom:0; left:0; right:0; z-index:50; }
.nav-item { flex:1; text-align:center; padding:10px 0 6px; color:#999; }
.nav-item.active { color:#5D8A6B; }
.nav-icon { font-size:20px; display:block; }
.nav-label { font-size:10px; margin-top:2px; }

/* ── Modal ── */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:14px;padding:24px;width:320px;text-align:center;max-height:90vh;overflow-y:auto; }
.modal-title { font-size:16px;margin-bottom:8px;color:#333; }
.modal-close { margin-top:16px;padding:10px 24px;border-radius:8px;background:#5D8A6B;color:#fff;font-size:14px;text-align:center; }
.store-option { display:flex;align-items:center;justify-content:space-between;padding:14px;border-bottom:1px solid #f0f0f0;font-size:14px; }
.store-option:last-child { border-bottom:none; }
.store-option.active { color:#5D8A6B;font-weight:600; }
.store-option.coming { color:#999; }
.store-coming-tag { font-size:10px;padding:2px 6px;border-radius:8px;background:#fff3e0;color:#B8860B; }

/* ── Parking Modal ── */
.parking-modal { width:340px;text-align:left; }
.parking-content { text-align:left;padding:4px 0; }
.parking-section { margin-bottom:14px; }
.parking-section:last-child { margin-bottom:0; }
.ps-title { font-size:13px;font-weight:600;color:#333;margin-bottom:6px;display:flex;align-items:center;gap:6px; }
.ps-text { font-size:13px;color:#666;line-height:1.6; }
.ps-tag { display:inline-block;font-size:11px;padding:2px 8px;border-radius:6px;margin:2px 4px 2px 0; }
.ps-tag.free { background:#e8f5e9;color:#00a870; }
.ps-tag.paid { background:#fff3e0;color:#B8860B; }
.ps-tag.info { background:#e3f2fd;color:#5D8A6B; }

/* ── Bill Modal ── */
.bill-modal { text-align:left; }
.bill-content { max-height:300px;overflow-y:auto;margin:8px 0; }
.bill-item { display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #f5f5f5;font-size:14px; }
.bill-empty { text-align:center;padding:30px 0; }
.bill-total { text-align:right;font-size:18px;font-weight:700;color:#B8860B;padding:10px 0;border-top:1px solid #f0f0f0;margin-top:8px; }

/* ── Login Modal ── */
.login-tabs { display:flex;margin-bottom:16px;border-radius:8px;overflow:hidden;border:1px solid #e5e5e5; }
.login-tab { flex:1;padding:10px;font-size:13px;background:#f5f5f5;color:#999;text-align:center; }
.login-tab.active { background:#5D8A6B;color:#fff; }
.form-item { margin-bottom:12px;text-align:left; }
.form-label { font-size:12px;color:#999;margin-bottom:4px;display:block; }
.form-input { width:100%;padding:10px 12px;border:1.5px solid #e5e5e5;border-radius:8px;font-size:14px;outline:none;box-sizing:border-box; }
.form-input:focus { border-color:#5D8A6B; }
.code-row { display:flex;gap:8px;align-items:center; }
.code-row .form-input { flex:1; }
.code-btn { padding:10px 12px;border-radius:8px;border:1px solid #5D8A6B;background:#fff;color:#5D8A6B;font-size:12px;text-align:center;white-space:nowrap; }
.form-btn { width:100%;padding:12px;border-radius:8px;background:#5D8A6B;color:#fff;font-size:15px;font-weight:600;margin-top:8px;text-align:center; }
.form-btn:active { opacity:.8; }
.form-switch { font-size:12px;color:#5D8A6B;margin-top:12px;text-align:center;display:block; }
.login-hint { font-size:11px;color:#bbb;margin-top:12px;text-align:center;display:block; }

/* ── QR Warning ── */
.qr-warning-text { font-size:14px;color:#666;margin:12px 0;display:block; }

/* ── QR Debug Panel ── */
.qr-debug { position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#333;color:#fff;border-radius:12px;padding:14px;width:340px;z-index:300;box-shadow:0 4px 20px rgba(0,0,0,.3); }
.qr-debug-title { font-size:13px;font-weight:600;margin-bottom:8px; }
.qr-debug-row { display:flex;gap:6px;align-items:center;margin-bottom:6px; }
.qr-debug-input { flex:1;padding:6px 10px;border-radius:6px;border:none;font-size:12px;background:#fff;color:#333;box-sizing:border-box; }
.qr-debug-btn { padding:6px 12px;border-radius:6px;background:#5D8A6B;color:#fff;border:none;font-size:12px;text-align:center;white-space:nowrap; }
.qr-debug-hint { font-size:11px;color:#999;display:block; }

/* ── Loading / Error ── */
.loading-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(255,255,255,.9);z-index:300;display:flex;flex-direction:column;align-items:center;justify-content:center; }
.loading-spinner { width:36px;height:36px;border:3px solid #e0e0e0;border-top-color:#5D8A6B;border-radius:50%;animation:spin .8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
.loading-text { font-size:14px;color:#999;margin-top:12px; }
.error-toast { position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.85);color:#fff;padding:14px 24px;border-radius:16px;font-size:14px;z-index:400;max-width:300px;text-align:center; }
