<view class="page" style="padding-top:{{topPadding}}px;">

  <!-- 门店头部 -->
  <view class="store-header">
    <text class="store-name">高岸茶室</text>
    <text class="store-select" bindtap="showStoreSelector">盈隆店 ▾</text>
  </view>

  <!-- QR上下文卡片 -->
  <view class="qr-context-card" hidden="{{!qrRoomId}}">
    <view class="qr-context-row">
      <text class="qr-context-icon">📍</text>
      <view class="qr-context-info">
        <view class="qr-context-title">您正在 <text style="font-weight:600">{{qrRoomName}}</text></view>
        <text class="qr-context-desc">桌号: {{qrTableId}}号桌 · 已自动识别位置</text>
      </view>
      <button class="qr-context-btn" bindtap="goCartWithRoom">点茶品 →</button>
    </view>
    <view class="qr-context-actions">
      <button class="qr-context-action" bindtap="showRoomBill">🧾 查看挂账</button>
      <button class="qr-context-action" bindtap="goMyOrders">📋 查看订单</button>
      <button class="qr-context-action qr-close" bindtap="closeQrContext">✕</button>
    </view>
  </view>

  <!-- 轮播 -->
  <view class="carousel-wrap">
    <swiper class="carousel-swiper" current="{{currentSlide}}" bindchange="onSwiperChange" autoplay interval="3500" circular>
      <swiper-item wx:for="{{carousels}}" wx:key="index">
        <view class="carousel-slide" bindtap="onCarouselTap" data-index="{{index}}" style="background:url('{{item.img}}') center/cover no-repeat;">
          <text class="slide-title">{{item.title}}</text>
          <text class="slide-desc">{{item.desc}}</text>
        </view>
      </swiper-item>
    </swiper>
    <view class="carousel-dots">
      <text class="carousel-dot {{currentSlide==0?'active':''}}" bindtap="goSlide" data-idx="0"></text>
      <text class="carousel-dot {{currentSlide==1?'active':''}}" bindtap="goSlide" data-idx="1"></text>
      <text class="carousel-dot {{currentSlide==2?'active':''}}" bindtap="goSlide" data-idx="2"></text>
      <text class="carousel-dot {{currentSlide==3?'active':''}}" bindtap="goSlide" data-idx="3"></text>
    </view>
  </view>

  <!-- 门店信息栏 -->
  <view class="store-info-bar">
    <view class="info-row"><text>📍 广州市天河区珠江新城华夏路28号盈隆大厦16层 · </text><text class="info-link" bindtap="openNavigation">🗺 导航</text></view>
    <view class="info-row"><text>📞 </text><text class="info-link" bindtap="callPhone">020-8888-8888</text><text> · </text><text class="info-link" bindtap="showParkingInfo">🅿️ 停车</text><text> · 🕐 09:00-23:00</text></view>
  </view>

  <!-- 当前消费 -->
  <view class="active-order-banner {{hasActiveOrder?'show':''}}" bindtap="goMyOrders">
    <view class="active-order-header">
      <text class="active-order-title">⏱ 当前消费</text>
      <view class="active-order-room-row">
        <text class="active-order-room">{{activeOrder.roomName}}</text>
        <text class="active-order-arrow">›</text>
      </view>
    </view>
    <text class="active-order-time">{{activeOrder.timeStr}}</text>
    <view class="active-order-btns">
      <view class="active-order-btn primary" catchtap="openDoor">🚪 开门</view>
      <view class="active-order-btn outline" catchtap="callService">📞 客服</view>
    </view>
  </view>

  <!-- 四个快捷入口 -->
  <view class="quick-grid">
    <view class="quick-item" bindtap="goCouponVerify">
      <view class="quick-icon brand">🎫</view>
      <text class="quick-label">验券</text>
    </view>
    <view class="quick-item" bindtap="handleBalanceClick">
      <view class="quick-icon balance" style="position:relative;">
        <text>{{balanceIcon}}</text>
        <text class="balance-on-icon" wx:if="{{balanceVisible}}">¥{{balance}}</text>
        <text class="balance-on-icon" wx:else>****</text>
      </view>
      <text class="quick-label">会员余额</text>
    </view>
    <view class="quick-item" bindtap="handleCouponClick">
      <view class="quick-icon coupon">🏷️</view>
      <text class="quick-label">优惠券</text>
    </view>
    <view class="quick-item" bindtap="goProfile">
      <view class="quick-icon profile">👤</view>
      <text class="quick-label">我的</text>
    </view>
  </view>

  <!-- 可预约包间 -->
  <view class="section">
    <view class="section-title">
      <text>可预约包间</text>
      <text class="section-more" bindtap="goRoomList">查看全部 ›</text>
    </view>
    <view class="room-list">
      <view class="room-card" wx:for="{{rooms}}" wx:key="roomId" catchtap="goRoom" data-roomid="{{item.roomId}}">
        <view class="room-card-img" style="background:{{item.bgColor}}">{{item.icon}}</view>
        <view class="room-card-body">
          <text class="room-card-name">{{item.name}}</text>
          <text class="room-card-meta">{{item.capacity}}人 · {{item.area}}㎡ · {{item.facilities}}</text>
          <view class="room-card-footer">
            <text class="room-card-price">¥{{item.pricePerHour}}<text class="unit">/时</text></text>
            <button class="room-card-book-btn" catchtap="goRoom" data-roomid="{{item.roomId}}">立即预约</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 精选茶品 -->
  <view class="section">
    <view class="section-title tea-title">
      <text>🍵 精选茶品</text>
      <text class="cart-link" bindtap="goCartPage">🛒 购物车<text class="cart-badge" wx:if="{{cartCount>0}}">{{cartCount}}</text></text>
    </view>
    <view class="tea-grid">
      <view class="tea-card" wx:for="{{teaProducts}}" wx:key="productId">
        <view class="tea-card-img" style="background:{{item.bg}}" bindtap="showProductDetail" data-pid="{{item.productId}}" data-name="{{item.name}}" data-desc="{{item.desc}}" data-price="{{item.price}}">{{item.icon}}</view>
        <view class="tea-card-body">
          <text class="tea-card-name">{{item.name}}</text>
          <text class="tea-card-desc">{{item.desc}}</text>
          <view class="tea-card-footer">
            <text class="tea-card-price">¥{{item.price}}</text>
            <view class="qty-ctrl">
              <text class="qty-btn-sm" wx:if="{{item._qty>0}}" bindtap="decQty" data-pid="{{item.productId}}">−</text>
              <text class="qty-num-sm" wx:if="{{item._qty>0}}">{{item._qty}}</text>
              <text class="tea-card-btn" catchtap="incQty" data-pid="{{item.productId}}" data-name="{{item.name}}" data-price="{{item.price}}">{{item._qty>0?'+':'+ 加购'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 员工入口 -->
  <view class="staff-entrance" bindtap="goStaffLogin"><text>🔒 员工通道</text></view>

  <!-- 底部导航 -->
  <view class="bottom-nav">
    <view class="nav-item active"><text class="nav-icon">🏠</text><text class="nav-label">主页</text></view>
    <view class="nav-item" bindtap="goRoomList"><text class="nav-icon">📅</text><text class="nav-label">预订</text></view>
    <view class="nav-item" bindtap="goTeaShop"><text class="nav-icon">🍵</text><text class="nav-label">茶品</text></view>
    <view class="nav-item" bindtap="goMyOrders"><text class="nav-icon">📋</text><text class="nav-label">订单</text></view>
    <view class="nav-item" bindtap="goMemberCenter"><text class="nav-icon">👤</text><text class="nav-label">我的</text></view>
  </view>
</view>

<!-- 门店选择弹窗 -->
<view class="modal-overlay" hidden="{{!showStoreModal}}" bindtap="hideStoreSelector">
  <view class="modal" catchtap="">
    <text class="modal-title">选择门店</text>
    <view class="store-option active"><text>📍 盈隆店</text><text style="color:#5D8A6B;">✓ 当前</text></view>
    <view class="store-option coming" bindtap="toastComing"><text>📍 珠江新城店</text><text class="store-coming-tag">即将上线</text></view>
    <view class="store-option coming" bindtap="toastComing"><text>📍 琶洲店</text><text class="store-coming-tag">即将上线</text></view>
    <view class="modal-close" bindtap="hideStoreSelector">关闭</view>
  </view>
</view>

<!-- 停车指引弹窗 -->
<view class="modal-overlay" hidden="{{!showParkingModal}}" bindtap="hideParkingInfo">
  <view class="modal parking-modal" catchtap="">
    <text class="modal-title" style="text-align:center;">🅿️ 停车指引</text>
    <view class="parking-content">
      <view class="parking-section">
        <text class="ps-title">📍 停车场位置</text>
        <text class="ps-text">盈隆大厦地下停车场（B2-B4层）</text><text class="ps-text">入口位于大厦东侧华夏路辅路</text>
      </view>
      <view class="parking-section">
        <text class="ps-title">💰 收费标准</text>
        <view class="ps-text">
          <text class="ps-tag free">前30分钟免费</text>
          <text class="ps-tag paid">¥8/小时</text>
          <text class="ps-tag paid">¥64/天封顶</text>
        </view>
        <text class="ps-text">夜间（22:00-08:00）：¥4/小时</text>
        <text class="ps-text">本店消费满 ¥200 可兑换 1小时免费停车券（详询前台）</text>
      </view>
      <view class="parking-section">
        <text class="ps-title">🚗 车位信息</text>
        <text class="ps-text">总车位：约300个</text>
        <text class="ps-text">新能源充电桩：B3层东区（快充20个，慢充30个）</text>
        <text class="ps-text">无障碍车位：B2层电梯口旁（2个）</text>
      </view>
      <view class="parking-section">
        <text class="ps-title">📌 温馨提示</text>
        <text class="ps-text">高峰时段（周末14:00-18:00）车位较紧张，建议绿色出行。</text>
        <text class="ps-text">地铁：3号线/5号线珠江新城站A1出口步行约5分钟</text>
      </view>
    </view>
    <view class="modal-close" bindtap="hideParkingInfo">我知道了</view>
  </view>
</view>

<!-- 房间挂账单弹窗 -->
<view class="modal-overlay" hidden="{{!showBillModal}}" bindtap="hideRoomBill">
  <view class="modal bill-modal" catchtap="">
    <text class="modal-title" style="text-align:center;">🧾 房间挂账单</text>
    <view class="bill-content" wx:if="{{billItems.length>0}}">
      <view class="bill-item" wx:for="{{billItems}}" wx:key="index">
        <text>{{item.name}} ×{{item.qty}}</text>
        <text style="color:#B8860B;">¥{{item.amount}}</text>
      </view>
    </view>
    <view class="bill-empty" wx:else>
      <text style="color:#ccc;font-size:14px;">暂无挂账记录</text>
    </view>
    <view class="bill-total" wx:if="{{billItems.length>0}}">合计：¥{{billTotal}}</view>
    <view class="modal-close" bindtap="hideRoomBill">关闭</view>
  </view>
</view>

<!-- 登录弹窗 -->
<view class="modal-overlay" hidden="{{!showLoginModal}}" bindtap="hideLogin">
  <view class="modal" catchtap="">
    <text class="modal-title" style="margin-bottom:12px;">{{loginMode=='login'?'登录':'注册'}}</text>
    <view class="login-tabs">
      <text class="login-tab {{loginMode=='login'?'active':''}}" bindtap="switchLoginTab" data-mode="login">登录</text>
      <text class="login-tab {{loginMode=='register'?'active':''}}" bindtap="switchLoginTab" data-mode="register">注册</text>
    </view>
    <view wx:if="{{loginMode=='login'}}">
      <view class="form-item"><text class="form-label">手机号</text><input class="form-input" placeholder="请输入手机号" value="{{loginPhone}}" bindinput="onLoginPhone" /></view>
      <view class="form-item"><text class="form-label">验证码</text><view class="code-row"><input class="form-input" placeholder="验证码" value="{{loginCode}}" bindinput="onLoginCode" /><view class="code-btn" bindtap="getVerifyCode">获取验证码</view></view></view>
      <view class="form-btn" bindtap="doLogin">登 录</view>
      <text class="form-switch" bindtap="switchLoginTab" data-mode="register">没有账号？立即注册 →</text>
    </view>
    <view wx:else>
      <view class="form-item"><text class="form-label">手机号</text><input class="form-input" placeholder="请输入手机号" bindinput="onRegPhone" /></view>
      <view class="form-item"><text class="form-label">昵称</text><input class="form-input" placeholder="请输入昵称" bindinput="onRegName" /></view>
      <view class="form-item"><text class="form-label">验证码</text><view class="code-row"><input class="form-input" placeholder="验证码" /><view class="code-btn" bindtap="getVerifyCode">获取验证码</view></view></view>
      <view class="form-btn" bindtap="doRegister">注 册</view>
      <text class="form-switch" bindtap="switchLoginTab" data-mode="login">已有账号？立即登录 →</text>
    </view>
    <text class="login-hint">演示环境，任意手机号即可登录</text>
  </view>
</view>

<!-- QR警告弹窗 -->
<view class="modal-overlay" hidden="{{!showQrWarning}}" bindtap="hideQrWarning">
  <view class="modal" catchtap="">
    <text class="modal-title" style="color:#D54941;">⚠️ 房间未启用</text>
    <text class="qr-warning-text">{{qrWarningText}}</text>
    <view class="modal-close" bindtap="hideQrWarning">我知道了</view>
  </view>
</view>

<!-- QR调试面板 -->
<view class="qr-debug" hidden="{{!showDebug}}">
  <view class="qr-debug-title">🔧 QR扫码调试</view>
  <view class="qr-debug-row">
    <input class="qr-debug-input" value="{{debugRoomId}}" bindinput="onDebugRoomId" placeholder="房间ID" />
    <input class="qr-debug-input" value="{{debugTableId}}" bindinput="onDebugTableId" placeholder="桌号" style="width:60px;" />
    <button class="qr-debug-btn" bindtap="debugQrScan">模拟扫码</button>
    <button class="qr-debug-btn" bindtap="closeDebug">✕</button>
  </view>
  <text class="qr-debug-hint">按 Ctrl+D 隐藏调试面板</text>
</view>

<!-- 加载/错误 -->
<view class="loading-overlay" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>
<view class="error-toast" wx:if="{{errorMsg}}" bindtap="clearError"><text>{{errorMsg}}</text></view>
