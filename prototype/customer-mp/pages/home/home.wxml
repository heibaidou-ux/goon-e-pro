<view class="phone"><scroll-view class="page" scroll-y show-scrollbar="{{false}}" style="padding-top:{{topPadding}}px;">

  <!-- 门店头部 -->
  <view class="store-header">
    <text class="store-name">高岸茶室</text>
    <text class="store-select" bindtap="showStoreSelector">{{storeName}} ▾</text>
  </view>

  <!-- 轮播图 -->
  <view class="carousel-wrap">
    <swiper class="carousel-swiper" current="{{currentSlide}}" bindchange="onSwiperChange" autoplay interval="3500" circular duration="300" easing-function="easeInOutCubic">
      <swiper-item wx:for="{{carousels}}" wx:key="index">
        <view class="carousel-slide" bindtap="onCarouselTap" data-index="{{index}}">
          <image class="carousel-img" src="{{item.img}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>
          <view class="slide-text">
            <text class="slide-title">{{item.title}}</text>
            <text class="slide-desc">{{item.desc}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="carousel-dots">
      <text class="carousel-dot {{index==currentSlide?'active':''}}" wx:for="{{carousels}}" wx:for-index="index" wx:key="index" bindtap="goSlide" data-idx="{{index}}"></text>
    </view>
  </view>

  <!-- 门店信息栏 -->
  <view class="store-info-bar">
    <view class="info-row">
      <text class="info-addr" bindtap="copyAddress">📍 广州市天河区珠江新城富力盈隆广场3801</text>
      <text class="info-link" bindtap="openNavigation">🗺 导航</text>
    </view>
    <view class="info-row info-row-split">
      <text class="info-cell info-left info-phone" bindtap="callPhone">📞 18011821388</text>
      <text class="info-cell info-link info-center" bindtap="showParkingInfo">🅿️ 停车指引</text>
      <text class="info-cell info-right">营业时间：24小时</text>
    </view>
  </view>

  <!-- 当前消费 -->
  <view class="active-order-banner {{hasActiveOrder?'show':''}}">
    <view class="active-order-header" bindtap="goMyOrders">
      <text class="active-order-title">⏱ 当前消费</text>
      <view class="active-order-room-row"><text class="active-order-room">{{activeOrder.roomName}}</text><text class="active-order-arrow">›</text></view>
    </view>
    <text class="active-order-time">{{activeOrder.timeStr}}</text>
    <view class="active-order-btns">
      <view class="active-order-btn outline" catchtap="openDoor"><text class="btn-icon">🚪</text><text class="btn-label">开门</text></view>
      <view class="active-order-btn outline" catchtap="goSmartControl"><text class="btn-icon">🔧</text><text class="btn-label">智控</text></view>
      <view class="active-order-btn outline" catchtap="callService"><text class="btn-icon">📞</text><text class="btn-label">客服</text></view>
    </view>
  </view>

  <!-- 四个快捷入口 -->
  <view class="quick-grid">
    <view class="quick-item" bindtap="goCouponVerify"><view class="quick-icon brand">🎫</view><text class="quick-label">验券</text></view>
    <view class="quick-item" bindtap="handleBalanceClick"><view class="quick-icon balance"><text class="balance-icon">💰</text><text class="balance-amt">{{balanceDisplay}}</text></view><text class="quick-label">会员余额</text></view>
    <view class="quick-item" bindtap="handleCouponClick"><view class="quick-icon coupon">🏷️</view><text class="quick-label">优惠券</text></view>
    <view class="quick-item" bindtap="goProfile"><view class="quick-icon profile">👤</view><text class="quick-label">我的</text></view>
  </view>

  <!-- 可预约包间 -->
  <view class="section">
    <view class="section-title"><text>可预约包间</text><text class="section-more" bindtap="goRoomList">查看全部 ›</text></view>
    <scroll-view class="room-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="room-card" wx:for="{{rooms}}" wx:key="roomId" bindtap="goRoom" data-roomid="{{item.roomId}}">
        <view class="room-card-img" style="background:{{item.bgColor}}">{{item.icon}}</view>
        <view class="room-card-body"><text class="room-card-name">{{item.name}}</text><view class="room-card-tags"><text class="room-tag">{{item.capacity}}人</text><text class="room-tag">{{item.area}}㎡</text></view><text class="room-card-price">¥{{item.pricePerHour}}<text class="unit">/时</text></text></view>
      </view>
    </scroll-view>
  </view>

  <!-- 精选茶品 -->
  <view class="section">
    <view class="section-title tea-title"><text>🍵 精选茶品</text><text class="cart-link" bindtap="goCartPage">🛒 购物车<text class="cart-badge" wx:if="{{cartCount>0}}">{{cartCount}}</text></text></view>
    <view class="tea-grid">
      <view class="tea-card" wx:for="{{teaProducts}}" wx:key="productId" bindtap="goTeaShop">
        <view class="tea-card-img" style="background:{{item.bg}}" catchtap="showProductDetail" data-pid="{{item.productId}}">{{item.icon}}</view>
        <view class="tea-card-body"><text class="tea-card-name">{{item.name}}</text><text class="tea-card-desc">{{item.desc}}</text><view class="tea-card-footer"><text class="tea-card-price">¥{{item.price}}</text><view class="qty-ctrl"><text class="qty-btn-sm" wx:if="{{item._qty>0}}" catchtap="decQty" data-pid="{{item.productId}}">−</text><text class="qty-num-sm" wx:if="{{item._qty>0}}">{{item._qty}}</text><text class="tea-card-btn" catchtap="incQty" data-pid="{{item.productId}}" data-name="{{item.name}}" data-price="{{item.price}}">{{item._qty>0?'+':'+ 加购'}}</text></view></view></view>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  </scroll-view>
  <bottom-nav active="home"></bottom-nav>
</view>

<!-- 门店选择弹窗 -->
<view class="modal-overlay" wx:if="{{showStoreModal}}" bindtap="hideStoreSelector">
  <view class="modal" catchtap><text class="modal-title">选择门店</text>
    <view class="store-option {{currentStore=='yilong' ? 'active' : ''}}" bindtap="selectStore" data-store="yilong" data-name="盈隆店"><text>📍 盈隆店</text><text wx:if="{{currentStore=='yilong'}}" style="color:#5D8A6B;">✓ 当前</text></view>
    <view class="store-option {{currentStore=='zhujiang' ? 'active' : ''}}" bindtap="selectStore" data-store="zhujiang" data-name="珠江新城店"><text>📍 珠江新城店</text><text wx:if="{{currentStore=='zhujiang'}}" style="color:#5D8A6B;">✓ 当前</text></view>
    <view class="store-option {{currentStore=='pazhou' ? 'active' : ''}}" bindtap="selectStore" data-store="pazhou" data-name="琶洲店"><text>📍 琶洲店</text><text wx:if="{{currentStore=='pazhou'}}" style="color:#5D8A6B;">✓ 当前</text></view>
    <view class="modal-close" bindtap="hideStoreSelector">关闭</view>
  </view>
</view>

<!-- 登录弹窗 -->
<view class="login-fullscreen" wx:if="{{showLoginModal}}">
  <view class="login-bg">
    <view class="login-card">
      <text class="login-card-title">{{loginMode=='login'?'登录':'注册'}}</text>
      <text class="login-card-sub">高岸茶室 · 会员中心</text>
      <view class="login-tabs"><text class="login-tab {{loginMode=='login'?'active':''}}" bindtap="switchLoginTab" data-mode="login">登录</text><text class="login-tab {{loginMode=='register'?'active':''}}" bindtap="switchLoginTab" data-mode="register">注册</text></view>
      <view wx:if="{{loginMode=='login'}}">
        <view class="login-type-tabs">
          <text class="login-type-tab {{loginType=='code'?'active':''}}" bindtap="switchLoginType" data-type="code">验证码登录</text>
          <text class="login-type-tab {{loginType=='pwd'?'active':''}}" bindtap="switchLoginType" data-type="pwd">密码登录</text>
        </view>
        <view class="form-item"><text class="form-label">手机号</text><input class="form-input" placeholder="请输入手机号" value="{{loginPhone}}" bindinput="onLoginPhone" /></view>
        <view wx:if="{{loginType=='code'}}" class="form-item"><text class="form-label">验证码</text><view class="code-row"><input class="form-input" placeholder="验证码" value="{{loginCode}}" bindinput="onLoginCode" /><view class="code-btn" bindtap="getVerifyCode">获取验证码</view></view></view>
        <view wx:else class="form-item"><text class="form-label">密码</text><input class="form-input" placeholder="请输入密码" password="{{true}}" bindinput="onLoginPassword" /></view>
        <view class="form-btn" bindtap="doLogin">登 录</view>
        <text class="form-switch" bindtap="switchLoginTab" data-mode="register">没有账号？立即注册 →</text>
      </view>
      <view wx:else>
        <view class="form-item"><text class="form-label">手机号</text><input class="form-input" placeholder="请输入手机号" bindinput="onRegPhone" /></view>
        <view class="form-item"><text class="form-label">验证码</text><view class="code-row"><input class="form-input" placeholder="验证码" /><view class="code-btn" bindtap="getVerifyCode">获取验证码</view></view></view>
        <view class="form-btn" bindtap="doRegister">注 册</view>
        <text class="form-switch" bindtap="switchLoginTab" data-mode="login">已有账号？立即登录 →</text>
        <text class="form-hint">注册后可在"我的"中补充昵称和密码</text>
      </view>
      <text class="login-hint">演示环境，任意手机号即可登录</text>
      <text class="form-switch staff-login-link" bindtap="goStaffLogin">🔐 员工/管理员登录 →</text>
    </view>
  </view>
</view>

<!-- 茶品详情弹窗 -->
<view class="pay-modal-overlay" wx:if="{{showDetail}}" bindtap="hideDetail">
  <view class="pay-modal" style="text-align:left;" catchtap>
    <view class="detail-img-area" style="background:{{detailProduct.bg}}">
      <text style="font-size:56px;">{{detailProduct.icon}}</text>
    </view>
    <text class="detail-name">{{detailProduct.name}}</text>
    <text class="detail-desc" style="margin-top:6px;">{{detailProduct.desc}}</text>
    <view class="detail-price-row">
      <text class="detail-price-label">单价</text>
      <text class="detail-price">¥{{detailProduct.price}}</text>
    </view>
    <view class="pay-modal-btns">
      <button class="pay-btn-cancel" bindtap="hideDetail">关闭</button>
      <button class="pay-btn-confirm" bindtap="addFromDetail">加入购物车</button>
    </view>
  </view>
</view>

<!-- 加载/错误 -->
<view class="loading-overlay" wx:if="{{loading}}"><view class="loading-spinner"></view><text class="loading-text">加载中...</text></view>
<view class="error-toast" wx:if="{{errorMsg}}" bindtap="clearError"><text>{{errorMsg}}</text></view>
