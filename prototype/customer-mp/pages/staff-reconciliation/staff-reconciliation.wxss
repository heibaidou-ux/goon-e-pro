.page { min-height:100vh; background:#f5f5f5; }
.header { display:flex; align-items:center; padding:14px 0; background:#fff; border-bottom:1px solid #f0f0f0; }
.header-title { font-size:18px; font-weight:700; }
.content { padding:0 0 60px; }
.date-row { display:flex; justify-content:space-between; align-items:center; padding:14px 0; background:#fff; }
.date-label { font-size:13px; color:#666; }
.date-picker { font-size:13px; color:#5D8A6B; font-weight:600; background:#F2F6F0; padding:6px 12px; border-radius:8px; }
.revenue-card { background:linear-gradient(135deg,#5D8A6B,#7BA88E); border-radius:16px; padding:20px; margin:12px 0; }
.rev-label { font-size:12px; color:rgba(255,255,255,.7); display:block; }
.rev-amount { font-size:36px; font-weight:800; color:#fff; display:block; margin:4px 0 16px; }
.rev-detail { display:flex; gap:12px; }
.rev-item { flex:1; background:rgba(255,255,255,.15); border-radius:10px; padding:10px; text-align:center; }
.ri-label { font-size:10px; color:rgba(255,255,255,.7); display:block; }
.ri-value { font-size:15px; font-weight:700; color:#fff; margin-top:2px; display:block; }
.section-title { font-size:13px; font-weight:600; color:#333; margin:16px 0 8px; display:block; }
.pay-list { background:#fff; border-radius:12px; overflow:hidden; }
.pay-row { display:flex; justify-content:space-between; padding:14px; border-bottom:1px solid #f5f5f5; font-size:13px; }
.pay-row:last-child { border-bottom:none; }
.pay-name { color:#333; }
.pay-amount { font-weight:600; color:#333; }
.extra-list { background:#fff; border-radius:12px; overflow:hidden; }
.extra-row { display:flex; justify-content:space-between; padding:14px; border-bottom:1px solid #f5f5f5; font-size:13px; }
.extra-row:last-child { border-bottom:none; }
.ex-label { color:#666; }
.ex-value { font-weight:600; }
.ex-value.warn { color:#e53935; }