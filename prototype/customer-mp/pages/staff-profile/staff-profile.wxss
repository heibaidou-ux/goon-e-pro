.profile-header { padding:32px 20px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; text-align:center; }
.avatar { font-size:48px; margin-bottom:8px; }
.name { font-size:20px; font-weight:700; display:block; }
.role { font-size:12px; opacity:.8; margin-top:4px; display:block; }
.menu-list { margin-top:12px; background:#fff; }
.menu-item { padding:16px 20px; border-bottom:1px solid #f5f5f5; font-size:15px; }
.logout-btn { margin:24px 16px; padding:14px; border-radius:16px; background:#fff; color:#e53935; border:1px solid #e53935; font-size:15px; width:calc(100% - 32px); text-align:center; }