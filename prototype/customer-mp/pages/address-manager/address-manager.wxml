<view class="page">
  <view class="header">
    <text class="back-btn" bindtap="goBack">←</text>
    <text class="header-title">📍 我的地址</text>
  </view>

  <view class="addr-list">
    <view class="addr-card" wx:for="{{addresses}}" wx:key="index">
      <view class="ac-left">
        <text class="ac-name">{{item.name}}</text>
        <text class="ac-phone">{{item.phone}}</text>
      </view>
      <text class="ac-addr">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
      <view class="ac-actions">
        <text class="ac-del" bindtap="deleteAddr" data-idx="{{index}}">删除</text>
      </view>
    </view>

    <view class="empty" wx:if="{{addresses.length==0}}">
      <text class="empty-icon">📍</text>
      <text class="empty-text">暂无地址</text>
    </view>

    <!-- 新增地址按钮 -->
    <view class="add-btn" bindtap="showAddForm">+ 新增地址</view>
  </view>

  <!-- 新增/编辑地址弹窗 -->
  <view class="modal-overlay" wx:if="{{showForm}}" bindtap="hideForm">
    <view class="modal" catchtap>
      <text class="modal-h3">{{editIdx>=0?'编辑地址':'新增地址'}}</text>
      <input class="form-input" placeholder="收件人" value="{{formName}}" bindinput="onFormName" />
      <input class="form-input" placeholder="手机号" value="{{formPhone}}" bindinput="onFormPhone" type="number" maxlength="11" />
      <picker mode="selector" range="{{provinces}}" bindchange="onProvinceChange">
        <view class="form-picker">{{formProvince || '选择省份'}} ▾</view>
      </picker>
      <picker mode="selector" range="{{cities}}" bindchange="onCityChange" wx:if="{{cities.length>0}}">
        <view class="form-picker">{{formCity || '选择城市'}} ▾</view>
      </picker>
      <picker mode="selector" range="{{districts}}" bindchange="onDistrictChange" wx:if="{{districts.length>0}}">
        <view class="form-picker">{{formDistrict || '选择区'}} ▾</view>
      </picker>
      <input class="form-input" placeholder="详细地址" value="{{formDetail}}" bindinput="onFormDetail" />
      <view class="modal-buttons">
        <button class="modal-btn cancel" bindtap="hideForm">取消</button>
        <button class="modal-btn confirm" bindtap="saveAddr">保存</button>
      </view>
    </view>
  </view>
</view>
