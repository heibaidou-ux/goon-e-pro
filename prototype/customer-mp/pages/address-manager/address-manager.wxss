.page{background:#f5f7fa;min-height:100vh}.header{display:flex;align-items:center;padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0}.back-btn{font-size:18px;padding-right:12px;color:#666}.header-title{font-size:17px;font-weight:700}.addr-list{padding:12px 16px 80px}.addr-card{background:#fff;border-radius:14px;padding:14px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.04)}.ac-left{display:flex;align-items:center;gap:10px;margin-bottom:6px}.ac-name{font-size:14px;font-weight:600;color:#333}.ac-phone{font-size:12px;color:#999}.ac-addr{font-size:12px;color:#666;display:block;line-height:1.5}.ac-actions{text-align:right;margin-top:6px}.ac-del{font-size:12px;color:#d54941;padding:4px 8px}.empty{text-align:center;padding:60px 20px;color:#ccc}.empty-icon{font-size:48px;display:block;margin-bottom:12px}.empty-text{font-size:14px}.add-btn{display:block;text-align:center;padding:14px;border:2px dashed #ddd;border-radius:14px;font-size:14px;color:#5D8A6B;font-weight:600;background:#fff;margin-top:8px}.add-btn:active{background:#f9fafb}.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center}.modal{background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw}.modal-h3{font-size:17px;font-weight:700;text-align:center;display:block;margin-bottom:16px}.form-input{width:100%;height:42px;line-height:38px;padding:0 12px;border:1.5px solid #e5e5e5;border-radius:10px;font-size:14px;margin-bottom:10px;box-sizing:border-box}.form-picker{padding:10px 12px;border:1.5px solid #e5e5e5;border-radius:10px;font-size:13px;margin-bottom:10px;text-align:center;color:#333}.modal-buttons{display:flex;gap:10px;margin-top:16px}.modal-btn{flex:1;padding:12px;border-radius:14px;font-size:14px;font-weight:600;text-align:center;border:none}.modal-btn.cancel{background:#f5f5f5;color:#666}.modal-btn.confirm{background:#5D8A6B;color:#fff}
