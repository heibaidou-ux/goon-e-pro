.page{background:#f5f7fa;min-height:100vh}
.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0}
.header-title{font-size:18px;font-weight:700}
.room-select{padding:12px 16px;background:#fff}
.rs-trigger{padding:10px 14px;border:1.5px solid #e0d8d0;border-radius:12px;text-align:center;font-size:14px;color:#333;background:#f9fafb}
.device-list{padding:12px 16px}
.device-card{display:flex;align-items:center;justify-content:space-between;background:#fff;border-radius:14px;padding:14px 16px;margin-bottom:8px;box-shadow:0 2px 8px rgba(0,0,0,.04)}
.dc-left{display:flex;align-items:center;gap:10px}
.dc-icon{font-size:22px}
.dc-name{font-size:14px;font-weight:500;display:block}
.dc-status{font-size:10px;padding:1px 6px;border-radius:4px;display:inline-block;margin-top:2px}
.dc-status.Online{background:#e8f5e9;color:#00a870}
.dc-status.Offline{background:#fce4e4;color:#e53935}
.ac-mini{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:#333}
