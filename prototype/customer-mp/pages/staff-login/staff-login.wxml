<view class="page"><view class="logo"><view class="logo-icon">🏢</view><view class="logo-name">高岸ERP</view><view class="logo-sub">店员工作台</view></view><view class="form"><view class="form-group"><text class="form-label">用户名</text><input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsername" /></view><view class="form-group"><text class="form-label">密码</text><input class="form-input" password="{{true}}" placeholder="请输入密码" value="{{password}}" bindinput="onPassword" /></view><button class="login-btn" disabled="{{!username || !password}}" bindtap="doLogin" loading="{{loading}}">登 录</button><view class="error-msg" hidden="{{!error}}">{{error}}</view><view class="hint">演示账号：任意用户名 + 密码 8888</view></view></view>