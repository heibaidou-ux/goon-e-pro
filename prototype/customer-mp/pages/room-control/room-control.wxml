<view class="phone">
  <view class="nav-bar">
    <text class="nav-title">{{roomName}}</text>
  </view>
  <view class="page">
    <!-- 房间状态栏 -->
    <view class="room-info-bar {{roomStatus}}">
      <view class="room-info-left">
        <text class="room-info-name">{{roomName}}</text>
        <text class="room-info-slot" wx:if="{{roomStatus=='inuse'}}">当前预订时段 {{orderSlot}}</text>
        <text class="room-info-slot" wx:if="{{roomStatus=='idle'}}">{{roomStatusLabel}}</text>
        <text class="room-info-slot" wx:if="{{roomStatus=='booked'}}">已预订 {{orderSlot}}</text>
      </view>
      <view class="room-info-right" wx:if="{{roomStatus=='inuse'}}">
        <text class="countdown">{{countdown}}</text>
        <text class="room-info-end">剩余</text>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-cards">
      <view class="qcard renew" bindtap="showExtend">
        <text class="qcard-icon">⏱</text>
        <text class="qcard-label">续订</text>
      </view>
      <view class="qcard tea" bindtap="goTeaShop">
        <text class="qcard-icon">🍵</text>
        <text class="qcard-label">茶品</text>
      </view>
    </view>

    <!-- 空调 -->
    <view class="device-section" wx:if="{{acDevice}}">
      <text class="section-label">❄️ 空调</text>
      <view class="ac-card">
        <view class="ac-main">
          <view class="ac-temp-area">
            <text class="ac-up" bindtap="acTempUp" data-id="{{acDevice.deviceId}}">▲</text>
            <text class="ac-temp-num">{{acDevice.temperature}}°</text>
            <text class="ac-down" bindtap="acTempDown" data-id="{{acDevice.deviceId}}">▼</text>
            <text class="ac-temp-status">{{acModeLabel}}</text>
          </view>
          <view class="ac-ctrl-area">
            <view class="ac-mode-row">
              <view class="ac-mode-btn {{acDevice.mode == 'cool' ? 'active' : ''}}" bindtap="setACMode" data-id="{{acDevice.deviceId}}" data-mode="cool"><text class="mode-icon">❄️</text><text class="mode-label">制冷</text></view>
              <view class="ac-mode-btn {{acDevice.mode == 'heat' ? 'active' : ''}}" bindtap="setACMode" data-id="{{acDevice.deviceId}}" data-mode="heat"><text class="mode-icon">🔥</text><text class="mode-label">制热</text></view>
              <view class="ac-mode-btn {{acDevice.mode == 'fan' ? 'active' : ''}}" bindtap="setACMode" data-id="{{acDevice.deviceId}}" data-mode="fan"><text class="mode-icon">🌀</text><text class="mode-label">送风</text></view>
            </view>
            <view class="ac-power-bar">
              <view class="ac-power-btn {{acDevice.mode != 'off' ? 'on' : ''}}" bindtap="toggleAC" data-id="{{acDevice.deviceId}}">
                ⏻ {{acDevice.mode != 'off' ? '关机' : '开机'}}
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 设备按键（灯光+风扇） -->
    <view class="device-section" wx:if="{{devKeys.length>0}}">
      <view class="dev-grid">
        <view class="switch-key {{item.active ? 'on' : ''}}" wx:for="{{devKeys}}" wx:key="key" bindtap="onKeyTap" data-key="{{item.key}}" data-type="{{item.type}}">
          <text class="key-icon">{{item.icon}}</text>
          <text class="key-label">{{item.label}}</text>
          <view class="key-indicator {{item.active ? 'on' : ''}}"></view>
        </view>
      </view>
    </view>

    <!-- 窗帘 -->
    <view class="device-section" wx:if="{{curtainDevices.length>0}}">
      <text class="section-label">🪟 窗帘</text>
      <view class="curtain-card">
        <view class="curtain-item" wx:for="{{curtainDevices}}" wx:key="deviceId">
          <text class="curtain-name">{{item.label}}</text>
          <view class="curtain-bar">
            <text class="curtain-end">关闭</text>
            <slider value="{{item.positionNum}}" min="0" max="100" activeColor="#FFC107" backgroundColor="#555" block-color="#FFC107" bindchanging="onCurtainChange" data-id="{{item.deviceId}}" />
            <text class="curtain-end">打开</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 背景音乐 -->
    <view class="device-section" wx:if="{{bgmDevice}}">
      <text class="section-label">🎵 背景音乐</text>
      <view class="bgm-card">
        <view class="bgm-row">
          <text class="bgm-icon">🎵</text>
          <text class="bgm-status">{{bgmDevice.playing ? '播放中' : '已暂停'}}</text>
          <view class="bgm-switch {{bgmDevice.playing ? 'on' : ''}}" bindtap="toggleBGM" data-id="{{bgmDevice.deviceId}}">
            <view class="bgm-switch-knob"></view>
          </view>
        </view>
        <view class="bgm-vol-row">
          <text>🔈</text>
          <slider value="{{bgmDevice.volume}}" min="0" max="100" activeColor="#FFC107" backgroundColor="#555" block-color="#FFC107" bindchanging="onBGMVolumeChange" data-id="{{bgmDevice.deviceId}}" />
          <text class="bgm-vol-num">{{bgmDevice.volume}}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 续订弹窗 -->
  <view class="modal-overlay" wx:if="{{showExtendModal}}" bindtap="hideExtend">
    <view class="modal" catchtap="preventBubble">
      <text class="modal-title">续订包间</text>
      <text class="modal-desc">{{extendInfo}}</text>
      <view class="extend-grid">
        <view class="extend-option {{selectedExtendIdx===index ? 'selected' : ''}}" wx:for="{{extendOptions}}" wx:key="index" bindtap="selectExtend" data-index="{{index}}">
          <text class="ext-time">{{item.label}}</text>
          <text class="ext-price">+{{item.minutes}}分 ¥{{item.price}}</text>
        </view>
      </view>
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideExtend">取消</view>
        <view class="modal-btn primary {{selectedExtendIdx<0 ? 'disabled' : ''}}" bindtap="confirmExtend">确认续订</view>
      </view>
    </view>
  </view>

  <!-- 续订支付确认 -->
  <view class="modal-overlay" wx:if="{{showExtendPayModal}}" bindtap="cancelExtendPay">
    <view class="modal pay-modal" catchtap="preventBubble">
      <text class="modal-title">确认续订支付</text>
      <text class="modal-desc">{{extendPayInfo}}</text>
      <text class="extend-pay-amount">¥{{extendPayAmount}}</text>
      <view class="pay-methods-section">
        <text class="pay-section-title">选择支付方式</text>
        <view class="pay-method {{extendPayMethod=='wechat'?'selected':''}}" bindtap="selectExtendPay" data-pay="wechat">
          <image class="pay-method-icon wechat-pay-icon" src="/images/wxpay-logo.png" mode="aspectFit"></image>
          <view class="pay-method-info"><text class="pay-method-name">微信支付</text></view>
          <text class="pay-method-check" wx:if="{{extendPayMethod=='wechat'}}">✓</text>
        </view>
        <view class="pay-method {{extendPayMethod=='balance'?'selected':''}}" bindtap="selectExtendPay" data-pay="balance">
          <text class="pay-method-icon">💰</text>
          <view class="pay-method-info"><text class="pay-method-name">会员余额</text><text class="pay-method-desc">¥{{balance}}</text></view>
          <text class="pay-method-check" wx:if="{{extendPayMethod=='balance'}}">✓</text>
        </view>
      </view>
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="cancelExtendPay">取消</view>
        <view class="modal-btn primary" bindtap="doExtendPayment">确认支付</view>
      </view>
    </view>
  </view>

  <bottom-nav wx:if="{{!hideBottomNav}}" active="home"></bottom-nav>
</view>
