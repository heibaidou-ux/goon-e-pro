<view class="page"><view class="room-header">{{roomName}} 智控</view><view class="scene-grid"><view class="scene-btn" wx:for="{{scenes}}" wx:key="sceneId" style="background:{{item.color}}20; border-color:{{item.color}}" bindtap="activateScene" data-id="{{item.sceneId}}"><text style="font-size:20px">{{item.icon}}</text><text style="font-size:12px; margin-top:4px; color:{{item.color}}">{{item.name}}</text></view></view><text class="section-title">设备控制</text><view class="device-list"><view class="device-item" wx:for="{{devices}}" wx:key="deviceId"><view class="device-icon">{{item.typeIcon || '📡'}}</view><view class="device-info"><text class="device-name">{{item.typeLabel || item.type}}</text><text class="device-status {{item.status === 'Online' ? 'online' : 'offline'}}">{{item.status === 'Online' ? '在线' : '离线'}}</text></view><view class="device-control" wx:if="{{item.type === 'Light'}}"><slider value="{{item.brightness || 0}}" min="0" max="100" show-value bindchanging="onLightChange" data-id="{{item.deviceId}}" /></view><switch wx:elif="{{item.type === 'AC'}}" checked="{{item.mode === 'cool'}}" bindchange="onAcToggle" data-id="{{item.deviceId}}" /><switch wx:elif="{{item.type === 'Speaker'}}" checked="{{item.playing}}" bindchange="onSpeakerToggle" data-id="{{item.deviceId}}" /><switch wx:elif="{{item.type === 'Curtain'}}" checked="{{item.position === 'open'}}" bindchange="onCurtainToggle" data-id="{{item.deviceId}}" /></view></view></view>