<view class="phone">
  <view class="nav-bar">
    <text class="nav-title">{{roomName}}</text>
  </view>
  <view class="page">
    <!-- 订单时间+剩余时间 -->
    <view class="room-info-bar">
      <view class="room-info-left">
        <text class="room-info-name">{{roomName}}</text>
        <text class="room-info-slot">{{orderSlot}}</text>
      </view>
      <view class="room-info-right">
        <text class="countdown">{{countdown}}</text>
        <text class="room-info-end">剩余</text>
      </view>
    </view>

    <!-- 两大操作按钮 -->
    <view class="action-btns">
      <view class="action-btn renew" bindtap="showExtend">
        <text class="action-icon">🕐</text>
        <text class="action-text">续订</text>
      </view>
      <view class="action-btn tea" bindtap="goTeaShop">
        <text class="action-icon">🍵</text>
        <text class="action-text">茶品</text>
      </view>
    </view>

    <!-- 设备控制 -->
    <text class="section-title">设备控制</text>
    <view class="device-list">
      <view class="device-item" wx:for="{{devices}}" wx:key="deviceId">
        <text class="device-icon">{{item.typeIcon}}</text>
        <view class="device-info">
          <text class="device-name">{{item.typeLabel}}</text>
        </view>
        <switch wx:if="{{item.type=='Lock'}}" checked="{{item.locked!==false}}" bindchange="onLockToggle" data-id="{{item.deviceId}}" />
        <view wx:elif="{{item.type=='AC'}}" class="ac-ring">
          <text class="ac-temp">{{item.temperature||24}}°</text>
          <slider value="{{item.temperature||24}}" min="16" max="30" activeColor="#5D8A6B" backgroundColor="#d0d0d0" block-color="#5D8A6B" bindchanging="onTempChange" data-id="{{item.deviceId}}" />
          <switch checked="{{item.mode=='cool'}}" bindchange="onAcToggle" data-id="{{item.deviceId}}" />
        </view>
        <switch wx:elif="{{item.type=='Light'}}" checked="{{item.brightness>0}}" bindchange="onLightToggle" data-id="{{item.deviceId}}" />
        <slider wx:elif="{{item.type=='Curtain'}}" value="{{item.position=='open'?100:item.positionNum||0}}" min="0" max="100" activeColor="#5D8A6B" backgroundColor="#d0d0d0" block-color="#5D8A6B" show-value bindchanging="onCurtainChange" data-id="{{item.deviceId}}" />
        <switch wx:elif="{{item.type=='Speaker'}}" checked="{{item.playing}}" bindchange="onSpeakerToggle" data-id="{{item.deviceId}}" />
      </view>
    </view>
  </view>

  <!-- 续订弹窗 -->
  <view class="modal-overlay" wx:if="{{showExtendModal}}" bindtap="hideExtend">
    <view class="modal" catchtap="">
      <text class="modal-title">续订包间</text>
      <text class="modal-desc">{{extendInfo}}</text>
      <view class="extend-grid">
        <view class="extend-option {{selectedExtendIdx===index ? 'selected' : ''}}" wx:for="{{extendOptions}}" wx:key="index" bindtap="selectExtend" data-index="{{index}}">
          <text class="ext-time">{{item.label}}</text>
          <text class="ext-price">+{{item.minutes}}分 ¥{{item.price}}</text>
        </view>
      </view>
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideExtend">取消</view>
        <view class="modal-btn primary {{selectedExtendIdx<0 ? 'disabled' : ''}}" bindtap="confirmExtend">确认续订</view>
      </view>
    </view>
  </view>

  <!-- 续订支付确认 -->
  <view class="modal-overlay" wx:if="{{showExtendPayModal}}" bindtap="cancelExtendPay">
    <view class="modal" catchtap="">
      <text class="modal-title">确认续订支付</text>
      <text class="modal-desc">{{extendPayInfo}}</text>
      <text class="extend-pay-amount">¥{{extendPayAmount}}</text>
      <text class="extend-pay-hint">从账户余额扣除</text>
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="cancelExtendPay">取消</view>
        <view class="modal-btn primary" bindtap="doExtendPayment">确认支付</view>
      </view>
    </view>
  </view>
</view>
