page { background:#f0f2ef; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; display:flex; flex-direction:column; background:#f5f5f5; }
.nav-bar { display:flex; align-items:center; padding:12px 0; background:#fff; }
.nav-title { flex:1; text-align:center; font-size:16px; font-weight:600; }
.page { flex:1; overflow-y:auto; padding-bottom:60px; }
.room-info-bar { display:flex; justify-content:space-between; align-items:center; padding:14px 0; background:#5D8A6B; color:#fff; }
.room-info-left { }
.room-info-name { font-size:18px; font-weight:700; display:block; }
.room-info-slot { font-size:12px; opacity:.85; margin-top:2px; display:block; }
.room-info-right { display:flex; flex-direction:column; align-items:flex-end; }
.countdown { font-size:24px; font-weight:700; display:block; }
.room-info-end { font-size:10px; opacity:.7; display:block; }
.action-btns { display:flex; gap:12px; padding:16px 0; background:#f5f5f5; margin-bottom:12px; }
.action-btn { flex:1; padding:20px; border-radius:16px; text-align:center; }
.action-btn.renew { background:#5D8A6B; }
.action-btn.tea { background:#7B1FA2; }
.action-icon { font-size:28px; display:block; margin-bottom:4px; }
.action-text { font-size:16px; font-weight:700; color:#fff; }
.section-title { font-size:14px; font-weight:600; color:#333; padding:12px 0 8px; display:block; }
.device-list { padding:0; }
.device-item { display:flex; align-items:center; padding:14px 12px; background:#ffffff; border-radius:14px; margin-bottom:8px; border:1px solid #e0ddd8; box-shadow:0 1px 4px rgba(0,0,0,.04); }
.device-icon { font-size:22px; margin-right:10px; flex-shrink:0; width:30px; text-align:center; }
.device-info { flex-shrink:0; min-width:60px; }
.device-name { font-size:14px; font-weight:500; display:block; }
.device-status { font-size:11px; display:block; }
.device-status.online { color:#00A870; }
.device-status.offline { color:#e53935; }
.device-item switch { margin-left:auto; }
.device-item slider { flex:1; min-width:70px; margin-left:10px; }
.ac-ring { display:flex; align-items:center; gap:6px; flex:1; min-width:0; }
.ac-ring switch { margin-left:auto; }
.ac-ring slider { flex:1; min-width:60px; }
.ac-temp { font-size:18px; font-weight:700; color:#333; min-width:32px; text-align:center; flex-shrink:0; }

/* 续订弹窗 */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw;text-align:center; }
.modal-title { font-size:16px;font-weight:600;display:block;margin-bottom:8px; }
.modal-desc { font-size:13px;color:#666;margin-bottom:16px;display:block;line-height:1.5; }
.modal-buttons { display:flex;gap:10px;margin-top:16px; }
.modal-btn { flex:1;padding:12px;border-radius:16px;font-size:14px;font-weight:600;text-align:center; }
.modal-btn.cancel { background:#f5f5f5;color:#666; }
.modal-btn.primary { background:#5D8A6B;color:#fff; }
.modal-btn.disabled { opacity:.4; }
.extend-grid { display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px; }
.extend-option { padding:12px 6px;border-radius:12px;border:1.5px solid #e5e5e5;background:#fff;text-align:center; }
.extend-option.selected { background:#5D8A6B;color:#fff;border-color:#5D8A6B; }
.extend-option:active { border-color:#5D8A6B; }
.ext-time { font-size:12px;font-weight:600;display:block; }
.ext-price { font-size:10px;display:block;margin-top:2px;opacity:.8; }
.extend-option.selected .ext-price { color:#fff; }
.extend-pay-amount { font-size:28px;font-weight:800;color:#B8860B;display:block;margin:8px 0; }
.extend-pay-hint { font-size:12px;color:#999;display:block; }
