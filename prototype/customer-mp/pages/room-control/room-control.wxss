page { background:#f0f2ef; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; display:flex; flex-direction:column; background:#f5f5f5; }
.nav-bar { display:flex; align-items:center; padding:12px 0; background:#fff; }
.nav-title { flex:1; text-align:center; font-size:16px; font-weight:600; }
.page { flex:1; overflow-y:auto; padding-bottom:60px; }
.room-info-bar { display:flex; justify-content:space-between; align-items:center; padding:16px 0; background:#5D8A6B; color:#fff; }
.room-info-name { font-size:18px; font-weight:700; display:block; }
.room-info-time { font-size:12px; opacity:.9; }
.countdown { font-size:20px; font-weight:700; }
.room-info-end { font-size:11px; opacity:.7; }
.action-btns { display:flex; gap:12px; padding:16px 0; background:#f5f5f5; margin-bottom:12px; }
.action-btn { flex:1; padding:20px; border-radius:16px; text-align:center; }
.action-btn.renew { background:#5D8A6B; }
.action-btn.tea { background:#7B1FA2; }
.action-icon { font-size:28px; display:block; margin-bottom:4px; }
.action-text { font-size:16px; font-weight:700; color:#fff; }
.section-title { font-size:14px; font-weight:600; color:#333; padding:12px 0 8px; display:block; }
.device-list { padding:0; }
.device-item { display:flex; align-items:center; padding:14px 12px; background:#ffffff; border-radius:14px; margin-bottom:8px; border:1px solid #e0ddd8; box-shadow:0 1px 4px rgba(0,0,0,.04); }
.device-icon { font-size:22px; margin-right:10px; flex-shrink:0; width:30px; text-align:center; }
.device-info { flex-shrink:0; min-width:60px; }
.device-name { font-size:14px; font-weight:500; display:block; }
.device-status { font-size:11px; display:block; }
.device-status.online { color:#00A870; }
.device-status.offline { color:#e53935; }
.device-item switch { margin-left:auto; }
.device-item slider { flex:1; min-width:70px; margin-left:10px; }
.ac-ring { display:flex; align-items:center; gap:6px; flex:1; min-width:0; }
.ac-ring switch { margin-left:auto; }
.ac-ring slider { flex:1; min-width:60px; }
.ac-temp { font-size:18px; font-weight:700; color:#333; min-width:32px; text-align:center; flex-shrink:0; }
