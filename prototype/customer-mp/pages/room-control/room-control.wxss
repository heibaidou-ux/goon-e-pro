page { background:#f0f2ef; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; display:flex; flex-direction:column; background:#f5f5f5; }
.nav-bar { display:flex; align-items:center; padding:12px 16px; background:#fff; }
.nav-title { flex:1; text-align:center; font-size:16px; font-weight:600; }
.page { flex:1; overflow-y:auto; padding:0 16px 16px; }

/* 订单信息栏 */
.room-info-bar { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; margin:0 -16px; }
.room-info-left { flex:1; min-width:0; margin-right:12px; }
.room-info-name { font-size:18px; font-weight:700; display:block; }
.room-info-slot { font-size:12px; opacity:.85; margin-top:2px; display:block; }
.room-info-right { display:flex; flex-direction:column; align-items:flex-end; }
.countdown { font-size:24px; font-weight:700; display:block; }
.room-info-end { font-size:10px; opacity:.7; display:block; }

/* 快捷卡片 */
.quick-cards { display:flex; gap:12px; padding:16px 0; }
.qcard { flex:1; padding:18px; border-radius:16px; text-align:center; display:flex; flex-direction:column; align-items:center; gap:6px; }
.qcard.renew { background:linear-gradient(135deg,#5D8A6B,#00a854); color:#fff; box-shadow:0 4px 14px rgba(7,193,96,.25); }
.qcard.tea { background:linear-gradient(135deg,#7c4dff,#651fff); color:#fff; box-shadow:0 4px 14px rgba(124,77,255,.2); }
.qcard-icon { font-size:28px; }
.qcard-label { font-size:14px; font-weight:600; }

/* 设备分组标题 */
.device-group { margin-bottom:16px; }
.group-title { font-size:14px; font-weight:600; color:#333; margin-bottom:10px; display:block; }
.group-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }

/* 设备卡片 — 灯光/风扇/换气扇 */
.device-card { background:#fff; border-radius:14px; padding:16px; display:flex; flex-direction:column; align-items:center; gap:6px; border:1.5px solid #eee; transition:all .2s; }
.device-card:active { transform:scale(.96); }
.device-card.on { border-color:#5D8A6B; background:#F2F6F0; }
.dc-icon { font-size:28px; }
.dc-label { font-size:12px; font-weight:600; color:#333; }
.dc-toggle { width:36px; height:20px; border-radius:10px; background:#ddd; position:relative; transition:all .2s; }
.dc-toggle.on { background:#5D8A6B; }
.dc-toggle-knob { width:16px; height:16px; border-radius:50%; background:#fff; position:absolute; top:2px; left:2px; box-shadow:0 1px 3px rgba(0,0,0,.15); transition:all .2s; }
.dc-toggle.on .dc-toggle-knob { left:18px; }

/* 空调 */
.ac-card { background:#fff; border-radius:14px; padding:20px; text-align:center; border:1.5px solid #eee; }
.ac-display { margin-bottom:16px; }
.ac-temp { font-size:48px; font-weight:800; color:#333; display:block; line-height:1.1; }
.ac-mode { font-size:12px; color:#999; margin-top:2px; display:block; }
.ac-controls { display:flex; align-items:center; justify-content:center; gap:20px; margin-bottom:16px; }
.ac-btn { width:44px; height:44px; border-radius:50%; background:#f0f0f0; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:700; color:#333; }
.ac-btn:active { background:#e0e0e0; }
.ac-temp-val { font-size:22px; font-weight:700; color:#5D8A6B; min-width:48px; text-align:center; }
.ac-power { padding:10px; border-radius:12px; background:#f0f0f0; font-size:13px; font-weight:600; color:#666; cursor:pointer; }
.ac-power.on { background:#e8f5e9; color:#5D8A6B; }

/* 窗帘 */
.curtain-list { background:#fff; border-radius:14px; padding:12px 16px; border:1.5px solid #eee; }
.curtain-item { margin:8px 0; }
.curtain-label { font-size:13px; font-weight:600; color:#333; margin-bottom:4px; display:block; }
.curtain-slider-wrap { display:flex; align-items:center; gap:8px; }
.curtain-slider-wrap slider { flex:1; }
.slider-end { font-size:11px; color:#999; white-space:nowrap; }

/* 背景音乐 */
.bgm-card { background:linear-gradient(135deg,#f5f0ff,#ede7f6); border-radius:14px; padding:16px; border:1.5px solid #e8e0f0; }
.bgm-header { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
.bgm-icon { font-size:28px; }
.bgm-status { flex:1; font-size:13px; font-weight:600; color:#333; }
.bgm-toggle { width:40px; height:22px; border-radius:11px; background:#ddd; position:relative; transition:all .2s; flex-shrink:0; }
.bgm-toggle.on { background:#7c4dff; }
.bgm-toggle-knob { width:18px; height:18px; border-radius:50%; background:#fff; position:absolute; top:2px; left:2px; box-shadow:0 1px 3px rgba(0,0,0,.15); transition:all .2s; }
.bgm-toggle.on .bgm-toggle-knob { left:20px; }
.bgm-volume-row { display:flex; align-items:center; gap:8px; }
.vol-icon { font-size:14px; }
.bgm-volume-row slider { flex:1; }
.vol-num { font-size:12px; color:#666; min-width:36px; text-align:right; }

/* 续订弹窗（复用已有样式） */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw;text-align:center; }
.modal-title { font-size:16px;font-weight:600;display:block;margin-bottom:8px; }
.modal-desc { font-size:13px;color:#666;margin-bottom:16px;display:block;line-height:1.5; }
.modal-buttons { display:flex;gap:10px;margin-top:16px; }
.modal-btn { flex:1;padding:12px;border-radius:16px;font-size:14px;font-weight:600;text-align:center; }
.modal-btn.cancel { background:#f5f5f5;color:#666; }
.modal-btn.primary { background:#5D8A6B;color:#fff; }
.modal-btn.disabled { opacity:.4; }
.extend-grid { display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px; }
.extend-option { padding:12px 6px;border-radius:12px;border:1.5px solid #e5e5e5;background:#fff;text-align:center; }
.extend-option.selected { background:#5D8A6B;color:#fff;border-color:#5D8A6B; }
.extend-option:active { border-color:#5D8A6B; }
.ext-time { font-size:12px;font-weight:600;display:block; }
.ext-price { font-size:10px;display:block;margin-top:2px;opacity:.8; }
.extend-option.selected .ext-price { color:#fff; }
.extend-pay-amount { font-size:28px;font-weight:800;color:#B8860B;display:block;margin:8px 0; }
.pay-modal { width:340px; max-width:90vw; }
.pay-methods-section { margin:12px 0; }
.pay-section-title { font-size:13px;font-weight:600;color:#333;margin-bottom:8px;display:block;text-align:left; }
.pay-method { display:flex;align-items:center;padding:12px;border:2px solid #e0d8d0;border-radius:12px;background:#fff;gap:10px;margin-bottom:8px; }
.pay-method.selected { border-color:#5D8A6B;background:#F2F6F0; }
.pay-method-icon { font-size:22px;width:32px;text-align:center; }
.pay-method-info { flex:1; }
.pay-method-name { font-size:14px;font-weight:500;display:block; }
.pay-method-desc { font-size:11px;color:#999;margin-top:1px;display:block; }
.pay-method-check { font-size:16px;color:#5D8A6B; }
