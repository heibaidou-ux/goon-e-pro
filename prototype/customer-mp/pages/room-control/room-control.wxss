page { background:#FAF8F5; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif; }
.phone { width:100%; height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#FAF8F5; }
.nav-bar { display:flex; align-items:center; padding:12px 16px; background:#fff; }
.nav-title { flex:1; text-align:center; font-size:16px; font-weight:600; }
.page {min-height:0; flex:1; overflow-y:auto; }

/* 订单信息�?*/
.room-info-bar { display:flex; justify-content:space-between; align-items:center; padding:18px 20px; color:#fff; margin:0 -16px; }
.room-info-bar.inuse { background:linear-gradient(135deg,#5D8A6B,#7BA88E); }
.room-info-bar.idle { background:linear-gradient(135deg,#7A8B8B,#A3B5B5); }
.room-info-bar.booked { background:linear-gradient(135deg,#9C27B0,#BA68C8); }
.room-info-left { flex:1; min-width:0; margin-right:12px; }
.room-info-name { font-size:18px; font-weight:700; display:block; }
.room-info-slot { font-size:12px; opacity:.85; margin-top:2px; display:block; }
.room-info-right { display:flex; flex-direction:column; align-items:flex-end; }
.countdown { font-size:24px; font-weight:700; display:block; }
.room-info-end { font-size:10px; opacity:.7; display:block; }

/* 快捷卡片 */
.quick-cards { display:flex; gap:12px; padding:16px 16px; }
.qcard { flex:1; padding:16px; border-radius:14px; text-align:center; }
.qcard.renew { background:#5D8A6B; color:#fff; }
.qcard.tea { background:#7BA88E; color:#fff; }
.qcard-icon { font-size:24px; display:block; margin-bottom:2px; }
.qcard-label { font-size:13px; font-weight:600; }

/* 设备分区 */
.device-section { margin-bottom:16px; padding:0 16px; }
.section-label { font-size:14px; font-weight:600; color:#333; margin-bottom:10px; display:block; }

/* 2列网格 · 浅绿按键+茶色图标 */
.dev-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.switch-key { background:#f0faf2; border-radius:14px; padding:16px 14px; border:1.5px solid #d4e8d9; display:flex; align-items:center; gap:12px; transition:all .15s; }
.switch-key:active { transform:scale(.95); }
.switch-key.on { border-color:#5D8A6B; background:#e8f5e9; }
.key-icon { font-size:24px; display:flex; align-items:center; justify-content:center; color:#7BA88E; line-height:1; flex-shrink:0; width:32px; height:32px; text-align:center; }
.switch-key.on .key-icon { color:#5D8A6B; }
.key-label { font-size:14px; font-weight:500; color:#555; display:block; letter-spacing:1px; flex:1; text-align:left; }
.switch-key.on .key-label { color:#2C6B3F; }
.key-indicator { width:6px; height:6px; border-radius:50%; background:#ccc; display:inline-block; flex-shrink:0; margin-left:auto; }
.key-indicator.on { background:#5D8A6B; box-shadow:0 0 6px rgba(93,138,107,.5); }

/* 空调 · 与灯光按键统一浅绿 */
.ac-card { background:#f0faf2; border-radius:14px; padding:20px; border:1.5px solid #d4e8d9; }
.ac-main { display:flex; align-items:center; gap:20px; }
.ac-temp-area { display:flex; flex-direction:column; align-items:center; flex-shrink:0; min-width:90px; }
.ac-up { font-size:14px; color:#5D8A6B; padding:10px 14px; cursor:pointer; opacity:.7; font-weight:700; }
.ac-up:active { opacity:1; }
.ac-temp-num { font-size:52px; font-weight:200; color:#333; display:block; line-height:1; letter-spacing:-2px; }
.ac-down { font-size:14px; color:#5D8A6B; padding:10px 14px; cursor:pointer; opacity:.7; font-weight:700; }
.ac-down:active { opacity:1; }
.ac-temp-status { font-size:11px; color:#888; display:block; margin-top:6px; letter-spacing:1px; }
.ac-ctrl-area { flex:1; display:flex; flex-direction:column; justify-content:center; padding:4px 0; gap:10px; }
.ac-mode-row { display:flex; gap:8px; }
.ac-mode-btn { flex:1; padding:10px 6px; border-radius:12px; background:#fff; border:1.5px solid #d4e8d9; text-align:center; letter-spacing:1px; display:flex; flex-direction:column; align-items:center; gap:2px; }
.ac-mode-btn.active { background:#e8f5e9; border-color:#5D8A6B; }
.mode-icon { font-size:20px; display:block; line-height:1.2; }
.mode-label { font-size:12px; font-weight:500; color:#666; display:block; }
.ac-mode-btn.active .mode-label { color:#5D8A6B; }
.ac-power-bar { border-top:1px solid #d4e8d9; padding-top:10px; }
.ac-power-btn { padding:10px; border-radius:10px; font-size:13px; font-weight:500; color:#666; text-align:center; letter-spacing:1px; }
.ac-power-btn.on { color:#5D8A6B; }

/* 窗帘 */
.curtain-card { background:#f0faf2; border-radius:14px; padding:16px; border:1.5px solid #d4e8d9; }
.curtain-item { margin:8px 0; }
.curtain-name { font-size:13px; font-weight:500; color:#555; margin-bottom:4px; display:block; letter-spacing:1px; }
.curtain-bar { display:flex; align-items:center; gap:6px; }
.curtain-bar slider { flex:1; }
.curtain-end { font-size:10px; color:#999; white-space:nowrap; }

/* 背景音乐 */
.bgm-card { background:#f0faf2; border-radius:14px; padding:16px; border:1.5px solid #d4e8d9; }
.bgm-row { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.bgm-icon { font-size:22px; }
.bgm-status { flex:1; font-size:12px; font-weight:500; color:#555; letter-spacing:1px; }
.bgm-switch { width:36px; height:20px; border-radius:10px; background:#ccc; position:relative; transition:all .2s; flex-shrink:0; }
.bgm-switch.on { background:#5D8A6B; }
.bgm-switch-knob { width:16px; height:16px; border-radius:50%; background:#fff; position:absolute; top:2px; left:2px; box-shadow:0 1px 3px rgba(0,0,0,.15); transition:all .2s; }
.bgm-switch.on .bgm-switch-knob { left:18px; }
.bgm-vol-row { display:flex; align-items:center; gap:8px; font-size:12px; }
.bgm-vol-row slider { flex:1; }
.bgm-vol-num { font-size:11px; color:#666; min-width:30px; text-align:right; }

/* 续订弹窗 */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw;text-align:center; }
.modal-title { font-size:16px;font-weight:600;display:block;margin-bottom:8px; }
.modal-desc { font-size:13px;color:#666;margin-bottom:16px;display:block;line-height:1.5; }
.modal-buttons { display:flex;gap:10px;margin-top:16px; }
.modal-btn { flex:1;padding:12px;border-radius:16px;font-size:14px;font-weight:600;text-align:center; }
.modal-btn.cancel { background:#f5f5f5;color:#666; }
.modal-btn.primary { background:#5D8A6B;color:#fff; }
.modal-btn.disabled { opacity:.4; }
.extend-grid { display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px; }
.extend-option { padding:12px 6px;border-radius:12px;border:1.5px solid #e5e5e5;background:#fff;text-align:center; }
.extend-option.selected { background:#5D8A6B;color:#fff;border-color:#5D8A6B; }
.extend-option:active { border-color:#5D8A6B; }
.ext-time { font-size:12px;font-weight:600;display:block; }
.ext-price { font-size:10px;display:block;margin-top:2px;opacity:.8; }
.extend-option.selected .ext-price { color:#fff; }
.extend-pay-amount { font-size:28px;font-weight:800;color:#B8860B;display:block;margin:8px 0; }
.pay-modal { width:340px; max-width:90vw; }
.pay-methods-section { margin:12px 0; }
.pay-section-title { font-size:13px;font-weight:600;color:#333;margin-bottom:8px;display:block;text-align:left; }
.pay-method { display:flex;align-items:center;padding:12px;border:2px solid #e0d8d0;border-radius:12px;background:#fff;gap:10px;margin-bottom:8px; }
.pay-method.selected { border-color:#5D8A6B;background:#F2F6F0; }
.pay-method-icon { font-size:22px;width:32px;text-align:center; }
.pay-method-info { flex:1; }
.pay-method-name { font-size:14px;font-weight:500;display:block; }
.pay-method-desc { font-size:11px;color:#999;margin-top:1px;display:block; }
.pay-method-check { font-size:16px;color:#5D8A6B; }

