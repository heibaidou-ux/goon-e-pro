.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; }
.header-title { font-size:18px; font-weight:700; }
.room-grid { padding:12px 16px; }
.room-card { display:flex; align-items:center; padding:14px; background:#fff; border-radius:10px; margin-bottom:8px; }
.room-status-dot { width:10px; height:10px; border-radius:50%; margin-right:12px; flex-shrink:0; }
.room-info { flex:1; }
.room-name { font-size:15px; font-weight:600; display:block; }
.room-type { font-size:11px; color:#999; display:block; margin-top:2px; }
.room-right { text-align:right; }
.room-status-label { font-size:13px; font-weight:600; display:block; }
.room-order-info { font-size:11px; color:#999; display:block; margin-top:2px; }