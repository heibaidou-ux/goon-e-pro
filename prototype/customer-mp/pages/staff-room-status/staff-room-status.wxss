.phone { height:100vh; overflow:hidden; display:flex; flex-direction:column; background:#f5f7fa; }
.page { flex:1; overflow-y:auto; }.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0;display:flex;justify-content:space-between;align-items:center}.header-title{font-size:18px;font-weight:700}.header-stats{font-size:12px;color:#999}.legend-bar{display:flex;align-items:center;gap:12px;padding:10px 16px;background:#fff;border-bottom:1px solid #f0f0f0;font-size:11px}.legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}.legend-dot.inuse{background:#00a870}.legend-dot.booked{background:#9c27b0}.legend-dot.free{background:#ddd}.legend-label{color:#999;margin-right:8px}.room-grid{padding:12px 16px}.room-card{background:#fff;border-radius:14px;padding:14px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);border-left:4px solid #eee}.room-card.inuse{border-left-color:#00a870}.room-card.booked{border-left-color:#9c27b0}.room-card.free{border-left-color:#ddd}.rc-top{display:flex;align-items:center;gap:8px;margin-bottom:6px}.rc-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:none}.rc-name{font-size:15px;font-weight:600;flex:1}.rc-type{font-size:11px;color:#999}.rc-status{font-size:12px;font-weight:600}.rc-status.inuse{color:#00a870}.rc-status.booked{color:#9c27b0}.rc-status.free{color:#999}.rc-order{background:#f9fafb;border-radius:8px;padding:8px 10px;margin-top:6px;display:flex;justify-content:space-between;align-items:center}.rc-customer{font-size:12px;color:#333;font-weight:500}.rc-time{font-size:11px;color:#999}.rc-actions{display:flex;gap:6px;margin-top:8px}.rca-btn{padding:6px 14px;border-radius:8px;font-size:12px;font-weight:600}.rca-btn:active{opacity:.8}.room-card.free .rca-btn{background:#5D8A6B;color:#fff}.room-card.inuse .rca-btn{background:#5D8A6B;color:#fff}.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center}.modal{background:#fff;border-radius:16px;padding:24px;width:340px;max-width:90vw;max-height:85vh;overflow-y:auto}.modal-title{font-size:16px;font-weight:600;display:block;margin-bottom:16px;text-align:center}.form-section{margin-bottom:12px}.form-label{font-size:12px;color:#666;display:block;margin-bottom:4px}.form-input{width:100%;height:42px;line-height:38px;padding:0 12px;border:1.5px solid #e5e5e5;border-radius:10px;font-size:14px;box-sizing:border-box}.form-picker{width:100%;height:42px;line-height:38px;padding:0 12px;border:1.5px solid #e5e5e5;border-radius:10px;font-size:13px;text-align:center;color:#333;box-sizing:border-box;background:#fff}.form-row{display:flex;gap:10px}.modal-btns{display:flex;gap:10px;margin-top:16px}.m-btn{flex:1;padding:12px;border-radius:14px;font-size:14px;font-weight:600;text-align:center}.m-btn.cancel{background:#f5f5f5;color:#666}.m-btn.primary{background:#5D8A6B;color:#fff}
