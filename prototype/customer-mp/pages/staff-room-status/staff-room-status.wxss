.page{background:#f5f7fa;min-height:100vh}.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0}.header-title{font-size:18px;font-weight:700}.room-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:16px}.room-card{background:#fff;border-radius:16px;padding:20px 12px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.04);display:flex;flex-direction:column;align-items:center;gap:4px}.room-card:active{opacity:.8}.rc-icon{font-size:32px}.rc-name{font-size:14px;font-weight:600;color:#333}.rc-status{font-size:11px;padding:3px 10px;border-radius:10px}.rc-time{font-size:10px;color:#999;margin-top:2px}.room-card.inuse{border:2px solid #00a870}.room-card.inuse .rc-status{background:#e8f5e9;color:#00a870}.room-card.booked{border:2px solid #9c27b0}.room-card.booked .rc-status{background:#f3e5f5;color:#9c27b0}.room-card.available .rc-status{background:#f5f5f5;color:#999}
