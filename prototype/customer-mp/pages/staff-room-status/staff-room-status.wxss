.page{background:#f5f7fa;min-height:100vh;padding-bottom:60px}.header{padding:14px 16px;background:#fff;border-bottom:1px solid #f0f0f0;display:flex;justify-content:space-between;align-items:center}.header-title{font-size:18px;font-weight:700}.header-stats{font-size:12px;color:#999}.legend-bar{display:flex;align-items:center;gap:12px;padding:10px 16px;background:#fff;border-bottom:1px solid #f0f0f0;font-size:11px}.legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}.legend-dot.inuse{background:#00a870}.legend-dot.booked{background:#9c27b0}.legend-dot.free{background:#ddd}.legend-label{color:#999;margin-right:8px}.room-grid{padding:12px 16px}.room-card{background:#fff;border-radius:14px;padding:14px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);border-left:4px solid #eee}.room-card.inuse{border-left-color:#00a870}.room-card.booked{border-left-color:#9c27b0}.room-card.free{border-left-color:#ddd}.rc-top{display:flex;align-items:center;gap:8px;margin-bottom:6px}.rc-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:none}.rc-name{font-size:15px;font-weight:600;flex:1}.rc-type{font-size:11px;color:#999}.rc-status{font-size:12px;font-weight:600}.rc-status.inuse{color:#00a870}.rc-status.booked{color:#9c27b0}.rc-status.free{color:#999}.rc-order{background:#f9fafb;border-radius:8px;padding:8px 10px;margin-top:6px;display:flex;justify-content:space-between;align-items:center}.rc-customer{font-size:12px;color:#333;font-weight:500}.rc-time{font-size:11px;color:#999}.rc-actions{margin-top:8px}.rca-btn{display:inline-block;padding:6px 16px;border-radius:8px;background:#5D8A6B;color:#fff;font-size:12px;font-weight:600}
