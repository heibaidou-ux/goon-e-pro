<view class="page">
  <view class="header"><text class="header-title">🏠 房态管理</text></view>
  <view class="room-grid">
    <view class="room-card {{item.statusClass}}" wx:for="{{rooms}}" wx:key="roomId" bindtap="goRoom" data-roomid="{{item.roomId}}">
      <text class="rc-icon">{{item.icon}}</text>
      <text class="rc-name">{{item.name}}</text>
      <text class="rc-status">{{item.statusLabel}}</text>
      <text class="rc-time" wx:if="{{item.time}}">{{item.time}}</text>
    </view>
  </view>
</view>
