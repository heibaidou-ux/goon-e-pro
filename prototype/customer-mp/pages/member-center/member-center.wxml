<view class="phone">
  <view class="page">
    <!-- 首充特惠横幅 -->
    <view class="promo-banner" bindtap="showTopup">
      <view>
        <text class="promo-text"><text class="promo-em">🎉 首充特惠</text> · 首次充值享7折 + 赠优惠券包</text>
      </view>
      <text class="promo-tag">立即参与 →</text>
    </view>

    <!-- 蓝色会员卡片 -->
    <view class="member-card">
      <view class="member-avatar">👤</view>
      <view style="text-align:center;">
        <text class="member-name">{{userName}}</text>
        <text class="member-level"><text class="level-badge gold">🥇 {{levelLabel}}</text></text>
      </view>
      <view class="member-balance">
        <view style="display:flex;align-items:center;justify-content:center;gap:6px;">
          <text class="balance-icon-text">{{balanceIcon}}</text>
          <text class="balance-label-text">余额</text>
          <text class="balance-amount-text">{{balanceDisplay}}</text>
          <text class="eye-icon" bindtap="toggleBalance">{{balanceVisible?'👁':'👁‍🗨'}}</text>
        </view>
      </view>
      <view class="member-stats">
        <view class="stat-item"><text class="stat-num">{{visitCount}}</text><text class="stat-label">预订次数</text></view>
        <view class="stat-item"><text class="stat-num">¥{{totalSpent}}</text><text class="stat-label">累计消费</text></view>
        <view class="stat-item"><text class="stat-num">{{points}}</text><text class="stat-label">会员积分</text></view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="actions-card">
      <view class="action-row" bindtap="goOrders"><text>📋 我的订单</text><text class="arrow">›</text></view>
      <view class="action-row" bindtap="goCoupons"><text>🎫 我的优惠券</text><text class="arrow">›</text></view>
      <view class="action-row" bindtap="showTopup"><text>💳 余额充值</text><text class="arrow">›</text></view>
      <view class="action-row" bindtap="showAccountSettings"><text>⚙ 账户设置</text><text class="arrow">›</text></view>
    </view>

    <!-- 会员权益 -->
    <view class="benefits-card">
      <text class="benefits-title">🏅 会员权益</text>
      <view class="benefit-row"><text class="benefit-icon">💰</text><text>包间消费享 9 折优惠</text></view>
      <view class="benefit-row"><text class="benefit-icon">🎂</text><text>生日当月免费赠送茶点一份</text></view>
      <view class="benefit-row"><text class="benefit-icon">🎫</text><text>每月获赠 2 张满减优惠券</text></view>
      <view class="benefit-row"><text class="benefit-icon">⭐</text><text>消费 1 元累计 1 积分，积分可兑换商品</text></view>
      <view class="benefit-row"><text class="benefit-icon">📅</text><text>优先预约权 · 可提前 7 天预约</text></view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-wrap"><button class="logout-btn" bindtap="handleLogout">退出登录</button></view>
  </view>

  <!-- 充值弹窗 -->
  <view class="modal-overlay" wx:if="{{showRechargeModal}}" bindtap="hideRecharge">
    <view class="modal" catchtap="preventBubble">
      <text class="modal-h3">💳 充值</text>
      <text class="modal-promo">首充享7折优惠，最高减¥300</text>
      <view class="amount-grid">
        <view class="amount-btn {{selectedAmount==100?'active':''}}" bindtap="selectAmount" data-amount="100">¥100</view>
        <view class="amount-btn {{selectedAmount==200?'active':''}}" bindtap="selectAmount" data-amount="200">¥200</view>
        <view class="amount-btn {{selectedAmount==500?'active':''}}" bindtap="selectAmount" data-amount="500">¥500</view>
        <view class="amount-btn {{selectedAmount==1000?'active':''}}" bindtap="selectAmount" data-amount="1000">¥1000</view>
      </view>
      <text class="recharge-bonus-text">充值 {{selectedAmount}} 可得 ¥{{selectedAmount * 1.3}}</text>
      <text class="modal-label">选择支付方式</text>
      <view class="payment-option {{selectedPayment=='WeChat'?'active':''}}" bindtap="selectPayment" data-payment="WeChat">💚 微信支付</view>
      <view class="payment-option {{selectedPayment=='AliPay'?'active':''}}" bindtap="selectPayment" data-payment="AliPay">💙 支付宝</view>
      <view class="payment-option {{selectedPayment=='BankCard'?'active':''}}" bindtap="selectPayment" data-payment="BankCard">🏦 银行卡</view>
      <view class="payment-option {{selectedPayment=='Cash'?'active':''}}" bindtap="selectPayment" data-payment="Cash">💵 现金（到店付）</view>
      <view class="modal-buttons">
        <button class="modal-btn cancel" bindtap="hideRecharge">取消</button>
        <button class="modal-btn confirm" bindtap="confirmRecharge">确认充值</button>
      </view>
    </view>
  </view>

  <!-- 账户设置弹窗 -->
  <view class="modal-overlay" wx:if="{{showSettingsModal}}" bindtap="hideAccountSettings">
    <view class="modal settings-modal" catchtap="preventBubble">
      <text class="modal-h3">⚙ 账户设置</text>
      <view class="settings-section">
        <text class="settings-section-title">个人信息</text>
        <view class="settings-row"><text class="settings-label">昵称</text><input class="settings-input" value="{{userName}}" bindinput="onNameInput" placeholder="请输入昵称" /></view>
        <view class="settings-row"><text class="settings-label">手机号</text><text class="settings-value">{{userPhone}}</text></view>
      </view>
      <view class="settings-section">
        <text class="settings-section-title">安全设置</text>
        <view class="settings-row" bindtap="changePassword"><text class="settings-label">修改密码</text><text class="arrow">›</text></view>
        <view class="settings-row" bindtap="clearAccount"><text class="settings-label danger-text">清除本地数据</text><text class="arrow">›</text></view>
      </view>
      <view class="modal-buttons">
        <button class="modal-btn cancel" bindtap="hideAccountSettings">取消</button>
        <button class="modal-btn confirm" bindtap="saveAccountSettings">保存设置</button>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  <bottom-nav active="profile" />
</view>
