<view class="phone">
  <view class="profile-header">
    <view class="avatar">👤</view>
    <view class="profile-info">
      <text class="profile-name">{{userName}}</text>
      <text class="profile-level">{{levelLabel}}</text>
    </view>
  </view>

  <view class="balance-card">
    <view class="balance-item">
      <text class="balance-label">
        余额
        <text class="eye-icon" bindtap="toggleBalance">{{balanceVisible ? '👁' : '👁‍🗨'}}</text>
      </text>
      <text class="balance-value">{{balanceDisplay}}</text>
    </view>
    <view class="balance-divider"></view>
    <view class="balance-item"><text class="balance-label">累计消费</text><text class="balance-value">¥{{totalSpent}}</text></view>
    <view class="balance-divider"></view>
    <view class="balance-item"><text class="balance-label">到店次数</text><text class="balance-value">{{visitCount}}次</text></view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goOrders"><text>📋 我的订单</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goCoupons"><text>🎫 我的优惠券</text><text class="arrow">›</text></view>
  </view>

  <!-- 第8条：充值中心不隐藏，一直显示 -->
  <view class="recharge-section">
    <view class="recharge-header">
      <text class="recharge-title">💰 充值中心</text>
      <text class="recharge-bonus">首充赠送30%</text>
    </view>
    <view class="amount-grid">
      <view class="amount-btn {{selectedAmount==100 ? 'active' : ''}}" bindtap="selectAmount" data-amount="100">¥100</view>
      <view class="amount-btn {{selectedAmount==200 ? 'active' : ''}}" bindtap="selectAmount" data-amount="200">¥200</view>
      <view class="amount-btn {{selectedAmount==500 ? 'active' : ''}}" bindtap="selectAmount" data-amount="500">¥500</view>
      <view class="amount-btn {{selectedAmount==1000 ? 'active' : ''}}" bindtap="selectAmount" data-amount="1000">¥1000</view>
    </view>
    <text class="recharge-bonus-detail">充值 {{selectedAmount}} 可得 ¥{{selectedAmount * 1.3}}</text>
    <button class="recharge-btn" bindtap="doRecharge">立即充值</button>
  </view>

  <!-- 第9条：支付方式选择弹窗 -->
  <view class="modal-overlay" wx:if="{{showPaymentModal}}" bindtap="cancelPayment">
    <view class="modal" catchtap="">
      <text class="modal-title">选择支付方式</text>
      <view class="payment-option {{selectedPayment=='WeChat'?'active':''}}" bindtap="selectPayment" data-payment="WeChat">💚 微信支付</view>
      <view class="payment-option {{selectedPayment=='AliPay'?'active':''}}" bindtap="selectPayment" data-payment="AliPay">💙 支付宝</view>
      <view class="payment-option {{selectedPayment=='Balance'?'active':''}}" bindtap="selectPayment" data-payment="Balance">💰 余额支付</view>
      <view class="payment-confirm-btns">
        <button class="payment-btn cancel" bindtap="cancelPayment">取消</button>
        <button class="payment-btn confirm" bindtap="confirmRecharge">确认充值 ¥{{selectedAmount}}</button>
      </view>
    </view>
  </view>
</view>
