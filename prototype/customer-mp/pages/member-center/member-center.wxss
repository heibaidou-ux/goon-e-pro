page { background:#f5f7fa; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; background:#f5f7fa; display:flex; flex-direction:column;  }
.page { flex:1; overflow-y:auto; padding:0 0 60px; }

/* 首充�?*/
.promo-banner { background:linear-gradient(135deg,#B8860B,#f5a623); padding:14px 16px; color:#fff; display:flex; align-items:center; justify-content:space-between; }
.promo-text { font-size:13px; font-weight:500; }
.promo-em { font-size:16px; font-weight:600; }
.promo-tag { background:rgba(255,255,255,.2); padding:4px 12px; border-radius:12px; font-size:11px; }

/* 会员�?�?品牌绿色 */
.member-card { background:linear-gradient(135deg,#5D8A6B,#8bba94); padding:24px 16px; color:#fff; }
.member-avatar { width:64px; height:64px; border-radius:50%; background:rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; font-size:28px; margin:0 auto 12px; }
.member-name { text-align:center; font-size:18px; font-weight:700; margin-bottom:4px; display:block; }
.member-level { display:table; margin:0 auto; }
.level-badge { display:inline-block; padding:4px 16px; border-radius:12px; background:rgba(255,255,255,.2); font-size:12px; color:#fff; }
.member-balance { text-align:center; margin-top:16px; }
.balance-icon-text { font-size:20px; }
.balance-label-text { font-size:12px; opacity:.8; }
.balance-amount-text { font-size:36px; font-weight:800; }
.eye-icon { font-size:14px; cursor:pointer; opacity:.8; }
.member-stats { display:flex; gap:12px; margin-top:16px; }
.stat-item { flex:1; text-align:center; background:rgba(255,255,255,.15); border-radius:10px; padding:10px; }
.stat-num { font-size:18px; font-weight:700; display:block; }
.stat-label { font-size:10px; opacity:.8; margin-top:2px; display:block; }

/* 功能菜单 */
.actions-card { background:#fff; padding:16px 16px; margin:12px 0; }
.action-row { display:flex; align-items:center; justify-content:space-between; padding:12px 0; border-bottom:1px solid #f5f5f5; font-size:14px; color:#333; }
.action-row:last-child { border-bottom:none; }
.action-row .arrow { color:#ccc; }

/* 会员权益 */
.benefits-card { background:#fff; padding:16px 16px; margin:0 0 12px; }
.benefits-title { font-size:15px; font-weight:600; color:#333; margin-bottom:12px; display:block; }
.benefit-row { display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid #f5f5f5; font-size:13px; color:#666; }
.benefit-row:last-child { border-bottom:none; }
.benefit-icon { font-size:20px; width:28px; text-align:center; }

/* 退�?*/
.logout-wrap { padding:0 16px 20px; }
.logout-btn { width:100%; padding:14px; background:#fff; color:#d54941; border:1.5px solid #d54941; border-radius:16px; font-size:15px; font-weight:600; text-align:center; }

/* 充值弹�?*/
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.modal { background:#fff;border-radius:16px;padding:24px;width:320px;text-align:center; }
.modal-h3 { font-size:18px;font-weight:700;color:#333;margin-bottom:8px;display:block; }
.modal-promo { font-size:12px;color:#B8860B;background:#fff8e1;padding:6px 12px;border-radius:8px;display:inline-block;margin-bottom:12px; }
.modal-label { font-size:13px;color:#666;display:block;margin:12px 0 8px;text-align:left; }
.amount-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:8px; }
.amount-btn { padding:12px;border:1.5px solid #e5e5e5;border-radius:16px;text-align:center;font-size:14px;font-weight:600; }
.amount-btn.active { border-color:#5D8A6B;background:#f0fdf4;color:#5D8A6B; }
.recharge-bonus-text { font-size:11px;color:#999;display:block;margin-bottom:8px; }
.payment-option { padding:12px 14px;border:1.5px solid #e5e5e5;border-radius:16px;margin-bottom:8px;font-size:14px;text-align:left; }
.payment-option.active { border-color:#5D8A6B;background:#f0fdf4;color:#5D8A6B; }
.modal-buttons { display:flex;gap:10px;margin-top:16px; }
.modal-btn { flex:1;padding:12px;border-radius:16px;font-size:14px;font-weight:600;text-align:center;border:none; }
.modal-btn.confirm { background:#5D8A6B;color:#fff; }
.modal-btn.cancel { background:#f5f5f5;color:#666; }

/* 账户设置弹窗 */
.settings-modal { text-align:left; width:340px; max-width:90vw; }
.settings-section { margin-bottom:16px; }
.settings-section-title { font-size:13px; font-weight:600; color:#333; display:block; margin-bottom:8px; padding-bottom:4px; border-bottom:1px solid #f0f0f0; }
.settings-row { display:flex; align-items:center; justify-content:space-between; padding:10px 0; }
.settings-label { font-size:14px; color:#666; flex-shrink:0; }
.settings-input { flex:1; text-align:right; height:36px; line-height:32px; padding:0 10px; border:1px solid #e5e5e5; border-radius:8px; font-size:14px; color:#333; margin-left:12px; }
.settings-value { font-size:14px; color:#333; }
.danger-text { color:#d54941; }

