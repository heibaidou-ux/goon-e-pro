/* 高岸茶室 · 会员中心 — 温润质感 */
page { background:#FAF8F5; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif; }
.phone { width:100%; height:100vh; overflow:hidden; background:#FAF8F5; display:flex; flex-direction:column; }
.page {min-height:0; flex:1; overflow-y:auto; }

/* ── 首充特惠横幅 ── */
.promo-banner { background:linear-gradient(135deg,#B8860B,#D4A84B); padding:14px 20px; color:#fff; display:flex; align-items:center; justify-content:space-between; }
.promo-text { font-size:13px; font-weight:500; }
.promo-em { font-weight:700; }
.promo-tag { font-size:12px; background:rgba(255,255,255,.2); padding:4px 12px; border-radius:16px; flex-shrink:0; }

/* ── 会员卡片 ── */
.member-card { background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; margin:0; border-radius:0; padding:24px 20px; box-shadow:0 8px 24px rgba(93,138,107,.3); }
.member-avatar { width:64px; height:64px; border-radius:50%; background:rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; margin:0 auto 8px; border:2px solid rgba(255,255,255,.35); overflow:hidden; }
.avatar-img { width:100%; height:100%; }
.avatar-text { font-size:28px; font-weight:700; color:#fff; }
.member-name { font-size:18px; font-weight:700; display:block; text-align:center; letter-spacing:.5px; }
.member-level { display:block; text-align:center; margin-top:2px; }
.level-badge { font-size:11px; padding:2px 12px; border-radius:10px; display:inline-block; }
.level-badge.gold { background:rgba(255,255,255,.2); }

.member-balance { background:rgba(255,255,255,.12); border-radius:12px; padding:12px; margin:10px 0 0; }
.balance-icon-text { font-size:18px; }
.balance-label-text { font-size:12px; opacity:.8; }
.balance-amount-text { font-size:24px; font-weight:800; letter-spacing:1px; }
.eye-icon { font-size:16px; opacity:.7; padding:2px; }

.member-stats { display:flex; gap:8px; margin-top:12px; }
.stat-item { flex:1; background:rgba(255,255,255,.1); border-radius:12px; padding:10px 4px; text-align:center; }
.stat-num { font-size:18px; font-weight:700; display:block; }
.stat-label { font-size:10px; opacity:.7; display:block; margin-top:2px; }

/* ── 板块分隔 ── */
.block-divider { height:8px; background:#f0ece6; margin:0; }

/* ── 功能菜单 ── */
.actions-card { background:#fff; margin:0; padding:4px 0; }
.action-row { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; border-bottom:1px solid #f0ece6; font-size:14px; color:#2C2C2C; }
.action-row:last-child { border-bottom:none; }
.action-row:active { background:#f9fafb; }
.arrow { color:#ccc; font-size:16px; }

/* ── 会员权益 ── */
.benefits-card { background:#fff; margin:0; padding:16px 20px; }
.benefits-title { font-size:15px; font-weight:600; color:#333; display:block; margin-bottom:12px; }
.benefit-row { display:flex; align-items:center; gap:8px; padding:8px 0; font-size:13px; color:#666; border-bottom:1px solid #f5f5f5; }
.benefit-row:last-child { border-bottom:none; }
.benefit-icon { font-size:16px; width:24px; text-align:center; }

/* ── 退出登录 ── */
.logout-wrap { padding:16px 20px; }
.logout-btn { width:100%; padding:14px; border-radius:14px; border:1.5px solid #D54941; background:#fff; color:#D54941; font-size:15px; font-weight:600; text-align:center; }
.logout-btn:active { background:#fff5f5; }

/* ── 充值弹窗 ── */
.modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:99;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s; }
.modal { background:#fff;border-radius:20px;padding:24px;width:320px;max-width:90vw;text-align:center;animation:scaleIn .25s; }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
@keyframes scaleIn { from{opacity:0;transform:scale(.9)} to{opacity:1;transform:scale(1)} }
.modal-h3 { font-size:17px;font-weight:700;display:block;margin-bottom:4px;color:#1a1a1a; }
.modal-promo { font-size:12px;color:#B8860B;display:block;margin-bottom:16px; }
.amount-grid { display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px; }
.amount-btn { padding:14px;border-radius:14px;border:1.5px solid #e0d8d0;background:#fff;font-size:16px;font-weight:600;color:#333;transition:all .15s; }
.amount-btn:active { border-color:#5D8A6B; }
.amount-btn.active { border-color:#5D8A6B;background:#f0faf2;color:#5D8A6B; }
.recharge-bonus-text { font-size:12px;color:#B8860B;display:block;margin-bottom:12px; }
.modal-label { font-size:13px;font-weight:600;color:#333;display:block;margin-bottom:8px;text-align:left; }
.payment-option { display:flex;align-items:center;gap:8px;padding:12px;border-radius:12px;border:1.5px solid #e0d8d0;margin-bottom:6px;font-size:13px;font-weight:500; }
.payment-option:active { border-color:#5D8A6B; }
.payment-option.active { border-color:#5D8A6B;background:#f0faf2;color:#5D8A6B; }
.modal-buttons { display:flex;gap:10px;margin-top:16px; }
.modal-btn { flex:1;padding:12px;border-radius:12px;font-size:14px;font-weight:600;text-align:center; }
.modal-btn.cancel { background:#f5f5f5;color:#666; }
.modal-btn.confirm { background:linear-gradient(135deg,#5D8A6B,#7BA88E);color:#fff; }

/* ── 设置弹窗 ── */
.settings-modal { text-align:left; }
.settings-section { margin-bottom:16px; }
.settings-section-title { font-size:13px;font-weight:600;color:#999;margin-bottom:8px;display:block;text-transform:uppercase;letter-spacing:1px; }
.settings-row { display:flex;align-items:center;padding:12px 0;border-bottom:1px solid #f5f5f5; }
.settings-label { font-size:14px;color:#333;flex:1; }
.settings-value { font-size:13px;color:#999; }
.danger-text { color:#D54941; }
