<view class="page"><view class="filter-bar"><view class="filter-tab {{filterType === '' ? 'active' : ''}}" bindtap="setFilter" data-type="">全部</view><view class="filter-tab {{filterType === 'TeaRoom' ? 'active' : ''}}" bindtap="setFilter" data-type="TeaRoom">茶室</view><view class="filter-tab {{filterType === 'MeetingRoom' ? 'active' : ''}}" bindtap="setFilter" data-type="MeetingRoom">会议室</view><view class="filter-tab {{filterType === 'Exhibition' ? 'active' : ''}}" bindtap="setFilter" data-type="Exhibition">展厅</view></view><view class="room-grid"><view class="room-card" wx:for="{{filteredRooms}}" wx:key="roomId" bindtap="goDetail" data-id="{{item.roomId}}"><view class="room-img">{{item.type === 'TeaRoom' ? '🍵' : item.type === 'MeetingRoom' ? '💼' : '🏠'}}</view><view class="room-info"><text class="room-name">{{item.name}}</text><text class="room-meta">{{item.capacity}}人 · {{item.area}}㎡</text><text class="room-price">¥{{item.pricePerHour}}<text class="unit">/时</text></text></view><text class="room-arrow">›</text></view></view><view class="empty" wx:if="{{filteredRooms.length === 0}}">暂无符合条件的房间</view></view>