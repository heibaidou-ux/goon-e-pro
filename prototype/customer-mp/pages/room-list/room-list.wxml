<view class="phone">
  <view class="page">
    <view class="page-header">
      <text class="title">可预约包间</text>
      <text class="sub">选择包间，即刻预订</text>
    </view>
    <view class="room-section">
      <view class="room-card" wx:for="{{rooms}}" wx:key="roomId" bindtap="goRoom" data-roomid="{{item.roomId}}">
        <view class="room-card-img" style="background:{{item.bgColor}}">{{item.icon}}</view>
        <view class="room-card-body">
          <text class="room-card-name">{{item.name}}</text>
          <text class="room-card-meta">{{item.metaLine}}</text>
          <view class="room-card-footer">
            <text class="room-card-price">¥{{item.pricePerHour}}/时</text>
            <button class="room-card-book-btn" catchtap="goRoom" data-roomid="{{item.roomId}}">立即预约</button>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goHome"><text class="nav-icon">🏠</text><text class="nav-label">主页</text></view>
    <view class="nav-item active"><text class="nav-icon">📅</text><text class="nav-label">预订</text></view>
    <view class="nav-item" bindtap="goTeaShop"><text class="nav-icon">🍵</text><text class="nav-label">茶品</text></view>
    <view class="nav-item" bindtap="goOrders"><text class="nav-icon">📋</text><text class="nav-label">订单</text></view>
    <view class="nav-item" bindtap="goMember"><text class="nav-icon">👤</text><text class="nav-label">我的</text></view>
  </view>
</view>
