page { background:#f5f5f5; margin:0; padding:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.phone { width:100%; height:100vh; overflow:hidden; background:#fff; display:flex; flex-direction:column; }
.page { flex:1; overflow-y:auto; }
.page-header { padding:16px; border-bottom:1px solid #f0f0f0; background:#fff; }
.page-header .title { font-size:18px; font-weight:700; color:#1a1a1a; display:block; }
.page-header .sub { font-size:12px; color:#999; margin-top:8px; display:block; }
.room-section { padding:24px 16px; }
.room-card { display:flex; padding:14px; background:#f9fafb; margin-bottom:10px; border-radius:16px; }
.room-card:active { background:#f0f0f0; }
.room-card-img { width:80px; height:80px; border-radius:6px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:28px; }
.room-card-body { margin-left:12px; flex:1; display:flex; flex-direction:column; justify-content:space-between; }
.room-card-name { font-size:15px; font-weight:600; }
.room-card-meta { font-size:12px; color:#999; margin-top:2px; }
.room-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:4px; }
.room-card-price { font-size:16px; font-weight:700; color:#B8860B; }
.room-card-book-btn { padding:6px 14px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:12px; font-weight:600; }


