.filter-bar { display:flex; padding:12px 16px; gap:8px; background:#fff; border-bottom:1px solid #f0f0f0; }
.filter-tab { padding:6px 16px; border-radius:16px; font-size:13px; background:#f5f5f5; color:#666; }
.filter-tab.active { background:#5D8A6B; color:#fff; }
.room-grid { padding:12px 16px; }
.room-card { display:flex; align-items:center; padding:14px; background:#fff; border-radius:12px; margin-bottom:10px; box-shadow:0 1px 3px rgba(0,0,0,.05); }
.room-img { width:56px; height:56px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:28px; background:#f0f0f0; flex-shrink:0; }
.room-info { flex:1; margin-left:12px; }
.room-name { font-size:15px; font-weight:600; color:#333; display:block; }
.room-meta { font-size:12px; color:#999; margin-top:2px; display:block; }
.room-price { font-size:17px; font-weight:700; color:#B8860B; margin-top:4px; display:block; }
.room-price .unit { font-size:11px; font-weight:400; color:#999; }
.room-arrow { color:#ccc; font-size:20px; padding:0 4px; }
.empty { text-align:center; padding:60px; color:#ccc; font-size:14px; }