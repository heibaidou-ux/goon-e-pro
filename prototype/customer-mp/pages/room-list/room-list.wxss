page { background:#FAF8F5; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif; }
.phone { width:100%; height:100vh; overflow:hidden; background:#FAF8F5; display:flex; flex-direction:column; }
.page {min-height:0; flex:1; overflow-y:auto; }
.page-header { padding:16px; border-bottom:1px solid #f0ece6; background:#fff; }
.page-header .title { font-size:20px; font-weight:700; color:#1a1a1a; display:block; }
.page-header .sub { font-size:13px; color:#999; margin-top:4px; display:block; }
.room-section { padding:16px; }
.room-card { display:flex; padding:14px; background:#fff; margin-bottom:10px; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,.04); transition:all .15s; border:1px solid #f0ece6; }
.room-card:active { transform:scale(.98); border-color:#5D8A6B; }
.room-card-img { width:80px; height:80px; border-radius:12px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:28px; }
.room-card-body { margin-left:12px; flex:1; display:flex; flex-direction:column; justify-content:space-between; }
.room-card-name { font-size:15px; font-weight:600; color:#2C2C2C; }
.room-card-meta { font-size:12px; color:#999; margin-top:2px; display:flex; gap:4px; }
.room-card-meta .tag { background:#f5f5f5; padding:1px 6px; border-radius:4px; }
.room-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:6px; }
.room-card-price { font-size:17px; font-weight:700; color:#B8860B; }
.room-card-price .unit { font-size:12px; font-weight:400; color:#999; }
.room-card-book-btn { padding:8px 18px; border-radius:14px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; font-size:13px; font-weight:600; box-shadow:0 2px 8px rgba(93,138,107,.25); transition:all .15s; }
.room-card-book-btn:active { transform:scale(.95); }
