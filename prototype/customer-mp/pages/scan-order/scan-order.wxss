page { background:#f5f5f5; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; margin:0; padding:0; }
.page { flex:1; overflow-y:auto; padding-bottom:80px; }

/* Room banner */
.room-banner { background:linear-gradient(135deg,#f0fdf4,#e8f5e9); padding:12px 0; border-bottom:1px solid #dcedc8; display:flex; align-items:center; gap:8px; font-size:13px; color:#333; }

/* Category tabs */
.cat-tabs { display:flex; padding:10px 0; gap:8px; background:#fff; border-bottom:1px solid #f5f5f5; position:sticky; top:0; z-index:9; overflow-x:auto; }
.cat-tab { flex-shrink:0; padding:7px 18px; border-radius:18px; font-size:13px; cursor:pointer; background:#f5f5f5; color:#666; border:none; transition:all .15s; }
.cat-tab.active { background:#5D8A6B; color:#fff; }

/* Products */
.product-list { padding:10px 0; }
.product-card { display:flex; padding:12px; border-radius:16px; background:#fafafa; margin-bottom:10px; align-items:center; }
.product-img { width:52px; height:52px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:28px; flex-shrink:0; background:#f0f0f0; }
.product-body { flex:1; margin-left:12px; }
.product-name { font-size:14px; font-weight:600; color:#333; }
.product-desc { font-size:11px; color:#999; margin-top:2px; display:block; }
.product-footer { display:flex; justify-content:space-between; align-items:center; margin-top:6px; }
.product-price { font-size:16px; font-weight:700; color:#B8860B; }
.product-price .unit { font-size:11px; font-weight:400; color:#999; }

.qty-ctrl { display:flex; align-items:center; gap:8px; }
.qty-btn { width:28px; height:28px; border-radius:50%; border:1px solid #ddd; background:#fff; font-size:18px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#333; font-weight:600; }
.qty-btn:active { background:#f0f0f0; }
.qty-btn.disabled { opacity:.3; }
.qty-num { font-size:14px; font-weight:600; min-width:20px; text-align:center; color:#333; }

/* Empty state */
.empty-state { text-align:center; padding:60px 20px; }
.empty-text { font-size:14px; color:#ccc; }

/* Bottom bar */
.bottom-bar { position:fixed; bottom:0; left:0; right:0; background:#fff; border-top:1px solid #f0f0f0; padding:10px 0; display:flex; align-items:center; gap:12px; z-index:20; }
.bar-info { flex:1; }
.bar-count { font-size:12px; color:#999; display:block; }
.bar-total { font-size:18px; font-weight:700; color:#B8860B; }
.bar-btn { padding:12px 24px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border:none; border-radius:16px; font-size:15px; font-weight:600; cursor:pointer; white-space:nowrap; }
.bar-btn:active { opacity:.85; }

/* Overlay */
.overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); display:flex; align-items:flex-end; justify-content:center; z-index:30; }
.overlay.hidden { display:none; }

/* Action sheet (confirm) */
.action-sheet { background:#fff; border-radius:16px 16px 0 0; width:100%; max-width:430px; padding:24px 20px 30px; }
.sheet-title { font-size:16px; font-weight:600; text-align:center; margin-bottom:16px; display:block; }
.sheet-items { max-height:240px; overflow-y:auto; margin-bottom:16px; }
.sheet-item { display:flex; align-items:center; padding:10px 0; border-bottom:1px solid #f5f5f5; }
.sheet-item-name { flex:1; font-size:14px; }
.sheet-item-qty { color:#999; margin-right:16px; font-size:13px; }
.sheet-item-price { font-weight:600; color:#B8860B; font-size:14px; }
.sheet-total { display:flex; justify-content:space-between; padding:12px 0; border-top:1px solid #e8e8e8; font-size:16px; font-weight:600; }
.sheet-total-label { color:#666; }
.sheet-total-value { color:#B8860B; }
.sheet-hint { font-size:12px; color:#999; text-align:center; padding:10px 0; display:block; }
.sheet-btns { display:flex; gap:10px; margin-top:8px; }
.sheet-btn-cancel { flex:1; padding:14px; border-radius:16px; border:1px solid #ddd; background:#fff; font-size:15px; cursor:pointer; }
.sheet-btn-ok { flex:2; padding:14px; border-radius:16px; border:none; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; font-size:15px; font-weight:600; cursor:pointer; }
.sheet-btn-ok:active { opacity:.85; }

/* Success overlay */
.success-box { background:#fff; border-radius:16px; padding:40px 32px; text-align:center; width:300px; margin-bottom:60px; }
.success-icon { font-size:48px; display:block; margin-bottom:12px; }
.success-title { font-size:18px; font-weight:700; color:#333; margin-bottom:8px; display:block; }
.success-desc { font-size:14px; color:#999; margin-bottom:20px; line-height:1.5; display:block; }
.success-btn { padding:12px 0; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border:none; border-radius:16px; font-size:15px; font-weight:600; cursor:pointer; width:100%; margin-bottom:8px; }
.success-btn.outline { background:#fff; color:#5D8A6B; border:1.5px solid #5D8A6B; margin-top:0; }
.success-btn:active { opacity:.85; }
