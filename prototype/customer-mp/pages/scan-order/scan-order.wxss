page { background:#f5f5f5; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.phone { width:100%; max-width:100%; min-height:100vh; background:#fff; display:flex; flex-direction:column; position:relative; }
.page { flex:1; overflow-y:auto;  padding-bottom:80px; }
.page
/* Header */
.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; position:sticky; top:0; z-index:10; display:flex; align-items:center; gap:12px; }
.header-back { font-size:20px; cursor:pointer; padding:4px; color:#333; text-decoration:none; }
.header-title { font-size:17px; font-weight:700; color:#1a1a1a; flex:1; }
/* Room banner */
.room-banner { background:linear-gradient(135deg,#f0fdf4,#e8f5e9); padding:12px 16px; border-bottom:1px solid #dcedc8; display:flex; align-items:center; gap:8px; font-size:13px; color:#333; }
.room-banner-icon { font-size:18px; }
.room-banner-text { flex:1; }
.room-banner-text strong { color:#2e7d32; }
/* Category tabs */
.cat-tabs { display:flex; padding:10px 16px; gap:8px; background:#fff; border-bottom:1px solid #f5f5f5; position:sticky; top:56px; z-index:9; overflow-x:auto;  }
.cat-tabs
.cat-tab { flex-shrink:0; padding:7px 18px; border-radius:18px; font-size:13px; cursor:pointer; background:#f5f5f5; color:#666; border:none; transition:all .15s; }
.cat-tab.active { background:#0052D9; color:#fff; }
/* Products */
.product-list { padding:10px 16px; }
.product-card { display:flex; padding:12px; border-radius:16px; background:#fafafa; margin-bottom:10px; align-items:center; }
.product-img { width:52px; height:52px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:28px; flex-shrink:0; background:#f0f0f0; }
.product-page { flex:1; margin-left:12px; }
.product-name { font-size:14px; font-weight:600; color:#333; }
.product-desc { font-size:11px; color:#999; margin-top:2px; }
.product-footer { display:flex; justify-content:space-between; align-items:center; margin-top:6px; }
.product-price { font-size:16px; font-weight:700; color:#B8860B; }
.product-price .unit { font-size:11px; font-weight:400; color:#999; }
.qty-ctrl { display:flex; align-items:center; gap:8px; }
.qty-btn { width:26px; height:26px; border-radius:50%; border:1px solid #ddd; background:#fff; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#333; font-weight:600; }
.qty-btn:active { background:#f0f0f0; }
.qty-btn.disabled { opacity:.3; pointer-events:none; }
.qty-num { font-size:14px; font-weight:600; min-width:20px; text-align:center; color:#333; }
/* Bottom bar */
.bottom-bar { position:fixed; bottom:0; left:0; right:0; background:#fff; border-top:1px solid #f0f0f0; padding:10px 16px; display:flex; align-items:center; gap:12px; z-index:20; max-width:430px; margin:0 auto; }
.bottom-info { flex:1; }
.bottom-count { font-size:12px; color:#999; }
.bottom-total { font-size:18px; font-weight:700; color:#B8860B; }
.bottom-hint { font-size:11px; color:#bbb; margin-top:1px; }
.bottom-btn { padding:12px 24px; background:linear-gradient(135deg,#0052D9,#7BA88E); color:#fff; border:none; border-radius:16px; font-size:15px; font-weight:600; cursor:pointer; white-space:nowrap; }
.bottom-btn:active { opacity:.85; }
.bottom-btn.disabled { opacity:.5; pointer-events:none; }
/* Confirm dialog */
.confirm-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); display:none; align-items:flex-end; justify-content:center; z-index:30; }
.confirm-sheet { background:#fff; border-radius:16px 16px 0 0; width:100%; max-width:430px; padding:24px 20px; padding-bottom:30px; }
.confirm-title { font-size:16px; font-weight:600; text-align:center; margin-bottom:16px; }
.confirm-items { max-height:240px; overflow-y:auto; margin-bottom:16px; }
.confirm-item { display:flex; align-items:center; padding:10px 0; border-bottom:1px solid #f5f5f5; }
.confirm-item-name { flex:1; font-size:14px; }
.confirm-item-qty { color:#999; margin-right:16px; font-size:13px; }
.confirm-item-price { font-weight:600; color:#B8860B; font-size:14px; }
.confirm-total { display:flex; justify-content:space-between; padding:12px 0; border-top:1px solid #e8e8e8; font-size:16px; font-weight:600; }
.confirm-total .label { color:#666; }
.confirm-total .value { color:#B8860B; }
.confirm-hint { font-size:12px; color:#999; text-align:center; padding:10px 0; }
.confirm-btns { display:flex; gap:10px; margin-top:8px; }
.confirm-btn-cancel { flex:1; padding:14px; border-radius:16px; border:1px solid #ddd; background:#fff; font-size:15px; cursor:pointer; }
.confirm-btn-ok { flex:2; padding:14px; border-radius:16px; border:none; background:linear-gradient(135deg,#0052D9,#7BA88E); color:#fff; font-size:15px; font-weight:600; cursor:pointer; }
.confirm-btn-ok:active { opacity:.85; }
/* Success toast overlay */
.success-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); display:none; align-items:center; justify-content:center; z-index:40; }
.success-box { background:#fff; border-radius:16px; padding:40px 32px; text-align:center; width:300px; }
.success-box-icon { font-size:48px; margin-bottom:12px; }
.success-box-title { font-size:18px; font-weight:700; color:#333; margin-bottom:8px; }
.success-box-desc { font-size:14px; color:#999; margin-bottom:20px; line-height:1.5; }
.success-box-btn { padding:12px 0; background:linear-gradient(135deg,#0052D9,#7BA88E); color:#fff; border:none; border-radius:16px; font-size:15px; font-weight:600; cursor:pointer; width:100%; }
.success-box-btn.outline { background:#fff; color:#0052D9; border:1.5px solid #0052D9; margin-top:8px; }

