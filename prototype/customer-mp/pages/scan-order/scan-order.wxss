.banner{padding:12px 16px;background:#f0fdf4}.tabs{display:flex;padding:10px 16px;white-space:nowrap;background:#fff}.tab{display:inline-block;padding:6px 16px;border-radius:16px;font-size:13px;background:#f5f5f5;color:#666;margin-right:8px}.tab.active{background:#5D8A6B;color:#fff}.list{padding:10px 16px}.item{display:flex;align-items:center;padding:12px;background:#fafafa;border-radius:10px;margin-bottom:8px}.item text{flex:1;font-size:14px}.price{color:#B8860B;font-weight:600}.qty{display:flex;align-items:center;gap:10px}.qty text{width:26px;height:26px;border-radius:50%;border:1px solid #ddd;display:flex;align-items:center;justify-content:center;font-size:16px}.bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #f0f0f0;padding:10px 16px;display:flex;align-items:center;gap:12px}.bar text{flex:1;font-size:20px;font-weight:700;color:#B8860B}.bar button{padding:12px 24px;background:#5D8A6B;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600}