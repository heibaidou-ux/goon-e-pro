page { background:#f5f5f5; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; margin:0; padding:0; }
.page { flex:1; overflow-y:auto; padding-bottom:80px; }

/* Room info */
.room-header { padding:16px 0; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; }
.room-name-text { font-size:20px; font-weight:700; display:block; }
.room-order-id { font-size:12px; opacity:.8; margin-top:4px; display:block; }

/* Summary card */
.summary-card { margin:12px 0; background:#fff; border-radius:16px; padding:16px 0; box-shadow:0 1px 4px rgba(0,0,0,.06); }
.summary-row { display:flex; justify-content:space-between; align-items:center; padding:8px 0; font-size:14px; }
.summary-row .label { color:#666; }
.summary-row .value { font-weight:600; color:#333; }
.summary-row .value.scan { color:#B8860B; }
.summary-divider { height:1px; background:#f0f0f0; margin:4px 0; }
.summary-row.total { border-top:1px solid #e8e8e8; margin-top:4px; padding-top:12px; font-size:16px; }
.summary-row.total .value { color:#B8860B; font-size:20px; }

/* Order list */
.section-title { padding:16px 0 8px; font-size:14px; font-weight:600; color:#666; display:block; }
.order-card { margin:0 0 10px; background:#fff; border-radius:16px; padding:14px 0; box-shadow:0 1px 4px rgba(0,0,0,.04); }
.order-time { font-size:12px; color:#999; display:block; margin-bottom:4px; }
.order-status { font-size:11px; padding:2px 8px; border-radius:16px; background:#f0fdf4; color:#2e7d32; display:inline-block; margin-bottom:8px; }
.order-status.cancelled { background:#fce4e4; color:#e53935; }
.order-items { margin-bottom:8px; }
.order-item { display:flex; justify-content:space-between; font-size:13px; color:#666; padding:2px 0; }
.order-total { font-weight:600; color:#B8860B; font-size:14px; display:block; text-align:right; border-top:1px solid #f5f5f5; padding-top:8px; margin-bottom:4px; }
.order-cancel { font-size:12px; color:#e53935; cursor:pointer; border:none; background:none; padding:4px 0; }

/* Empty state */
.empty-state { text-align:center; padding:60px 20px; }
.empty-icon { font-size:48px; margin-bottom:12px; display:block; }
.empty-text { font-size:14px; color:#ccc; display:block; }

/* Bottom bar */
.bottom-bar { position:fixed; bottom:0; left:0; right:0; background:#fff; border-top:1px solid #f0f0f0; padding:10px 0; display:flex; align-items:center; gap:12px; z-index:20; }
.bar-total { flex:1; font-size:18px; font-weight:700; color:#B8860B; }
.bar-btn { padding:12px 24px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border:none; border-radius:16px; font-size:15px; font-weight:600; cursor:pointer; white-space:nowrap; }
.bar-btn:active { opacity:.85; }
.bar-btn.disabled { opacity:.4; }

/* Loading */
.loading-state { text-align:center; padding:80px 20px; }
.loading-spinner { width:32px; height:32px; border:3px solid #e8e8e8; border-top-color:#5D8A6B; border-radius:50%; animation:spin .8s linear infinite; margin:0 auto 12px; }
@keyframes spin { to { transform:rotate(360deg); } }
.loading-text { color:#999; font-size:14px; }

/* Settle dialog */
.settle-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); display:flex; align-items:flex-end; justify-content:center; z-index:30; }
.settle-overlay.hidden { display:none; }
.settle-sheet { background:#fff; border-radius:16px 16px 0 0; width:100%; max-width:430px; padding:24px 20px 30px; }
.settle-title { font-size:16px; font-weight:600; text-align:center; margin-bottom:16px; display:block; }
.settle-amount { text-align:center; margin-bottom:20px; }
.settle-amount-label { font-size:13px; color:#999; display:block; }
.settle-amount-value { font-size:32px; font-weight:700; color:#B8860B; margin-top:4px; display:block; }
.settle-option { display:flex; justify-content:space-between; align-items:center; padding:14px 0; border-bottom:1px solid #f5f5f5; }
.settle-option-label { font-size:14px; color:#333; }
.settle-select { padding:8px 12px; border:1px solid #ddd; border-radius:8px; font-size:14px; background:#fff; }
.settle-btns { display:flex; gap:10px; margin-top:20px; }
.settle-btn-cancel { flex:1; padding:14px; border-radius:16px; border:1px solid #ddd; background:#fff; font-size:15px; cursor:pointer; }
.settle-btn-ok { flex:2; padding:14px; border-radius:16px; border:none; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; font-size:15px; font-weight:600; cursor:pointer; }
.settle-btn-ok:active { opacity:.85; }
