.header{padding:16px;background:linear-gradient(135deg,#5D8A6B,#7BA88E);color:#fff;font-size:18px;font-weight:700}.summary{margin:12px 16px;background:#fff;border-radius:12px;padding:16px}.summary text{display:flex;justify-content:space-between;padding:6px 0;font-size:14px}.summary .total{border-top:1px solid #e8e8e8;padding-top:10px;margin-top:4px;font-weight:700;color:#B8860B}.orders{padding:0 16px}.order{display:flex;align-items:center;padding:12px;background:#fff;border-radius:10px;margin-bottom:8px}.order text{flex:1}.order button{font-size:12px;color:#e53935;background:none;border:none;padding:4px}.bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #f0f0f0;padding:10px 16px;display:flex;align-items:center;gap:12px;z-index:20}.bar text{flex:1;font-size:20px;font-weight:700;color:#B8860B}.bar button{padding:12px 24px;background:#5D8A6B;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600}