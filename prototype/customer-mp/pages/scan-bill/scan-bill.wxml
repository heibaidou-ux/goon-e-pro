<view class="page">
  <view class="room-header">
    <text class="room-name-text">🏠 {{billData.roomName}}</text>
  </view>
  <view class="summary-card">
    <view class="summary-row"><text class="label">房费</text><text class="value">¥{{billData.roomCharge}}</text></view>
    <view class="summary-row"><text class="label">加购</text><text class="value scan">¥{{billData.scanTotal}}</text></view>
    <view class="summary-divider"></view>
    <view class="summary-row total"><text class="label">待结算</text><text class="value">¥{{billData.pendingPayment}}</text></view>
  </view>

  <text class="section-title">加购明细</text>
  <view class="order-card" wx:for="{{billData.orders}}" wx:key="orderId">
    <view class="order-time">{{item.time}}</view>
    <view class="order-status {{item.statusClass}}">{{item.status}}</view>
    <view class="order-items">
      <view class="order-item" wx:for="{{item.items}}" wx:key="*this">
        <text>{{item.name}} ×{{item.qty}}</text>
        <text>¥{{item.subtotal}}</text>
      </view>
    </view>
    <view class="order-total">¥{{item.totalAmount}}</view>
    <view class="order-cancel" wx:if="{{item.canCancel}}" bindtap="cancelOrder" data-id="{{item.orderId}}">撤销</view>
  </view>
  <view class="bottom-bar">
    <text class="bar-total">¥{{billData.pendingPayment}}</text>
    <button class="bar-btn" bindtap="settleBill">结算</button>
  </view>
</view>
