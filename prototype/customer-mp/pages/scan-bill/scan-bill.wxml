<view class="page"><view class="header"><text>&#x1F3E0; 房间账单</text></view><view class="summary"><text>房费: &#165;{{roomCharge}}</text><text>加购: &#165;{{scanTotal}}</text><text class="total">待结算: &#165;{{pendingPayment}}</text></view><view class="orders"><view class="order" wx:for="{{orders}}" wx:key="orderId"><text>{{item.status}}</text><text>&#165;{{item.totalAmount}}</text><button wx:if="{{item.canCancel}}" bindtap="cancel" data-id="{{item.orderId}}">撤销</button></view></view><view class="bar"><text>&#165;{{pendingPayment}}</text><button bindtap="settle">结算</button></view></view>