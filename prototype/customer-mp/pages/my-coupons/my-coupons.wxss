page { background:#f5f7fa; margin:0; padding:0; }

/* Tab 切换栏 */
.tab-bar { display:flex; background:#fff; border-bottom:1px solid #f0f0f0; }
.tab-item { flex:1; text-align:center; padding:14px 0; font-size:14px; color:#999; position:relative; }
.tab-item.active { color:#5D8A6B; font-weight:600; }
.tab-item.active::after { content:''; position:absolute; left:50%; bottom:0; transform:translateX(-50%); width:60px; height:3px; background:#5D8A6B; border-radius:3px 3px 0 0; }

/* 统计提示 */
.stats-bar { padding:10px 0 6px; }
.stats-text { font-size:12px; color:#999; }

/* 券列表 */
.coupon-list { padding:6px 0 20px; }

/* 券卡片 */
.coupon-card { display:flex; background:#fff; border-radius:16px; margin-bottom:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.06); }
.coupon-card.used { opacity:0.7; }

/* 左侧品牌色区域 */
.coupon-left { width:90px; background:linear-gradient(135deg,#5D8A6B,#8bba94); color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:14px 8px; position:relative; }
.coupon-left::after { content:''; position:absolute; right:-8px; top:50%; transform:translateY(-50%); width:16px; height:16px; background:#f5f7fa; border-radius:50%; }
.coupon-value { font-size:24px; font-weight:800; }
.coupon-type { font-size:11px; opacity:0.85; margin-top:4px; }

/* 右侧详情 */
.coupon-right { flex:1; padding:14px 16px; display:flex; flex-direction:column; justify-content:center; }
.coupon-desc { font-size:14px; font-weight:600; color:#333; display:block; }
.coupon-expiry { font-size:11px; color:#bbb; margin-top:4px; display:block; }
.coupon-footer { display:flex; align-items:center; justify-content:space-between; margin-top:8px; }

/* 平台标签 */
.coupon-platform-tag { font-size:10px; padding:2px 8px; border-radius:4px; }
.coupon-platform-tag.Meituan { background:#FFF3E0; color:#E65100; }
.coupon-platform-tag.Douyin { background:#F3E5F5; color:#7B1FA2; }
.coupon-platform-tag.Dianping { background:#E8F5E9; color:#2E7D32; }
.coupon-platform-tag.Gaode { background:#E3F2FD; color:#1565C0; }
.coupon-platform-tag.System { background:#F5F5F5; color:#666; }

/* 状态标签 */
.coupon-status { font-size:11px; padding:3px 10px; border-radius:10px; font-weight:500; }
.coupon-status.available { background:#E8F5E9; color:#5D8A6B; }
.coupon-status.used { background:#f5f5f5; color:#bbb; }

/* 空状态 */
.empty { text-align:center; padding:60px 20px; }
.empty-icon { font-size:48px; margin-bottom:12px; }
.empty-text { font-size:14px; color:#ccc; display:block; }
.empty-hint { font-size:12px; color:#ddd; margin-top:8px; display:block; }
