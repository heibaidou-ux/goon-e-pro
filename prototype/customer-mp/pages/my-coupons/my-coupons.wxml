<view class="page">
  <view class="header">
    <text class="header-title">🎫 我的优惠券</text>
  </view>
  <view class="coupon-list">
    <view class="coupon-card" wx:for="{{coupons}}" wx:key="code" bindtap="useCoupon" data-code="{{item.code}}" data-value="{{item.value}}" data-desc="{{item.desc}}">
      <view class="coupon-left">
        <text class="coupon-value">¥{{item.value}}</text>
        <text class="coupon-type">{{item.type == 'discount' ? '满减券' : '代金券'}}</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-desc">{{item.desc}}</text>
        <text class="coupon-platform">{{item.platform == 'System' ? '系统发放' : item.platform}}</text>
        <text class="coupon-status {{item.used ? 'used' : 'available'}}">{{item.used ? '已使用' : '可使用'}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{coupons.length == 0}}">暂无优惠券</view>
</view>
