<view class="page">
  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab=='available'?'active':''}}" bindtap="switchTab" data-tab="available">可用券</view>
    <view class="tab-item {{activeTab=='used'?'active':''}}" bindtap="switchTab" data-tab="used">已使用</view>
  </view>

  <!-- 统计提示 -->
  <view class="stats-bar">
    <text class="stats-text" wx:if="{{activeTab=='available'}}">共 {{availableCount}} 张可用优惠券</text>
    <text class="stats-text" wx:if="{{activeTab=='used'}}">已使用 {{usedCount}} 张</text>
  </view>

  <!-- 可用券列表 -->
  <view class="coupon-list" wx:if="{{activeTab=='available'}}">
    <view class="coupon-card" wx:for="{{filteredCoupons}}" wx:key="code" bindtap="useCoupon" data-code="{{item.code}}" data-value="{{item.value}}" data-desc="{{item.desc}}">
      <view class="coupon-left">
        <text class="coupon-value">¥{{item.value}}</text>
        <text class="coupon-type">{{item.type == 'discount' ? '满减券' : '代金券'}}</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-desc">{{item.desc}}</text>
        <text class="coupon-expiry">有效期至 {{item.expiry}}</text>
        <view class="coupon-footer">
          <text class="coupon-platform-tag {{item.platform}}">{{item.platformLabel}}</text>
          <text class="coupon-status available">可使用</text>
        </view>
      </view>
    </view>
    <!-- 空状态 -->
    <view class="empty" wx:if="{{filteredCoupons.length == 0}}">
      <view class="empty-icon">🎫</view>
      <text class="empty-text">暂无可用优惠券</text>
      <text class="empty-hint">首次充值可获赠优惠券包</text>
    </view>
  </view>

  <!-- 已使用券列表 -->
  <view class="coupon-list" wx:if="{{activeTab=='used'}}">
    <view class="coupon-card used" wx:for="{{filteredCoupons}}" wx:key="code">
      <view class="coupon-left">
        <text class="coupon-value">¥{{item.value}}</text>
        <text class="coupon-type">{{item.type == 'discount' ? '满减券' : '代金券'}}</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-desc">{{item.desc}}</text>
        <text class="coupon-expiry">有效期至 {{item.expiry}}</text>
        <view class="coupon-footer">
          <text class="coupon-platform-tag {{item.platform}}">{{item.platformLabel}}</text>
          <text class="coupon-status used">已使用</text>
        </view>
      </view>
    </view>
    <!-- 空状态 -->
    <view class="empty" wx:if="{{filteredCoupons.length == 0}}">
      <view class="empty-icon">🎫</view>
      <text class="empty-text">暂无已使用优惠券</text>
    </view>
  </view>
</view>
