.page { min-height:100vh; background:#f5f5f5; }
.header { display:flex; align-items:center; padding:14px 0; background:#fff; border-bottom:1px solid #f0f0f0; }
.back-btn { font-size:20px; padding:4px 0 4px 4px; margin-right:8px; }
.header-title { font-size:18px; font-weight:700; }
.content { padding:0 0 60px; }
.week-nav { display:flex; align-items:center; justify-content:space-between; padding:14px 0; background:#fff; margin-bottom:12px; }
.week-nav-btn { font-size:14px; padding:6px 12px; color:#5D8A6B; font-weight:600; }
.week-nav-title { font-size:13px; font-weight:600; color:#333; }
.schedule-table { background:#fff; border-radius:12px; overflow:hidden; }
.st-header { display:flex; background:#F2F6F0; border-bottom:1px solid #e0d8d0; }
.st-row { display:flex; border-bottom:1px solid #f5f5f5; }
.st-row:last-child { border-bottom:none; }
.st-cell { padding:10px 4px; text-align:center; font-size:11px; flex-shrink:0; }
.st-name { width:64px; text-align:left; padding-left:10px; }
.st-day { width:38px; }
.st-worker { font-size:12px; font-weight:500; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.st-role { font-size:9px; color:#999; display:block; margin-top:1px; }
.st-shift { display:inline-block; width:22px; height:22px; line-height:22px; border-radius:50%; background:#F2F6F0; font-size:10px; font-weight:600; color:#5D8A6B; }
.st-day.off .st-shift { background:#f0f0f0; color:#ccc; }
.st-day.full .st-shift { background:#5D8A6B; color:#fff; }