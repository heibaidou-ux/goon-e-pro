.header { padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center; }
.header-left { flex:1; }
.header-title { font-size:18px; font-weight:700; display:block; }
.header-store { font-size:12px; color:#666; margin-top:2px; display:block; }
.header-time { font-size:11px; color:#999; }

/* 四宫格 */
.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; padding:16px 0; background:#fff; margin-bottom:12px; }
.stat-card { text-align:center; padding:12px 4px; background:#fff; border-radius:16px; box-shadow:0 2px 8px rgba(0,0,0,0.04); }
.stat-icon { font-size:20px; display:block; margin-bottom:2px; }
.stat-num { display:block; font-size:20px; font-weight:700; color:#5D8A6B; }
.stat-label { font-size:11px; color:#999; margin-top:2px; display:block; }
.stat-card.alert .stat-num { color:#e53935; }

/* 快捷按钮 2×2 */
.section-title { font-size:13px; font-weight:600; color:#333; margin:0 0 8px; display:block; padding:0 16px; }
.quick-actions { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; background:#fff; margin-bottom:16px; }
.action-item { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:20px; background:#F2F6F0; border-radius:16px; }
.action-item:active { opacity:.7; }
.action-icon { font-size:28px; display:block; margin-bottom:6px; }
.action-label { font-size:13px; font-weight:600; color:#333; }

/* 更多功能 4列 */
.feature-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-bottom:16px; background:#fff; padding:0; }
.feature-item { text-align:center; padding:14px 4px; background:#FAF8F5; border-radius:12px; }
.feature-item:active { opacity:.7; }
.feature-icon { font-size:20px; display:block; margin-bottom:4px; }
.feature-label { font-size:11px; color:#666; display:block; }

/* 待办事项 */
.todo-list { padding:0; }
.todo-item { display:flex; align-items:center; padding:14px; background:#fff; border-radius:16px; margin-bottom:8px; box-shadow:0 2px 8px rgba(0,0,0,0.04); }
.todo-item.high { border-left:3px solid #e53935; }
.todo-body { flex:1; }
.todo-title { font-size:14px; font-weight:500; display:block; }
.todo-meta { font-size:11px; color:#999; margin-top:2px; display:block; }
.todo-arrow { color:#ccc; font-size:18px; }
.logout-section { text-align:center; padding:24px 16px; }
.logout-text { display:inline-block; padding:10px 24px; border-radius:10px; font-size:13px; color:#d54941; border:1px solid #d54941; background:#fff; }
.logout-text:active { background:#fff5f5; }
.feature-grid { grid-template-columns:repeat(3,1fr); }