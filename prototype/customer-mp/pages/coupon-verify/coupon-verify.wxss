page { background:#f5f5f5; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; background:#fff; display:flex; flex-direction:column; transform:translateZ(0); }
.nav-bar { display:flex; align-items:center; padding:12px 16px; border-bottom:1px solid #f0f0f0; background:#fff; }
.nav-title { flex:1; text-align:center; font-size:16px; font-weight:600; }
.page { flex:1; overflow-y:auto; padding:16px 16px 60px; }
.steps { display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:20px; }
.step { display:flex; align-items:center; gap:4px; font-size:12px; color:#999; }
.step.active { color:#5D8A6B; font-weight:600; }
.step-num { width:22px; height:22px; border-radius:50%; background:#e5e5e5; color:#fff; display:flex; align-items:center; justify-content:center; font-size:11px; }
.step.active .step-num { background:#5D8A6B; }
.step-line { width:24px; height:1px; background:#e5e5e5; }
.section-title { font-size:15px; font-weight:600; margin-bottom:12px; display:block; }
.coupon-field-row { display:flex; gap:8px; margin-bottom:16px; }
.coupon-field-wrap { position:relative; flex:1; }
.coupon-field { width:100%; height:50px; line-height:50px; padding:0 48px 0 16px; border:2px solid #e5e5e5; border-radius:16px; font-size:16px; text-align:center; box-sizing:border-box; }
.coupon-field:focus { border-color:#5D8A6B; }
.coupon-verify-btn { padding:14px 24px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:15px; font-weight:600; white-space:nowrap; }
.scan-icon { position:absolute; right:12px; top:50%; transform:translateY(-50%); width:28px; height:28px; padding:4px; cursor:pointer; }
.scan-icon:active { opacity:.6; }
.scan-frame { position:relative; width:100%; height:100%; }
.scan-corner { position:absolute; width:8px; height:8px; border-color:#5D8A6B; border-style:solid; }
.scan-corner.tl { top:0; left:0; border-width:2px 0 0 2px; }
.scan-corner.tr { top:0; right:0; border-width:2px 2px 0 0; }
.scan-corner.bl { bottom:0; left:0; border-width:0 0 2px 2px; }
.scan-corner.br { bottom:0; right:0; border-width:0 2px 2px 0; }
.scan-line { position:absolute; top:50%; left:2px; right:2px; height:1px; background:#5D8A6B; transform:translateY(-50%); }
.ticket-card { background:linear-gradient(135deg,#fff3e0,#ffe0b2); border-radius:16px; padding:16px; margin-bottom:12px; border:2px solid transparent; }
.ticket-card.selected { border-color:#B8860B; }
.ticket-source { font-size:12px; font-weight:600; color:#B8860B; display:block; }
.ticket-title { font-size:15px; font-weight:700; margin-top:4px; display:block; }
.ticket-desc { font-size:12px; color:#666; margin-top:2px; display:block; }
.platform-grid { display:flex; gap:10px; margin-bottom:16px; }
.platform-chip { flex:1; padding:12px 6px; border-radius:16px; text-align:center; border:2px solid transparent; display:flex; flex-direction:column; align-items:center; gap:4px; }
.plat-logo { display:block; font-size:22px; line-height:1.3; }
.plat-name { font-size:11px; font-weight:500; display:block; }
.platform-meituan { background:#FFF8E1; color:#B8860B; border-color:#FFD54F; }
.platform-meituan.selected { background:#FFB300; color:#fff; border-color:#FF8F00; box-shadow:0 2px 8px rgba(255,179,0,.3); }
.platform-douyin { background:#F5F5F5; color:#333; border-color:#ddd; }
.platform-douyin.selected { background:#1A1A1A; color:#fff; border-color:#1A1A1A; box-shadow:0 2px 8px rgba(0,0,0,.2); }
.platform-dianping { background:#FFEBEE; color:#C62828; border-color:#EF9A9A; }
.platform-dianping.selected { background:#E53935; color:#fff; border-color:#C62828; box-shadow:0 2px 8px rgba(229,57,53,.3); }
.platform-gaode { background:#E3F2FD; color:#0D47A1; border-color:#90CAF9; }
.platform-gaode.selected { background:#1E88E5; color:#fff; border-color:#0D47A1; box-shadow:0 2px 8px rgba(30,136,229,.3); }
.match-result { text-align:center; padding:16px; background:#f0fdf4; border-radius:16px; margin-bottom:16px; }
.match-icon { font-size:32px; display:block; margin-bottom:8px; }
.match-title { font-size:16px; font-weight:600; color:#333; display:block; }
.match-sub { font-size:13px; color:#666; margin-top:4px; display:block; }
.time-grid { display:flex; flex-wrap:wrap; gap:4px; }
.time-cell { padding:8px 4px; border-radius:6px; text-align:center; border:1px solid #eee; background:#fff; font-size:11px; width:calc(25% - 3px); }
.time-cell.selected { background:#5D8A6B; color:#fff; border-color:#5D8A6B; }
.book-btn { width:100%; padding:16px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:16px; font-weight:600; margin-top:16px; }
.book-btn:disabled { background:#ccc; }

/* 6.1 按booking-confirm风格复刻时段选择 */
.time-select-section { padding:16px 0; }
.now-btn { display:block; margin:0 auto 16px; padding:10px 24px; border-radius:16px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border:none; font-size:14px; font-weight:600; }
.confirm-card { margin:12px 0; background:#fff; border-radius:12px; padding:16px; }
.confirm-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f5f5f5; }
.confirm-row .label { color:#999; font-size:14px; }
.confirm-row .price { color:#B8860B; font-weight:600; font-size:14px; }
.confirm-row .price.past { color:#ddd; }

/* 底部确认条 */
.booking-confirm-info { margin:12px 0; text-align:left; }
.bci-row { display:flex; justify-content:space-between; padding:8px 0; font-size:13px; border-bottom:1px solid #f0f0f0; }
.bci-label { color:#999; }
.bci-value { font-weight:600; color:#333; text-align:right; max-width:60%; }

/* 确认弹窗 */
.confirm-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.confirm-modal { background:#fff;border-radius:16px;padding:24px;width:320px;max-width:90vw;text-align:center; }
.confirm-h3 { font-size:16px;font-weight:700;display:block;margin-bottom:8px; }
.confirm-preview { font-size:14px;color:#666;margin:8px 0; }
.confirm-modal-buttons { display:flex;gap:10px;margin-top:16px; }
.confirm-modal-btn { flex:1;padding:12px;border-radius:16px;font-size:14px;font-weight:600;text-align:center;border:none; }
.confirm-modal-btn.cancel { background:#f5f5f5;color:#666; }
.confirm-modal-btn.confirm { background:#5D8A6B;color:#fff; }
