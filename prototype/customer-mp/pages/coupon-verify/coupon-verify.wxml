<view class="page"><view class="verify-card"><text class="verify-title">验券</text><input class="verify-input" placeholder="输入券码" value="{{code}}" bindinput="onCode" /><button class="verify-btn" bindtap="doVerify" disabled="{{!code}}">核 销</button><view class="verify-result" wx:if="{{result}}"><text wx:if="{{result.success}}" style="color:#00A870">✅ {{result.desc}} — ¥{{result.value}}</text><text wx:else style="color:#e53935">❌ {{result.error}}</text></view><text class="verify-hint">支持平台券（美团/抖音）和系统券核销</text></view></view>