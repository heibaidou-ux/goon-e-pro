.hero { padding:40px 20px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; font-size:24px; font-weight:700; text-align:center; }
.info-card { margin:12px 16px; background:#fff; border-radius:12px; padding:16px; }
.info-row { display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #f5f5f5; font-size:14px; }
.info-row:last-child { border-bottom:none; }
.info-label { color:#999; }
.price { color:#B8860B; font-weight:600; }
.tags { display:flex; gap:4px; flex-wrap:wrap; }
.tag { font-size:11px; background:#f0f0f0; padding:2px 8px; border-radius:4px; color:#666; }
.section-title { font-size:15px; font-weight:600; padding:16px 16px 8px; display:block; }
.booking-card { margin:0 16px; background:#fff; border-radius:12px; padding:16px; }
.picker-row { display:flex; justify-content:space-between; align-items:center; padding:8px 0; font-size:14px; }
.picker-label { color:#999; }
.time-row { display:flex; align-items:center; gap:12px; }
.time-sep { color:#ccc; }
.total-row { display:flex; justify-content:space-between; align-items:center; padding:12px 0 0; border-top:1px solid #f0f0f0; margin-top:8px; font-size:15px; }
.bottom-bar { position:fixed; bottom:0; left:0; right:0; padding:12px 16px; background:#fff; border-top:1px solid #f0f0f0; }
.book-btn { width:100%; padding:14px; background:linear-gradient(135deg,#5D8A6B,#7BA88E); color:#fff; border:none; border-radius:10px; font-size:16px; font-weight:600; text-align:center; }