page { background:#f5f5f5; margin:0; padding:0; }
.phone { width:100%; min-height:100vh; background:#fff; display:flex; flex-direction:column; }
.nav-bar { display:flex; align-items:center; padding:12px 16px; border-bottom:1px solid #e8e4de; background:#fff; }
.back-btn { font-size:20px; padding:4px; margin-right:8px; }
.nav-title { flex:1; text-align:center; font-size:16px; font-weight:600; margin-right:28px; }
.page { flex:1; overflow-y:auto; padding-bottom:60px; }

/* Room header */
.room-header-card { padding:16px; color:#fff; }
.gradient-tea { background:linear-gradient(135deg,#5D8A6B,#7BA88E); }
.gradient-meeting { background:linear-gradient(135deg,#7A8B8B,#A3B5B5); }
.gradient-exhibition { background:linear-gradient(135deg,#B8860B,#D4A84B); }
.gradient-workshop { background:linear-gradient(135deg,#8B7D6B,#B5A896); }
.room-header-top { display:flex; align-items:center; gap:12px; }
.room-header-icon { width:48px; height:48px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:28px; background:rgba(255,255,255,.2); flex-shrink:0; }
.room-header-name { font-size:17px; font-weight:700; display:block; }
.room-header-meta { font-size:12px; opacity:.85; margin-top:2px; display:block; }
.room-header-tags { display:flex; flex-wrap:wrap; gap:4px; margin-top:8px; }
.facility-tag { background:rgba(255,255,255,.2); color:#fff; padding:2px 10px; border-radius:16px; font-size:11px; }

/* No booking */
.no-booking { text-align:center; padding:40px 20px; color:#999; }
.nb-icon { font-size:48px; display:block; margin-bottom:12px; }
.nb-title { font-size:16px; font-weight:600; color:#333; display:block; }
.nb-desc { font-size:13px; margin-top:8px; display:block; line-height:1.6; }
.nb-btn { margin-top:16px; padding:10px 24px; border-radius:8px; background:#5D8A6B; color:#fff; border:none; font-size:14px; }

/* Date bar — 填满整个页面宽度 */
.date-bar { display:flex; padding:10px 12px; gap:4px; width:100%; box-sizing:border-box; }
.date-chip { flex:1; padding:8px 2px; border-radius:16px; text-align:center; border:1.5px solid #e0d8d0; background:#fff; font-size:11px; }
.date-chip .d-week { font-size:10px; color:#999; display:block; }
.date-chip .d-day { font-size:16px; font-weight:600; margin:1px 0; display:block; }
.date-chip .d-month { font-size:10px; color:#999; display:block; }
.date-chip.today { border-color:#5D8A6B; }
.date-chip.selected { background:#5D8A6B; color:#fff; border-color:#5D8A6B; }
.date-chip.selected .d-week, .date-chip.selected .d-month { color:rgba(255,255,255,.7); }
.date-more { flex-shrink:0; padding:10px 8px; border-radius:16px; border:1.5px solid #e0d8d0; background:#fff; font-size:12px; color:#666; text-align:center; min-width:42px; display:inline-block; }

/* Duration */
.section-label { font-size:12px; font-weight:600; color:#333; margin-bottom:8px; display:block; }
.duration-section { padding:12px 12px 4px; }
.duration-grid { display:flex; gap:6px; flex-wrap:wrap; }
.duration-chip { flex:1; min-width:60px; padding:10px 4px; border-radius:16px; text-align:center; border:1.5px solid #e0d8d0; background:#fff; font-size:12px; font-weight:600; }
.duration-chip.selected { border-color:#5D8A6B; background:#F2F6F0; color:#5D8A6B; }
.custom-hours-row { padding:6px 12px; display:flex; align-items:center; gap:8px; }
.ch-label { font-size:12px; color:#666; }
.custom-hours-input { width:72px; padding:8px 10px; border:1.5px solid #5D8A6B; border-radius:8px; font-size:15px; font-weight:600; color:#5D8A6B; text-align:center; background:#F2F6F0; }

/* Time row */
.form-row { padding:6px 12px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.form-label { font-size:12px; font-weight:600; color:#333; min-width:48px; }
.now-btn { padding:8px 16px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:12px; font-weight:600; white-space:nowrap; }
.time-or { font-size:11px; color:#ccc; }
.time-select-trigger { flex:1; padding:8px 10px; border-radius:8px; border:1.5px solid #e0d8d0; background:#fff; font-size:13px; display:flex; align-items:center; justify-content:space-between; min-width:120px; }
.time-value { color:#333; }
.time-placeholder { color:#ccc; }
.arrow { color:#999; font-size:10px; }
.info-bar { padding:2px 12px 6px; display:flex; gap:16px; font-size:10px; color:#999; }

/* Conflict */
.conflict-alert { margin:4px 12px; padding:10px 14px; border-radius:8px; background:#FDF6EC; border:1px solid #F0E0C0; font-size:12px; color:#8B7D6B; }
.suggest-time { color:#5D8A6B; font-weight:600; }

/* Bottom */
.inpage-bottom { padding:16px 12px; border-top:1px solid #e8e4de; margin-top:8px; }
.inpage-total { display:flex; align-items:center; gap:8px; margin-bottom:12px; }
.total-label { font-size:13px; color:#999; }
.total-price { font-size:20px; font-weight:700; color:#B8860B; }
.total-detail { font-size:12px; color:#999; flex:1; text-align:right; }
.total-detail.active { font-size:17px; font-weight:700; color:#B8860B; }
.inpage-book-btn { width:100%; padding:14px; border-radius:16px; background:#5D8A6B; color:#fff; border:none; font-size:16px; font-weight:600; text-align:center; }
.inpage-book-btn.disabled { background:#d0d0d0; }

/* Bottom nav */
.bottom-nav { display:flex; border-top:1px solid #e8e4de; background:#fff; flex-shrink:0; }
.nav-item { flex:1; text-align:center; padding:10px 0 6px; color:#999; }
.nav-item .nav-icon { font-size:20px; display:block; }
.nav-item .nav-label { font-size:10px; margin-top:2px; display:block; }
.nav-item.active { color:#5D8A6B; }

/* Calendar modal */
.cal-modal-overlay { position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:99;display:flex;align-items:center;justify-content:center; }
.cal-modal-content { background:#fff;border-radius:16px;padding:16px;width:320px; }
.cal-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:10px; }
.cal-month { font-size:15px;font-weight:600; }
.cal-nav { width:30px;height:30px;border-radius:50%;border:1.5px solid #e0d8d0;display:flex;align-items:center;justify-content:center;font-size:16px; }
.cal-weekdays { display:grid;grid-template-columns:repeat(7,1fr);text-align:center;font-size:11px;color:#999;margin-bottom:4px; }
.cal-grid { display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center; }
.cal-day { padding:8px 0;font-size:13px;border-radius:8px; }
.cal-day.today { font-weight:700;color:#5D8A6B; }
.cal-day.selected { background:#5D8A6B;color:#fff;font-weight:600; }
.cal-day.past { color:#ddd; }
.cal-day.empty { visibility:hidden; }
.cal-close { margin-top:10px;padding:10px;border-radius:8px;border:none;background:#5D8A6B;color:#fff;font-size:14px;width:100%;text-align:center; }


