<view class="page">
  <view class="hero">{{room.type === 'TeaRoom' ? '🍵' : room.type === 'MeetingRoom' ? '💼' : '🏠'}} {{room.name}}</view>

  <view class="info-card">
    <view class="info-row">
      <text class="info-label">类型</text>
      <text>{{room.type === 'TeaRoom' ? '茶室' : room.type === 'MeetingRoom' ? '会议室' : room.type === 'Exhibition' ? '展厅' : '工作间'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">容纳人数</text>
      <text>{{room.capacity}}人</text>
    </view>
    <view class="info-row">
      <text class="info-label">面积</text>
      <text>{{room.area}}㎡</text>
    </view>
    <view class="info-row">
      <text class="info-label">价格</text>
      <text class="price">¥{{room.pricePerHour}}/时</text>
    </view>
    <view class="info-row">
      <text class="info-label">设施</text>
      <view class="tags">
        <text class="tag" wx:for="{{room.facilities}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section-title">选择日期与时段</view>

  <view class="booking-card">
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="picker-row">
        <text class="picker-label">日期</text>
        <text>{{selectedDate}}</text>
      </view>
    </picker>
    <view class="time-row">
      <picker mode="time" value="{{startTime}}" bindchange="onStartChange">
        <view class="picker-row">
          <text class="picker-label">开始</text>
          <text>{{startTime}}</text>
        </view>
      </picker>
      <text class="time-sep">至</text>
      <picker mode="time" value="{{endTime}}" bindchange="onEndChange">
        <view class="picker-row">
          <text class="picker-label">结束</text>
          <text>{{endTime}}</text>
        </view>
      </picker>
    </view>
    <view class="total-row">
      <text>预计费用</text>
      <text class="price">¥{{estimatedTotal}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="book-btn" bindtap="goBooking">立即预约</button>
  </view>
</view>
