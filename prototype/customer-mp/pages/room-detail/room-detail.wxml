<view class="phone">
  <view class="nav-bar">
    <text class="nav-title">{{room.name}}</text>
  </view>
  <view class="page">

    <!-- 不可预约空间 -->
    <view wx:if="{{!room.bookable}}">
      <view class="room-header-card {{gradClass}}">
        <view class="room-header-top">
          <view class="room-header-icon">{{heroIcon}}</view>
          <view>
            <text class="room-header-name">{{room.name}}</text>
            <text class="room-header-meta">容纳 {{room.capacity}}人 · {{room.area}}㎡ · 非预约空间</text>
          </view>
        </view>
        <view class="room-header-tags"><text class="facility-tag" wx:for="{{room.facilities}}" wx:key="*this">{{item}}</text></view>
      </view>
      <view class="no-booking">
        <text class="nb-icon">{{roomId=='RM005'?'🏛️':'🔧'}}</text>
        <text class="nb-title">{{roomId=='RM005'?'自由参观，无需预约':'员工专用空间'}}</text>
        <text class="nb-desc">{{roomId=='RM005'?'展厅为开放区域，自由使用。如需使用包间，请选择茶室或会议室预约。':'工作间为员工储物和设备机柜空间，不对外开放。'}}</text>
        <button class="nb-btn" bindtap="goHome">查看可预约包间</button>
      </view>
    </view>

    <!-- 可预约空间 -->
    <view wx:else>

      <!-- 实景图区 -->
      <view class="room-gallery">
        <swiper class="gallery-swiper" indicator-dots autoplay interval="4000" circular>
          <swiper-item wx:for="{{roomImages}}" wx:key="*this">
            <image class="gallery-img" src="{{item}}" mode="aspectFill" />
          </swiper-item>
          <swiper-item wx:if="{{roomImages.length==0}}">
            <view class="gallery-placeholder {{gradClass}}">
              <text class="gallery-placeholder-icon">{{heroIcon}}</text>
              <text class="gallery-placeholder-text">{{room.name}}</text>
            </view>
          </swiper-item>
        </swiper>
        <view class="gallery-badge">{{room.capacity}}人 · {{room.area}}㎡</view>
      </view>

      <!-- 房间信息 -->
      <view class="room-info-section">
        <view class="room-info-main">
          <text class="room-info-name">{{room.name}}</text>
          <text class="room-info-price">¥{{hourRate}}<text class="unit">/小时</text></text>
        </view>
        <view class="room-facility-tags"><text class="facility-tag" wx:for="{{room.facilities}}" wx:key="*this">{{item}}</text></view>
      </view>

      <!-- 日期：一行横向排列，5天+更多按钮 -->
      <view class="date-bar">
        <view class="date-chip {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}" wx:for="{{dateChips}}" wx:key="index" bindtap="pickDate" data-index="{{index}}">
          <text class="d-week">{{item.week}}</text>
          <text class="d-day">{{item.day}}</text>
          <text class="d-month">{{item.month}}月</text>
        </view>
        <view class="date-more" bindtap="showCalModal">更多<text style="display:block;font-size:8px;">▾</text></view>
      </view>

      <view class="duration-section">
        <text class="section-label">选择时长</text>
        <view class="duration-grid">
          <view class="duration-chip {{!isCustomMode && selectedDuration==120 ? 'selected' : ''}}" bindtap="pickDuration" data-dur="120">2小时</view>
          <view class="duration-chip {{!isCustomMode && selectedDuration==180 ? 'selected' : ''}}" bindtap="pickDuration" data-dur="180">3小时</view>
          <view class="duration-chip {{!isCustomMode && selectedDuration==240 ? 'selected' : ''}}" bindtap="pickDuration" data-dur="240">4小时</view>
          <view class="duration-chip {{!isCustomMode && selectedDuration==360 ? 'selected' : ''}}" bindtap="pickDuration" data-dur="360">6小时</view>
          <view class="duration-chip {{isCustomMode ? 'selected custom-input-chip' : ''}}" wx:if="{{!isCustomMode}}" bindtap="pickCustomDuration">自定义</view>
          <view class="duration-chip selected custom-input-chip" wx:else>
            <input class="custom-inline-input" type="text" value="{{customHours}}" bindinput="onCustomHoursInput" placeholder="" />
            <text class="ch-inline-unit">小时</text>
          </view>
        </view>
      </view>

      <view class="form-row" wx:if="{{showTimeRow}}">
        <text class="form-label">开始时间</text>
        <button class="now-btn" bindtap="pickNow">⚡ 现在开始</button>
        <text class="time-or">或</text>
        <picker mode="selector" range="{{timeOptions}}" bindchange="pickTimeFromSelect">
          <view class="time-select-trigger">
            <text wx:if="{{selectedTimeLabel}}" class="time-value">{{selectedTimeLabel}}</text>
            <text wx:else class="time-placeholder">选择时间...</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="info-bar"><text>🧹 保洁准备(15min)</text><text>📅 约满时段不显示</text></view>

      <view class="conflict-alert" wx:if="{{conflictMsg}}">
        <text wx:if="{{suggestTime}}">⚠️ 该时段已被预约。</text>
        <text class="suggest-time" wx:if="{{suggestTime}}" bindtap="applySuggested">建议从 {{suggestTime}} 开始 ›</text>
        <text wx:else>⚠️ 该时段已被预约，请选择其他日期。</text>
      </view>

      <!-- 门店位置 -->
      <view class="location-section">
        <text class="section-label">📍 门店位置</text>
        <view class="location-card" bindtap="openNavigation">
          <view class="location-info">
            <text class="location-address">{{storeInfo.address}}</text>
            <text class="location-hours">营业时间 {{storeInfo.hours}}</text>
          </view>
          <button class="location-nav-btn">🗺 导航</button>
        </view>
      </view>

      <view class="inpage-bottom">
        <view class="inpage-total">
          <text class="total-label">小计</text>
          <text class="total-price">¥{{totalPrice}}</text>
          <text class="total-detail {{canBook ? 'active' : ''}}">{{totalDetail}}</text>
        </view>
        <button class="inpage-book-btn {{canBook ? '' : 'disabled'}}" disabled="{{!canBook}}" bindtap="goPay">立即预约</button>
      </view>
    </view>
  </view>

  <bottom-nav active="booking"></bottom-nav>
</view>

<view class="cal-modal-overlay" wx:if="{{showCalModal}}" bindtap="hideCalModal">
  <view class="cal-modal-content" catchtap>
    <view class="cal-header">
      <view class="cal-nav" bindtap="calChangeMonth" data-dir="-1">◀</view>
      <text class="cal-month">{{calYear}}年 {{calMonth+1}}月</text>
      <view class="cal-nav" bindtap="calChangeMonth" data-dir="1">▶</view>
    </view>
    <view class="cal-weekdays"><text wx:for="{{weekNames}}" wx:key="*this">{{item}}</text></view>
    <view class="cal-grid">
      <view class="cal-day {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isPast || item.isOther ? 'past' : ''}} {{item.isEmpty ? 'empty' : ''}}" wx:for="{{calDays}}" wx:key="index" bindtap="calPick" data-day="{{item.day}}" data-month="{{item.month}}" data-year="{{item.year}}" data-past="{{item.isPast}}">
        <text wx:if="{{!item.isEmpty}}">{{item.day}}</text>
      </view>
    </view>
    <button class="cal-close" bindtap="hideCalModal">关闭</button>
  </view>
</view>
