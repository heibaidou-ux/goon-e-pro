.page { min-height:100vh; background:#f5f5f5; }
.header { display:flex; align-items:center; padding:14px 16px; background:#fff; border-bottom:1px solid #f0f0f0; }
.header-title { font-size:18px; font-weight:700; }
.content { padding:0 16px 60px; }
.checkin-card { background:#fff; border-radius:16px; padding:20px; margin:12px 0; box-shadow:0 2px 8px rgba(0,0,0,.04); }
.checkin-top { display:flex; align-items:center; gap:12px; margin-bottom:16px; }
.checkin-status-icon { font-size:36px; }
.checkin-status-text { font-size:16px; font-weight:700; display:block; }
.checkin-time { font-size:12px; color:#999; display:block; margin-top:2px; }
.checkin-btns { display:flex; gap:10px; }
.ci-btn { flex:1; padding:12px; border-radius:12px; border:none; font-size:14px; font-weight:600; text-align:center; }
.ci-btn.checkin { background:#5D8A6B; color:#fff; }
.ci-btn.checkout { background:#B8860B; color:#fff; }
.ci-done { flex:1; text-align:center; padding:12px; font-size:13px; color:#999; }
.stats-row { display:flex; gap:8px; margin:12px 0; }
.s-item { flex:1; background:#fff; border-radius:12px; padding:14px 4px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,.04); }
.s-num { display:block; font-size:20px; font-weight:700; color:#5D8A6B; }
.s-label { font-size:11px; color:#999; margin-top:2px; display:block; }
.section-title { font-size:13px; font-weight:600; color:#333; margin:16px 0 8px; display:block; }
.record-list { background:#fff; border-radius:12px; overflow:hidden; }
.record-item { display:flex; align-items:center; padding:12px 14px; border-bottom:1px solid #f5f5f5; font-size:12px; gap:8px; }
.record-item:last-child { border-bottom:none; }
.rec-date { width:90px; color:#333; flex-shrink:0; }
.rec-in { width:50px; text-align:center; color:#666; }
.rec-out { width:50px; text-align:center; color:#666; }
.rec-status { flex:1; text-align:right; font-weight:600; }
.rec-status.normal { color:#5D8A6B; }
.rec-status.active { color:#B8860B; }