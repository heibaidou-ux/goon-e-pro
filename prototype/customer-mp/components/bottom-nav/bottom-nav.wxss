.bottom-nav {
  display: flex;
  border-top: 1px solid #eee;
  background: #fff;
  flex-shrink: 0;
  z-index: 50;
  width: 100%;
  box-sizing: border-box;
}
.nav-item {
  flex: 1;
  text-align: center;
  padding: 10px 0 6px;
  color: #999;
}
.nav-item.active {
  color: #5D8A6B;
}
.nav-icon {
  font-size: 20px;
  display: block;
}
.nav-label {
  font-size: 10px;
  margin-top: 2px;
  display: block;
}
