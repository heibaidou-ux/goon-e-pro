        <mxCell id="2" value="&lt;b&gt;盈隆店智能音频与485总线系统接线拓扑图（总览）&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=4;" parent="1" vertex="1">
