        <mxCell id="1003" value="&lt;b&gt;2×1.5mm² 音箱线&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;无氧铜(OFC)阻燃双色护套线&lt;/font&gt;" style="rounded=1;strokeColor=#1e8449;fillColor=#e8f8f5;fontSize=9;html=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="80" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="1005" value="&lt;b&gt;房间吊顶电箱（HT-8位/12位）&lt;/b&gt;" style="rounded=1;strokeColor=#1a5276;fillColor=#eaf2f8;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=4;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="20" y="150" width="1160" height="250" as="geometry" />
        </mxCell>
        <mxCell id="1006" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;聚英8路联动版继电器模块&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;┌─────────────────────────────┐&lt;br&gt;│ [V+]  [V-]  [485A] [485B]  │ ← 网线接入&lt;br&gt;│ [DI1] [DI2] [GND]          │ ← 墙面物理开关&lt;br&gt;│                             │&lt;br&gt;│ COM1→NO1  COM2→NO2  ...    │ ← 强电输出&lt;br&gt;│ COM端子之间2.5mm²硬线跳线    │&lt;br&gt;└─────────────────────────────┘&lt;/font&gt;" style="rounded=1;strokeColor=#d35400;fillColor=#fef9e7;fontSize=10;html=1;fontColor=#333;" parent="1" vertex="1">
          <mxGeometry x="40" y="185" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="1007" value="&lt;b&gt;接线端子排&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;┌─────────────────────┐&lt;br&gt;│ 零线排 (N Bus)      │ ← 各负载零线汇流&lt;br&gt;├─────────────────────┤&lt;br&gt;│ 地线排 (PE Bus)     │ ← 各负载地线汇流&lt;br&gt;└─────────────────────┘&lt;/font&gt;" style="rounded=1;strokeColor=#2c3e50;fillColor=#fbfcfc;fontSize=10;html=1;fontColor=#333;" parent="1" vertex="1">
          <mxGeometry x="420" y="185" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="1008" value="&lt;b&gt;🔘 485智能场景面板（三键六开）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Modbus RTU从设备  |  Slave ID 11-16&lt;br&gt;24V+485总线  |  预埋φ20弱电管至吊顶电箱&lt;/font&gt;" style="rounded=1;strokeColor=#7f8c8d;fillColor=#f4f6f6;fontSize=10;html=1;" parent="1" vertex="1">
          <mxGeometry x="660" y="185" width="200" height="70" as="geometry" />
