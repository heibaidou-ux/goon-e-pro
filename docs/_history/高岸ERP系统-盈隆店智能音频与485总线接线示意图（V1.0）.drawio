        <mxCell id="7" value="&lt;b&gt;🎵 6分区DSP防啸叫功放（2U）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;MIC1 ← 话筒MIX OUT | DSP立体声L→ZONE1 R→ZONE2&lt;br&gt;ZONE1~6 → 各分区音箱（100V定压）&lt;/font&gt;" style="rounded=1;strokeColor=#1e8449;fillColor=#d5f5e3;fontSize=11;html=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="100" width="200" height="70" as="geometry" />
