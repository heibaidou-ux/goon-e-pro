        </mxCell>
        <mxCell id="4" value="&lt;b&gt;🔌 明纬24V开关电源（底部）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;输入: AC 220V → 输出: DC 24V/10A&lt;br&gt;为全店485设备低压供电&lt;/font&gt;" style="rounded=1;strokeColor=#d35400;fillColor=#fdebd0;fontSize=11;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="100" width="170" height="70" as="geometry" />
