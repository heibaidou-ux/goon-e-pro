        <mxCell id="5" value="&lt;b&gt;🔗 隔离USB转485&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;HA控制主机 → 485总线&lt;br&gt;带隔离保护防串扰&lt;/font&gt;" style="rounded=1;strokeColor=#2c3e50;fillColor=#d4e6f1;fontSize=11;html=1;" parent="1" vertex="1">
          <mxGeometry x="240" y="100" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;📡 8路隔离集线器（1U）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;MAIN IN ← USB转485&lt;br&gt;CH1~CH6 → 各房间（星型）&lt;/font&gt;" style="rounded=1;strokeColor=#1a5276;fillColor=#d5d8dc;fontSize=11;html=1;" parent="1" vertex="1">
          <mxGeometry x="440" y="100" width="200" height="70" as="geometry" />
