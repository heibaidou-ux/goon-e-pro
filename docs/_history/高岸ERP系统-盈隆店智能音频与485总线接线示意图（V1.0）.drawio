          <mxGeometry x="600" y="455" width="175" height="55" as="geometry" />
        </mxCell>
        <mxCell id="1015" value="&lt;b&gt;CH5 · 辅助插座&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;吧台/香薰&lt;br&gt;线径: 1.5mm²&lt;/font&gt;" style="rounded=1;strokeColor=#2ecc71;fillColor=#fdedec;fontSize=10;html=1;" parent="1" vertex="1">
