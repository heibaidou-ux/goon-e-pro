        <mxCell id="1002" value="&lt;b&gt;屏蔽网线（SFTP）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;橙/橙白=V+  绿/绿白=V-  蓝=485A  蓝白=485B&lt;/font&gt;" style="rounded=1;strokeColor=#1a5276;fillColor=#fbfcfc;fontSize=9;html=1;" parent="1" vertex="1">
