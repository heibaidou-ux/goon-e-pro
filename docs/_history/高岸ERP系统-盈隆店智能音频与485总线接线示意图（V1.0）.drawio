        <mxCell id="1001" value="&lt;b&gt;来自总弱电柜&lt;/b&gt;" style="rounded=1;strokeColor=#566573;fillColor=#f5f5f5;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=4;spacingLeft=8;" parent="1" vertex="1">
