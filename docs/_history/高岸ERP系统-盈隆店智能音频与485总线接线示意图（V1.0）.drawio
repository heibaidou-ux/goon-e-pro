        <mxCell id="1011" value="&lt;b&gt;CH1 · 照明&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;灯具火线&lt;br&gt;线径: 1.5mm²&lt;/font&gt;" style="rounded=1;strokeColor=#f39c12;fillColor=#fdedec;fontSize=10;html=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="455" width="175" height="55" as="geometry" />
        </mxCell>
        <mxCell id="1012" value="&lt;b&gt;CH2 · 空调面板&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;220V供电&lt;br&gt;线径: 1.5mm²&lt;/font&gt;" style="rounded=1;strokeColor=#e74c3c;fillColor=#fdedec;fontSize=10;html=1;" parent="1" vertex="1">
          <mxGeometry x="220" y="455" width="175" height="55" as="geometry" />
        </mxCell>
        <mxCell id="1013" value="&lt;b&gt;CH3 · 电动窗帘&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;电机电源&lt;br&gt;线径: 1.5mm²&lt;/font&gt;" style="rounded=1;strokeColor=#9b59b6;fillColor=#fdedec;fontSize=10;html=1;" parent="1" vertex="1">
