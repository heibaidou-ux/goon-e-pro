          <mxGeometry x="290" y="85" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="105" parent="1" style="rounded=1;strokeColor=#2c3e50;fillColor=#d4e6f1;fontSize=10;html=1;" vertex="1" value="&lt;b&gt;🎤 无线话筒接收机（1U）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;一拖八 · 8天线 · 紧凑型&lt;br&gt;MIX OUT → 会议室T-6715&lt;/font&gt;">
          <mxGeometry x="540" y="85" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="106" parent="1" style="rounded=1;strokeColor=#d35400;fillColor=#fdebd0;fontSize=10;html=1;" vertex="1" value="&lt;b&gt;🔌 侧挂：485串口服务器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;RJ45 → RS485&lt;br&gt;Modbus RTU over TCP&lt;/font&gt;">
          <mxGeometry x="790" y="85" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="107" parent="1" style="rounded=1;strokeColor=#1a5276;fillColor=#d5d8dc;fontSize=10;html=1;" vertex="1" value="&lt;b&gt;📡 侧挂：8路隔离集线器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;星型拓扑 | CH1-CH6&lt;br&gt;信号再生 | 端口内置120Ω&lt;/font&gt;">
          <mxGeometry x="1030" y="85" width="200" height="55" as="geometry" />
        </mxCell>
