        <mxCell id="103" parent="1" style="rounded=1;strokeColor=#1a5276;fillColor=#d4e6f1;fontSize=10;html=1;" vertex="1" value="&lt;b&gt;🔗 24口千兆网管交换机（1U）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;VLAN 10: 智能内网&lt;br&gt;VLAN 20: 客人外网&lt;/font&gt;">
