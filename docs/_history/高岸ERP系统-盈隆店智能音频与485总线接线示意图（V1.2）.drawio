        <mxCell id="111" parent="1" style="text;strokeColor=none;fillColor=none;align=left;fontSize=9;html=1;" vertex="1" value="&lt;i&gt;▼ 交换机VLAN：端口1-8 = VLAN 10（智能内网：T-6715×5 + NAS×1 + 串口服务器×1） | 端口9-20 = VLAN 20（客人外网：AP×5 + 有线网口×5 + 上联）&lt;/i&gt;">
          <mxGeometry x="40" y="150" width="1500" height="22" as="geometry" />
        </mxCell>
        <mxCell id="112" parent="1" style="text;strokeColor=#566573;fillColor=#f8f9fa;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;rounded=1;html=1;" vertex="1" value="&lt;b&gt;📐 机柜排布（上→下）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;① 24口网管交换机（1U）&lt;br&gt;② 通风盲板（1U）&lt;br&gt;③ HA主机（2U）&lt;br&gt;④ 无线话筒接收机（1U）&lt;br&gt;⑤ 空U/理线（5U余量）&lt;br&gt;&lt;br&gt;&lt;i&gt;侧挂：&lt;/i&gt;&lt;br&gt;485串口服务器 | 485集线器&lt;br&gt;24V电源&lt;/font&gt;">
          <mxGeometry x="40" y="180" width="180" height="115" as="geometry" />
